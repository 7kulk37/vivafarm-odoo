<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Scrap Order (spoilage record, GAP 5.x / business) -->
    <template id="report_scrap"
              name="Scrap Order (ใบสั่งทำลาย)">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <t t-set="layout_document_title">ใบสั่งทำลาย / Scrap Order</t>
                    <div class="page">
                        <div class="oe_structure"/>
                        <div class="row mb-3">
                            <div class="col-6">
                                <strong>Scrap Order (ใบสั่งทำลาย)</strong>
                            </div>
                            <div class="col-6 text-end text-muted">
                                <span t-esc="o.name"/>
                            </div>
                        </div>

                        <table class="table table-sm table-bordered mb-3">
                            <tbody>
                                <tr>
                                    <td class="text-muted" style="width: 25%;">
                                        <t t-if="lang == 'th_TH'">ผลิตภัณฑ์</t>
                                        <t t-else="">Product</t>
                                    </td>
                                    <td t-esc="o.product_id.name or ''"/>
                                    <td class="text-muted" style="width: 15%;">
                                        <t t-if="lang == 'th_TH'">สถานะ</t>
                                        <t t-else="">Status</t>
                                    </td>
                                    <td t-esc="o.state"/>
                                </tr>
                                <tr>
                                    <td class="text-muted">
                                        <t t-if="lang == 'th_TH'">จำนวน</t>
                                        <t t-else="">Quantity</t>
                                    </td>
                                    <td>
                                        <span t-esc="o.scrap_qty"/>
                                        <span class="text-muted" t-esc="o.product_uom_id.name or ''"/>
                                    </td>
                                    <td class="text-muted">
                                        <t t-if="lang == 'th_TH'">ล็อต</t>
                                        <t t-else="">Lot</t>
                                    </td>
                                    <td t-esc="o.lot_id.name or ''"/>
                                </tr>
                                <tr>
                                    <td class="text-muted">
                                        <t t-if="lang == 'th_TH'">จากคลัง</t>
                                        <t t-else="">Source Location</t>
                                    </td>
                                    <td t-esc="o.location_id.name or ''"/>
                                    <td class="text-muted">
                                        <t t-if="lang == 'th_TH'">ไปยังคลัง</t>
                                        <t t-else="">Scrap Location</t>
                                    </td>
                                    <td t-esc="o.scrap_location_id.name or ''"/>
                                </tr>
                                <tr>
                                    <td class="text-muted">
                                        <t t-if="lang == 'th_TH'">วันที่</t>
                                        <t t-else="">Date</t>
                                    </td>
                                    <td t-esc="o.date_done or ''"/>
                                    <td/>
                                    <td/>
                                </tr>
                            </tbody>
                        </table>

                        <div class="oe_structure"/>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- Report action -->
    <record id="action_report_scrap" model="ir.actions.report">
        <field name="name">Scrap Order</field>
        <field name="model">stock.scrap</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">vivafarm_gap_reports.report_scrap</field>
        <field name="report_file">vivafarm_gap_reports.report_scrap</field>
        <field name="paperformat_id" ref="vivafarm_report.paperformat_viva_invoice"/>
        <field name="binding_model_id" ref="stock.model_stock_scrap"/>
    </record>
</odoo>
