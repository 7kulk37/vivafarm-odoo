<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Daily Wage Sheet (บัญชีจ่ายค่าจ้างรายวัน) — Labor Law 76/114, PND1 evidence -->
    <template id="report_wage_sheet"
              name="Daily Wage Sheet (บัญชีจ่ายค่าจ้างรายวัน)">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <t t-set="layout_document_title">บัญชีจ่ายค่าจ้างรายวัน / Daily Wage Sheet</t>
                    <div class="page">
                        <div class="oe_structure"/>
                        <!-- Period line only — the letterhead already carries
                             the title (layout_document_title); the old body
                             title row duplicated it and wasted ~20pt. -->
                        <div class="text-end text-muted mb-1" style="font-size: 11px;">
                            <span t-esc="date_from"/> – <span t-esc="date_to"/>
                            <t t-if="worker_filter">
                                · <span t-esc="worker_filter"/>
                            </t>
                        </div>

                        <table class="table table-sm o_main_table" style="table-layout: fixed;">
                            <thead>
                                <tr>
                                    <th style="width: 4%;">
                                        <t t-if="lang == 'th_TH'">ลำดับ</t>
                                        <t t-else="">No.</t>
                                    </th>
                                    <th style="width: 10%;">
                                        <t t-if="lang == 'th_TH'">วันที่</t>
                                        <t t-else="">Date</t>
                                    </th>
                                    <th style="width: 14%;">
                                        <t t-if="lang == 'th_TH'">ชื่อ-นามสกุล</t>
                                        <t t-else="">Name</t>
                                    </th>
                                    <th style="width: 16%;">
                                        <t t-if="lang == 'th_TH'">เลขบัตรประชาชน</t>
                                        <t t-else="">ID Number</t>
                                    </th>
                                    <th style="width: 24%;">
                                        <t t-if="lang == 'th_TH'">งานที่ทำ</t>
                                        <t t-else="">Task</t>
                                    </th>
                                    <th class="text-end" style="width: 7%;">
                                        <t t-if="lang == 'th_TH'">ชั่วโมง</t>
                                        <t t-else="">Hours</t>
                                    </th>
                                    <th class="text-end" style="width: 10%;">
                                        <t t-if="lang == 'th_TH'">ค่าจ้าง</t>
                                        <t t-else="">Wage</t>
                                    </th>
                                    <th class="text-center" style="width: 15%;">
                                        <t t-if="lang == 'th_TH'">ลงชื่อผู้รับเงิน</t>
                                        <t t-else="">Signature</t>
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="workers" t-as="w">
                                    <tr t-foreach="w['rows']" t-as="r">
                                        <td class="text-center" t-esc="r_index + 1"/>
                                        <td t-esc="r['date']"/>
                                        <td t-esc="w['worker']"/>
                                        <td t-esc="w['id_number']"/>
                                        <td t-esc="r['task']"/>
                                        <td class="text-end" t-esc="r['hours']"/>
                                        <td class="text-end" t-esc="'{:,.2f}'.format(r['wage'])"/>
                                        <td/>
                                    </tr>
                                    <tr class="fw-bold">
                                        <td colspan="5" class="text-end">
                                            <t t-if="lang == 'th_TH'">รวม</t>
                                            <t t-else="">Total</t>
                                            <span t-esc="w['worker']"/>
                                        </td>
                                        <td class="text-end" t-esc="w['total_hours']"/>
                                        <td class="text-end" t-esc="'{:,.2f}'.format(w['total_wage'])"/>
                                        <td/>
                                    </tr>
                                </t>
                                <tr t-if="not workers">
                                    <td colspan="8" class="text-muted">
                                        <t t-if="lang == 'th_TH'">ไม่มีรายการทำงานในช่วงเวลานี้</t>
                                        <t t-else="">No work logs in this period</t>
                                    </td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr class="fw-bold">
                                    <td colspan="5" class="text-end">
                                        <t t-if="lang == 'th_TH'">รวมทั้งสิ้น</t>
                                        <t t-else="">Grand Total</t>
                                    </td>
                                    <td class="text-end" t-esc="grand_hours"/>
                                    <td class="text-end" t-esc="grand_wage"/>
                                    <td/>
                                </tr>
                            </tfoot>
                        </table>

                        <div class="oe_structure"/>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- Report action -->
    <record id="action_report_wage_sheet" model="ir.actions.report">
        <field name="name">Daily Wage Sheet</field>
        <field name="model">gap.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">vivafarm_gap_reports.report_wage_sheet</field>
        <field name="report_file">vivafarm_gap_reports.report_wage_sheet</field>
        <field name="paperformat_id" ref="vivafarm_report.paperformat_viva_standard"/>
        <field name="print_report_name">'WageSheet_%s_%s' % (object.date_from, object.date_to)</field>
    </record>
</odoo>
