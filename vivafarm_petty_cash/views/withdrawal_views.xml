<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

    <record id="view_vivafarm_petty_cash_withdrawal_form" model="ir.ui.view">
        <field name="name">vivafarm.petty.cash.withdrawal.form</field>
        <field name="model">vivafarm.petty.cash.withdrawal</field>
        <field name="arch" type="xml">
            <form string="Petty Cash Withdrawal">
                <header>
                    <button name="action_approve" type="object"
                            string="Approve" class="btn-primary"
                            invisible="state != 'draft'" icon="fa-check"/>
                    <button name="action_pay" type="object"
                            string="Mark Paid" class="btn-primary"
                            invisible="state != 'approved'" icon="fa-money"/>
                    <button name="action_draft" type="object"
                            string="Reset to Draft"
                            invisible="state != 'cancelled'" icon="fa-undo"/>
                    <button name="action_cancel" type="object"
                            string="Cancel"
                            invisible="state not in ('draft','approved')" icon="fa-times"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,approved,paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="fund_id" options="{'no_create': True}"/>
                            <field name="date"/>
                            <field name="requested_by" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="amount" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="purpose" placeholder="Why is the cash being withdrawn?"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_vivafarm_petty_cash_withdrawal_tree" model="ir.ui.view">
        <field name="name">vivafarm.petty.cash.withdrawal.tree</field>
        <field name="model">vivafarm.petty.cash.withdrawal</field>
        <field name="arch" type="xml">
            <list string="Petty Cash Withdrawals"
                  decoration-info="state=='draft'"
                  decoration-warning="state=='approved'"
                  decoration-success="state=='paid'"
                  decoration-muted="state=='cancelled'">
                <field name="name"/>
                <field name="date"/>
                <field name="fund_id"/>
                <field name="requested_by"/>
                <field name="purpose"/>
                <field name="amount" widget="monetary"/>
                <field name="state" widget="badge" decoration-bf="state=='paid'"/>
            </list>
        </field>
    </record>

    <record id="action_vivafarm_petty_cash_withdrawal" model="ir.actions.act_window">
        <field name="name">Petty Cash Withdrawals</field>
        <field name="res_model">vivafarm.petty.cash.withdrawal</field>
        <field name="view_mode">list,form</field>
    </record>

    </data>
</odoo>
