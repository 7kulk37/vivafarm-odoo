<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_petty_cash_voucher" model="ir.sequence">
            <field name="name">Petty Cash Voucher</field>
            <field name="code">vivafarm.petty.cash.voucher</field>
            <field name="prefix">PCV/%(year)s/%(month)s/</field>
            <field name="padding">4</field>
            <field name="use_date_range">True</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_petty_cash_voucher_receipt" model="ir.sequence">
            <field name="name">Petty Cash Receipt Voucher</field>
            <field name="code">vivafarm.petty.cash.voucher.receipt</field>
            <field name="prefix">RCV/%(year)s/%(month)s/</field>
            <field name="padding">4</field>
            <field name="use_date_range">True</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_petty_cash_voucher_general" model="ir.sequence">
            <field name="name">Petty Cash General Voucher</field>
            <field name="code">vivafarm.petty.cash.voucher.general</field>
            <field name="prefix">GCV/%(year)s/%(month)s/</field>
            <field name="padding">4</field>
            <field name="use_date_range">True</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_petty_cash_withdrawal" model="ir.sequence">
            <field name="name">Petty Cash Withdrawal</field>
            <field name="code">vivafarm.petty.cash.withdrawal</field>
            <field name="prefix">PCW/%(year)s/%(month)s/</field>
            <field name="padding">4</field>
            <field name="use_date_range">True</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
