<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Safety-net cron: resolve Omise promptpay charges whose charge.complete
         webhook was rejected/lost (see _cron_resolve_pending_charges). Every
         2 minutes — PromptPay payments are asynchronous and the webhook is the
         only signal, so a lost webhook must be caught quickly. -->
    <record id="cron_resolve_pending_charges" model="ir.cron">
        <field name="name">Omise: Resolve pending charges</field>
        <field name="model_id" ref="model_payment_transaction"/>
        <field name="state">code</field>
        <field name="code">model._cron_resolve_pending_charges()</field>
        <field name="interval_number">2</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
    </record>
</odoo>
