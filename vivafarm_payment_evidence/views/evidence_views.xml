<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_payment_evidence_list" model="ir.ui.view">
        <field name="name">viva.payment.evidence.list</field>
        <field name="model">viva.payment.evidence</field>
        <field name="arch" type="xml">
            <list string="Payment Evidence" create="false" delete="false">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="amount" string="Amount"/>
                <field name="state" widget="badge" decoration-success="state == 'validated'"
                       decoration-warning="state == 'pending'" decoration-danger="state == 'rejected'"/>
                <field name="filename"/>
                <field name="mimetype"/>
                <field name="file_size"/>
                <field name="check_result"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="view_payment_evidence_form" model="ir.ui.view">
        <field name="name">viva.payment.evidence.form</field>
        <field name="model">viva.payment.evidence</field>
        <field name="arch" type="xml">
            <form string="Payment Evidence" create="false" edit="false">
                <group>
                    <group>
                        <field name="name"/>
                        <field name="transaction_id"/>
                        <field name="partner_id"/>
                        <field name="amount"/>
                        <field name="state"/>
                    </group>
                    <group>
                        <field name="filename"/>
                        <field name="mimetype"/>
                        <field name="file_size"/>
                        <field name="create_date"/>
                    </group>
                </group>
                <field name="check_result" readonly="1"/>
                <field name="attachment_id" readonly="1" string="File"/>
                <field name="validated_by" readonly="1"/>
                <field name="validated_at" readonly="1"/>
                <div class="oe_button_box" colspan="2">
                    <button name="action_validate" type="object" string="Validate"
                            class="btn-primary" invisible="state != 'pending'"/>
                    <button name="action_reject" type="object" string="Reject"
                            class="btn-secondary" invisible="state != 'pending'"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_payment_evidence" model="ir.actions.act_window">
        <field name="name">Payment Evidence</field>
        <field name="res_model">viva.payment.evidence</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '!=', 'rejected')]</field>
    </record>

    <menuitem id="menu_payment_evidence"
              name="Payment Evidence"
              parent="account.menu_finance_receivables"
              action="action_payment_evidence"
              sequence="200"/>

</odoo>
