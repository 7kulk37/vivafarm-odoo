<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Signed-document list columns: archive state + Paperless doc id -->
    <record id="view_signed_document_paperless_list" model="ir.ui.view">
        <field name="name">viva.signed.document.paperless.list</field>
        <field name="model">viva.signed.document</field>
        <field name="inherit_id" ref="vivafarm_document_sign.viva_signed_document_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='signed_at']" position="after">
                <field name="paperless_upload_state" widget="badge"/>
                <field name="paperless_document_id"/>
            </xpath>
        </field>
    </record>

    <!-- Settings page: Paperless archive — SEPARATE block on General Settings.
         Inherits base_setup (the General page's own blocks: Users/Languages/
         Companies/Contacts + the <div id="emails"/> placeholder). NOTE: mail's
         view REPLACES that div with <block id="emails"> — so the xpath must
         target the BLOCK, not the div (verified ParseError 2026-08-27). -->
    <record id="res_config_settings_view_form_paperless" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.paperless</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='emails']" position="before">
                <block title="Paperless Archive" id="paperless_archive_setting_container">
                    <setting id="paperless_archive" string="Paperless Archive"
                             help="Archive signed documents into Paperless-ngx">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="paperless_base_url" string="Base URL" class="col-lg-3"/>
                                <field name="paperless_base_url"/>
                            </div>
                            <div class="row mt16">
                                <label for="paperless_api_token" string="API Token" class="col-lg-3"/>
                                <field name="paperless_api_token" password="True"/>
                            </div>
                            <div class="row mt16">
                                <label for="paperless_document_type_id" string="Document Type ID" class="col-lg-3"/>
                                <field name="paperless_document_type_id"/>
                            </div>
                            <div class="row mt16">
                                <label for="paperless_tag_id" string="Tag ID" class="col-lg-3"/>
                                <field name="paperless_tag_id"/>
                            </div>
                        </div>
                    </setting>
                    <setting id="paperless_verify_setting" string="Scheduled Verify"
                             help="Automatically re-check archived copies for integrity. Same control as the Scheduled Action 'Paperless: Verify archived copies'.">
                        <field name="paperless_verify_enabled"/>
                        <div class="content-group" invisible="not paperless_verify_enabled">
                            <div class="row mt16">
                                <label for="paperless_verify_interval" string="Verify Every" class="col-lg-3"/>
                                <field name="paperless_verify_interval"/>
                                <field name="paperless_verify_interval_type"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
