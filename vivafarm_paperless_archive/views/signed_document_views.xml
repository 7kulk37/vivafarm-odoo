<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Signed-document list columns: archive state + Paperless doc id -->
    <record id="view_signed_document_paperless_list" model="ir.ui.view">
        <field name="name">viva.signed.document.paperless.list</field>
        <field name="model">viva.signed.document</field>
        <field name="inherit_id" ref="vivafarm_document_sign.viva_signed_document_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='signed_at']" position="after">
                <field name="paperless_upload_state" widget="badge"/>
                <field name="paperless_document_id"/>
            </xpath>
        </field>
    </record>

    <!-- Settings page: Paperless archive section (Odoo 19 <setting> pattern,
         inheriting mail's settings form like digest/sms do) -->
    <record id="res_config_settings_view_form_paperless" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.paperless</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mail.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='restrict_template_rendering_setting']" position="before">
                <setting id="paperless_archive" string="Paperless Archive"
                         help="Archive signed documents into Paperless-ngx">
                    <div class="content-group">
                        <div>
                            <label for="paperless_base_url" string="Base URL"/>
                            <field name="paperless_base_url"/>
                        </div>
                        <div class="mt8">
                            <label for="paperless_api_token" string="API Token"/>
                            <field name="paperless_api_token" password="True"/>
                        </div>
                        <div class="mt8">
                            <label for="paperless_document_type_id" string="Document Type ID"/>
                            <field name="paperless_document_type_id"/>
                        </div>
                        <div class="mt8">
                            <label for="paperless_tag_id" string="Tag ID"/>
                            <field name="paperless_tag_id"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
