<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- "Accept & Sign quotation" confirmation email template — used ONLY by
         the new portal route /my/orders/<id>/accept_viva (VivaSalePortal.
         portal_order_accept_viva). The standard accept flow sends
         sale.mail_template_sale_confirmation (template 21) whose report is
         sale.report_saleorder — the DEFAULT form. This template mirrors
         sale.email_template_edi_sale but attaches the Viva custom
         Quotation/SO report (vivafarm_report.viva_quotation_so), and the
         route sends it AFTER action_confirm has hashed the order — so
         ir_actions_report._render_qweb_pdf serves the STORED SIGNED PDF
         bytes (hash block included, byte-identical to the signed doc). -->
    <record id="viva_email_template_order_confirmation" model="mail.template">
        <field name="name">Sales: Order Confirmation (Viva)</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="subject">{{ object.company_id.name }} {{ object.state in ('draft', 'sent') and 'Quotation' or 'Order' }} (Ref {{ object.name or 'n/a' }})</field>
        <field name="email_from">{{ (object.user_id.email_formatted or object.company_id.email_formatted or user.email_formatted) }}</field>
        <field name="partner_to" eval="False"/>
        <field name="use_default_to" eval="True"/>
        <field name="description">Sent when a customer accepts &amp; signs a quotation via the portal — carries the Viva signed Order PDF</field>
        <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        Hello,
        <br/><br/>
        Your order <span style="font-weight: bold;" t-out="object.name or ''">S00049</span>
        amounting in <span style="font-weight: bold;" t-out="format_amount(object.amount_total, object.currency_id) or ''">$ 10.00</span>
        has been confirmed. Thank you for your trust!
        <br/><br/>
        The signed order document is attached to this email.
        <t t-set="documents" t-value="object._get_product_documents()"/>
        <t t-if="documents">
            <br/>
            <t t-if="len(documents)>1">
                Here are some additional documents that may interest you:
            </t>
            <t t-else="">
                Here is an additional document that may interest you:
            </t>
            <ul style="margin-bottom: 0;">
                <t t-foreach="documents" t-as="document">
                    <li style="font-size: 13px;">
                        <a t-out="document.ir_attachment_id.name"
                            t-att-href="object.get_portal_url('/document/' + str(document.id))"
                            t-att-target="target"/>
                    </li>
                </t>
            </ul>
        </t>
        <br/>
        Do not hesitate to contact us if you have any questions.
        <t t-if="not is_html_empty(object.user_id.signature)">
            <div>--<br/><t t-out="object.user_id.signature or ''">Mitchell Admin</t></div>
        </t>
    </p>
</div>
        </field>
        <field name="report_template_ids" eval="[(4, ref('vivafarm_report.action_report_viva_quotation_so'))]"/>
        <field name="auto_delete" eval="True"/>
    </record>
</odoo>
