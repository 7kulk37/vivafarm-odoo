<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- "Accept & Sign Invoice" confirmation email template — used ONLY by the
         portal route /my/invoices/<id>/accept_viva (VivaInvoicePortal /
         VivaSalePortal.portal_invoice_accept_viva). The customer acknowledged
         the invoice (ใบแจ้งหนี้) on the portal; this email carries the signed
         Viva Invoice PDF (vivafarm_report.viva_invoice_plain) — the route
         sends it AFTER _hash_invoice_accepted has stored the signed bytes, so
         ir_actions_report._render_qweb_pdf serves the STORED SIGNED PDF
         (hash block included, byte-identical to the acknowledged doc).

         EVIDENCE-ONLY (lawyer sign-off 2026-08-19): the acknowledgment never
         gates payment; this email is the customer's copy of the signed
         document, mirroring the SO confirmation template. -->
    <record id="viva_email_template_invoice_acknowledgment" model="mail.template">
        <field name="name">Invoice: Acknowledged (Viva)</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="subject">Invoice acknowledgement confirmation (Ref {{ object.name or 'n/a' }})</field>
        <field name="email_from">{{ (object.invoice_user_id.email_formatted or object.company_id.email_formatted or user.email_formatted) }}</field>
        <field name="partner_to" eval="False"/>
        <field name="use_default_to" eval="True"/>
        <field name="description">Sent when a customer acknowledges &amp; signs an invoice via the portal — carries the Viva signed Invoice PDF</field>
        <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        Dear <t t-out="object.partner_id.name or ''">Customer</t>,
        <br/><br/>
        Thank you for acknowledging your invoice
        <span style="font-weight: bold;" t-out="object.name or ''">INV/2026/00030</span>
        amounting in <span style="font-weight: bold;" t-out="format_amount(object.amount_total, object.currency_id) or ''">฿ 1,000.00</span>.
        <br/><br/>
        The signed invoice document is attached to this email.
        <br/><br/>
        Do not hesitate to contact us if you have any questions.
        <t t-if="not is_html_empty(object.invoice_user_id.signature)">
            <div>--<br/><t t-out="object.invoice_user_id.signature or ''">Seller</t></div>
        </t>
    </p>
</div>
        </field>
        <field name="report_template_ids" eval="[(4, ref('vivafarm_report.report_viva_invoice_plain'))]"/>
        <field name="auto_delete" eval="True"/>
    </record>
</odoo>
