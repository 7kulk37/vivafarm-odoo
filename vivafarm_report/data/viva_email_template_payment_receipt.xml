<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Portal payment receipt confirmation email — sent automatically when a
         customer pays an invoice through the portal via a payment gateway
         (Omise card / PromptPay). Triggered from the vivafarm_payment_omise
         _create_payment override (online_direct, invoice linked). This email
         carries the Viva Payment Receipt PDF (vivafarm_report.viva_payment_receipt).

         Scope (user instruction 2026-08-20): gateway payments ONLY. Wire
         transfer / evidence upload / manual reconcile flows never fire this
         template — they require seller validation first. -->
    <record id="viva_email_template_payment_receipt" model="mail.template">
        <field name="name">Payment: Payment Receipt (Viva)</field>
        <field name="model_id" ref="account.model_account_payment"/>
        <field name="subject">Payment receipt {{ object.name }} (Ref {{ object.reconciled_invoice_ids[:1].name or 'n/a' }})</field>
        <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
        <field name="partner_to" eval="False"/>
        <field name="use_default_to" eval="True"/>
        <field name="description">Sent automatically when a customer pays an invoice via the portal gateway — carries the Viva Payment Receipt PDF</field>
        <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        Dear <t t-out="object.partner_id.name or ''">Customer</t>,
        <br/><br/>
        Thank you for your payment of
        <span style="font-weight: bold;" t-out="format_amount(object.amount, object.currency_id) or ''">฿ 600.00</span>
        <t t-if="object.reconciled_invoice_ids[:1]">
            for invoice <span style="font-weight: bold;" t-out="object.reconciled_invoice_ids[:1].name or ''">INV/2026/00036</span>
        </t>.
        <br/><br/>
        The payment receipt is attached to this email.
        <br/><br/>
        Do not hesitate to contact us if you have any questions.
    </p>
</div>
        </field>
        <field name="report_template_ids" eval="[(4, ref('vivafarm_report.action_report_viva_payment_receipt'))]"/>
        <field name="auto_delete" eval="True"/>
    </record>
</odoo>
