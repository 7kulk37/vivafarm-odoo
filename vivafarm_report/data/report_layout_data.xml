<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="report_layout_viva" model="report.layout">
        <field name="name">Viva</field>
        <field name="view_id" ref="vivafarm_report.external_layout_viva"/>
        <field name="image">data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR4nGNgYPgPAAEDAQAIicLsAAAAASUVORK5CYII=</field>
    </record>

    <!-- A4 paperformat for the VivaFarm tax invoice.
         margin_top is large enough to hold the repeating header block
         (logo + company + badge + title + address + info section), which
         wkhtmltopdf renders inside the top margin area via header-html.
         header_spacing MUST equal margin_top: wkhtmltopdf bottom-aligns
         header-html content inside a frame of height (margin_top - header_spacing)
         anchored at the frame's bottom edge. If header_spacing < margin_top the
         tall header rides down and overlaps the body table; with equal values the
         frame is zero-height and content anchors at the top of the page.
         margin_left/right (5.6mm) match the reference perfect-1-page fit
         (Tax Invoice-72_perfect_onepage_fit.pdf: content inset ~26.2pt =
         5.6mm + the template's ~10pt baseline padding). -->
    <record id="paperformat_viva_invoice" model="report.paperformat">
        <field name="name">VivaFarm Tax Invoice A4</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">90</field>
        <field name="margin_bottom">32</field>
        <field name="margin_left">5.6</field>
        <field name="margin_right">5.6</field>
        <field name="header_spacing">90</field>
        <field name="dpi">90</field>
    </record>
</odoo>
