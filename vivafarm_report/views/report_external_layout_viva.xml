<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="external_layout_viva"
              name="VivaFarm Layout">
        <!-- Company setup (same as web.external_layout) -->
        <t t-if="not o" t-set="o" t-value="doc"/>
        <t t-if="not company">
            <t t-if="company_id">
                <t t-set="company" t-value="company_id"/>
            </t>
            <t t-elif="o and 'company_id' in o and o.company_id.sudo()">
                <t t-set="company" t-value="o.company_id.sudo()"/>
            </t>
            <t t-else="">
                <t t-set="company" t-value="res_company"/>
            </t>
        </t>

        <!-- ════════════════════════════════════════════════════════════════
             BRANCH 1 — TAX INVOICE (is_tax_invoice is set only by the
             vivafarm_report.viva_invoice wrapper; undefined elsewhere).
             Full repeating header: logo + company + copy badge + document
             title + customer/shipping addresses + info section, so every
             sheet of a multi-page tax invoice carries elements (1)-(5) per
             ป.86/2542 ข้อ 9(2). The wrapper's paperformat_viva_invoice
             (margin_top 107mm) holds this tall header. Content kept
             verbatim from v53 — byte-identical PDF output.
             ════════════════════════════════════════════════════════════════ -->
        <t t-if="is_tax_invoice">
        <t t-set="header_shape_height" t-value="'200'"/>
        <div t-attf-class="header o_company_#{company.id}_layout" style="position: relative; padding: 41px 19pt 0;">
            <svg xmlns="http://www.w3.org/2000/svg" t-attf-class="{{report_type == 'pdf' and 'position-fixed' or 'position-absolute'}} start-0 top-0 {{report_type == 'pdf' and 'vw-100' or 'w-100'}} z-n1" preserveAspectRatio="none" t-att-height="header_shape_height" viewBox="0 0 1000 240" fill="none">
                <path d="M1000 230.734C937.384 240.621 803.83 250.266 562.185 220.602C311.343 189.809 104.626 201.375 0 211.598V0.5H1000V230.734Z" t-att-fill="company.primary_color" fill-opacity=".1"/>
            </svg>

            <div class="d-flex justify-content-between">
                <div style="width: 160px; flex-shrink: 0; text-align: center;">
                    <img t-if="company.logo" class="o_company_logo mb-2" t-att-src="image_data_uri(company.logo)" alt="Logo" style="height: 130px; width: auto;"/>
                </div>
                <div class="flex-grow-1 text-start">
                    <div style="font-size: 14px; line-height: 1.0;">
                        <div style="font-weight: bold; font-size: 20px; margin-bottom: 8px;">Viva la Finca CO.,LTD.</div>
                        <div style="font-weight: bold; font-size: 19px;">บริษัท วิว่า ลา ฟินก้า จำกัด</div>
                        <div style="margin-top: 8px;">
                            สำนักงานใหญ่ : 500 ซอยมัสยิด หมู่ 1 ตำบลคลองเขม้า อำเภอเหนือคลอง จังหวัดกระบี่ 81130
                        </div>
                        <div style="margin-top: 4px;">
                            Head office : 500 Soi Masjid, Moo 1, Khlong Khamot, Nuea Khlong District, Krabi 81130, Thailand
                        </div>
                        <div style="margin-top: 6px;">
                            tel: 088-448-4846 &#160; TAX ID: 1819900144296
                        </div>
                    </div>
                </div>
            </div>
            <t t-if="copy_kind">
                <t t-set="badge_color" t-value="company.primary_color if copy_kind == 'original' else ('#d9534f' if copy_kind == 'company' else '#2980b9')"/>
                <div t-att-style="'position: absolute; top: 33px; right: 45px; border: 2px solid %s; border-radius: 4px; padding: 2px 12px; font-weight: bold; font-size: 11px; background: #fff; white-space: nowrap; color: %s;' % (badge_color, badge_color)">
                    <t t-if="lang == 'th_TH'">
                        <t t-out="copy['th_marker']"/> / <t t-out="copy['th_recipient']"/>
                    </t>
                    <t t-else="">
                        <t t-out="copy['en_marker']"/> / <t t-out="copy['en_recipient']"/>
                    </t>
                </div>
            </t>

            <!-- Document title (nowrap: must stay one line at side margins).
                 margin-top calibrated so title lands at y=147.4 like the
                 reference perfect-1-page fit (INV/2026/00058) -->
            <h2 t-out="layout_document_title" t-att-style="'font-size: 28px; line-height: 1.5; margin-top: 83px; margin-bottom: 12px; white-space: nowrap;'"/>

            <!-- Address row: billing (address) LEFT, shipping (information_block) RIGHT -->
            <div t-if="address" class="address row mb-2" title="This block is not always present depending on the printed document.">
                <t t-if="information_block">
                    <div name="address" class="col-6">
                        <strong class="d-block mt-1" style="font-size: 16px; font-weight: bold;">
                            <t t-if="lang == 'th_TH'">ผู้ซื้อ</t>
                            <t t-else="">Customer</t>
                        </strong>
                        <div style="font-size: 14px; line-height: 1.25;">
                            <t t-esc="address or None"/>
                        </div>
                    </div>
                    <div name="information_block" class="col-6">
                        <div style="font-size: 14px; line-height: 1.25;">
                            <t t-out="information_block or None"/>
                        </div>
                    </div>
                </t>
                <t t-else="">
                    <div name="address">
                        <strong class="d-block mt-1" style="font-size: 16px; font-weight: bold;">
                            <t t-if="lang == 'th_TH'">ผู้ซื้อ</t>
                            <t t-else="">Customer</t>
                        </strong>
                        <div style="font-size: 14px; line-height: 1.25;">
                            <t t-esc="address or None"/>
                        </div>
                    </div>
                </t>
            </div>

            <!-- Info section (dates / references): repeated on every page.
                 INVOICE-ONLY: fields below exist only on account.move. Other
                 documents (sale.order, stock.picking, purchase.order,
                 hr.expense, ...) share this layout through the company's
                 external_report_layout_id and would crash on o.invoice_date.
                 margin-top: 18px matches the reference perfect-1-page fit. -->
            <div
                t-if="o and o._name == 'account.move' and (o.invoice_date or (o.invoice_date_due and o.move_type == 'out_invoice' and o.state == 'posted') or o.delivery_date or o.invoice_origin or o.partner_id.ref or o.ref or o.invoice_incoterm_id)"
                id="informations" class="row mb-2 mx-0"
                t-att-style="'background-color: %s; border-radius: 8px; padding: 8px 10px; margin-top: 18px; page-break-inside: avoid;' % (o.company_id._get_light_tint(o.company_id.secondary_color))">
                <div class="col" t-if="o.invoice_date" name="invoice_date">
                    <t t-if="o.move_type == 'out_invoice'">
                        <t t-if="lang == 'th_TH'"><strong>วันที่ออกใบแจ้งหนี้</strong></t>
                        <t t-else=""><strong>Invoice Date</strong></t>
                    </t>
                    <t t-elif="o.move_type == 'out_refund'">
                        <t t-if="lang == 'th_TH'"><strong>วันที่บันทึกเครดิต</strong></t>
                        <t t-else=""><strong>Credit Note Date</strong></t>
                    </t>
                    <t t-elif="o.move_type == 'out_receipt'">
                        <t t-if="lang == 'th_TH'"><strong>วันที่รับสินค้า</strong></t>
                        <t t-else=""><strong>Receipt Date</strong></t>
                    </t>
                    <t t-else="">
                        <t t-if="lang == 'th_TH'"><strong>วันที่</strong></t>
                        <t t-else=""><strong>Date</strong></t>
                    </t>
                    <t t-if="lang == 'th_TH'"><div t-out="o._get_thai_date_display('invoice_date')">03/ส.ค./2569</div></t>
                    <t t-else=""><div t-field="o.invoice_date">2026-09-12</div></t>
                </div>
                <div class="col" t-if="o.invoice_date_due and o.move_type == 'out_invoice' and o.state == 'posted'" name="due_date">
                    <t t-if="lang == 'th_TH'"><strong>กำหนดส่ง</strong></t>
                    <t t-else=""><strong>Due Date</strong></t>
                    <t t-if="lang == 'th_TH'"><div t-out="o._get_thai_date_display('invoice_date_due')">02/ก.ย./2569</div></t>
                    <t t-else=""><div t-field="o.invoice_date_due">2026-10-31</div></t>
                </div>
                <div class="col" t-if="o.taxable_supply_date and o.show_taxable_supply_date" name="taxable_supply_date">
                    <t t-if="lang == 'th_TH'"><strong>วันที่ขายสินค้า</strong></t>
                    <t t-else=""><strong>Taxable Supply</strong></t>
                    <t t-if="lang == 'th_TH'"><div t-out="o._get_thai_date_display('taxable_supply_date')">03/ส.ค./2569</div></t>
                    <t t-else=""><div t-field="o.taxable_supply_date">2026-10-31</div></t>
                </div>
                <div class="col" t-if="o.delivery_date" name="delivery_date">
                    <t t-if="lang == 'th_TH'"><strong>วันที่จัดส่งสินค้า</strong></t>
                    <t t-else=""><strong>Delivery Date</strong></t>
                    <t t-if="lang == 'th_TH'"><div t-out="o._get_thai_date_display('delivery_date')">03/ส.ค./2569</div></t>
                    <t t-else=""><div t-field="o.delivery_date">2026-09-25</div></t>
                </div>
                <div class="col" t-if="o.invoice_origin" name="origin">
                    <t t-if="lang == 'th_TH'"><strong>แหล่งที่มา</strong></t>
                    <t t-else=""><strong>Source</strong></t>
                    <div t-field="o.invoice_origin">SO123</div>
                </div>
                <div class="col" t-if="o.partner_id.ref" name="customer_code">
                    <t t-if="lang == 'th_TH'"><strong>รหัสลูกค้า</strong></t>
                    <t t-else=""><strong>Customer Code</strong></t>
                    <div t-field="o.partner_id.ref"/>
                </div>
                <div class="col" t-if="o.ref" name="reference">
                    <t t-if="lang == 'th_TH'"><strong>ข้อมูลอ้างอิง</strong></t>
                    <t t-else=""><strong>Reference</strong></t>
                    <div t-field="o.ref" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%;">INV/2026/0001</div>
                </div>
                <div class="col" t-if="o.invoice_incoterm_id" name="incoterm_id">
                    <t t-if="lang == 'th_TH'"><strong>เงื่อนไขการส่งมอบ</strong></t>
                    <t t-else=""><strong>Incoterm</strong></t>
                    <div t-if="o.incoterm_location">
                        <span t-field="o.invoice_incoterm_id.code"/> <br/>
                        <span t-field="o.incoterm_location"/>
                    </div>
                    <div t-else="" t-field="o.invoice_incoterm_id.code" class="m-0"/>
                </div>
            </div>
            <!-- Info section (Quotation/SO): the quotation/SO document sets
                 is_tax_invoice=True and renders through this branch; its own
                 info bar must live IN THE HEADER FRAME (like the invoice's)
                 so there is no dead space between the address block and the
                 bar, and the font inherits the base size (matches line items).
                 Gated on sale.order so account.move renders are byte-identical.
                 Compact padding so the bar fits the fixed 107mm header frame. -->
            <t t-if="o and o._name == 'sale.order'"><div
                id="informations" class="row mb-2 mx-0"
                t-att-style="'background-color: %s; border-radius: 8px; padding: 3px 10px; margin-top: 4px; page-break-inside: avoid; line-height: 1.15; flex-wrap: wrap;' % (o.company_id._get_light_tint(o.company_id.secondary_color))">
                <!-- Row 1: dates (3 cols) + Row 2: references (3 cols) via
                     flex-wrap — NO nested .row (nested flexbox makes old
                     WebKit scale the whole 107mm header frame down 0.625x). -->
                <div class="col" style="flex: 0 0 33.33%; max-width: 33.33%; padding-right: 3px;" name="so_date">
                    <t t-if="o.state in ['draft', 'sent']">
                        <t t-if="lang == 'th_TH'"><strong>วันที่เสนอราคา</strong></t>
                        <t t-else=""><strong>Quotation Date</strong></t>
                    </t>
                    <t t-else="">
                        <t t-if="lang == 'th_TH'"><strong>วันที่สั่งซื้อ</strong></t>
                        <t t-else=""><strong>Order Date</strong></t>
                    </t>
                    <t t-if="lang == 'th_TH'"><div t-out="o._get_thai_date_display('date_order')">03/ส.ค./2569</div></t>
                    <t t-else=""><div t-field="o.date_order" t-options="{&quot;date_only&quot;: &quot;true&quot;}">2026-08-17</div></t>
                </div>
                <div class="col" style="flex: 0 0 33.33%; max-width: 33.33%; padding-right: 3px;" name="so_expiration">
                    <t t-if="lang == 'th_TH'"><strong>วันหมดอายุ</strong></t>
                    <t t-else=""><strong>Expiration</strong></t>
                    <t t-if="lang == 'th_TH'"><div t-out="o._get_thai_date_display('validity_date')">03/ส.ค./2569</div></t>
                    <t t-else=""><div t-field="o.validity_date" t-options="{&quot;date_only&quot;: &quot;true&quot;}">2026-09-16</div></t>
                </div>
                <div class="col" style="flex: 0 0 33.33%; max-width: 33.33%; padding-left: 3px;" name="so_delivery">
                    <t t-if="lang == 'th_TH'"><strong>วันที่ส่งมอบ</strong></t>
                    <t t-else=""><strong>Delivery Date</strong></t>
                    <t t-if="lang == 'th_TH'"><div t-out="o._get_thai_date_display('commitment_date')">03/ส.ค./2569</div></t>
                    <t t-else=""><div t-field="o.commitment_date" t-options="{&quot;date_only&quot;: &quot;true&quot;}">2026-08-17</div></t>
                </div>
                <div class="col" style="flex: 0 0 33.33%; max-width: 33.33%; padding-right: 3px;" name="so_ref">
                    <t t-if="lang == 'th_TH'"><strong>เลขที่อ้างอิงของท่าน</strong></t>
                    <t t-else=""><strong>Your Reference</strong></t>
                    <div t-field="o.client_order_ref"/>
                </div>
                <div class="col" style="flex: 0 0 33.33%; max-width: 33.33%; padding-right: 3px;" name="so_terms">
                    <t t-if="lang == 'th_TH'"><strong>เงื่อนไขการชำระเงิน</strong></t>
                    <t t-else=""><strong>Payment Terms</strong></t>
                    <div t-field="o.payment_term_id"/>
                </div>
                <div class="col" style="flex: 0 0 33.33%; max-width: 33.33%; padding-left: 3px;" name="so_salesperson">
                    <t t-if="lang == 'th_TH'"><strong>พนักงานขาย</strong></t>
                    <t t-else=""><strong>Salesperson</strong></t>
                    <div t-field="o.user_id"/>
                </div>
            </div></t>
        </div>
        </t>

        <!-- ════════════════════════════════════════════════════════════════
             BRANCH 2 — STANDARD DOCUMENTS (sale.order, stock.picking,
             account.move Invoice PDF, purchase.order, hr.expense, ...).
             These templates call web.external_layout → external_layout_viva
             and hand `address`/`information_block`/`layout_document_title`
             as t-sets, expecting the layout to render them in the BODY
             article (the standard Odoo contract — see external_layout_striped:
             header = logo + company only). They also assume the company's
             default paperformat (52mm A4 top margin), NOT the 107mm tax
             invoice paperformat. Rendering their address fragments inside a
             107mm header overlay overflowed into the body table (SO shipping
             address painted over the table header; Delivery Slip customer
             block landed on the company block). So: compact Viva header,
             addresses + title flow in the body article.
             ════════════════════════════════════════════════════════════════ -->
        <t t-else="">
        <t t-set="header_shape_height" t-value="'200'"/>
        <div t-attf-class="header o_company_#{company.id}_layout" style="position: relative; padding: 41px 19pt 0;">
            <svg xmlns="http://www.w3.org/2000/svg" t-attf-class="{{report_type == 'pdf' and 'position-fixed' or 'position-absolute'}} start-0 top-0 {{report_type == 'pdf' and 'vw-100' or 'w-100'}} z-n1" preserveAspectRatio="none" t-att-height="header_shape_height" viewBox="0 0 1000 240" fill="none">
                <path d="M1000 230.734C937.384 240.621 803.83 250.266 562.185 220.602C311.343 189.809 104.626 201.375 0 211.598V0.5H1000V230.734Z" t-att-fill="company.primary_color" fill-opacity=".1"/>
            </svg>

            <!-- Company block: IDENTICAL styles to the tax invoice branch
                 (logo 130px, name 20/19px, address 14px, margins 8/4/6) so
                 every report's header matches the Tax Invoice. Standard docs
                 render no badge/title/addresses here — those flow in the
                 body article. Kept as duplicate markup (not a shared t-call)
                 so the tax invoice branch's rendered HTML stays byte-identical. -->
            <div class="d-flex justify-content-between">
                <div style="width: 160px; flex-shrink: 0; text-align: center;">
                    <img t-if="company.logo" class="o_company_logo mb-2" t-att-src="image_data_uri(company.logo)" alt="Logo" style="height: 130px; width: auto;"/>
                </div>
                <div class="flex-grow-1 text-start">
                    <div style="font-size: 14px; line-height: 1.0;">
                        <div style="font-weight: bold; font-size: 20px; margin-bottom: 8px;">Viva la Finca CO.,LTD.</div>
                        <div style="font-weight: bold; font-size: 19px;">บริษัท วิว่า ลา ฟินก้า จำกัด</div>
                        <div style="margin-top: 8px;">
                            สำนักงานใหญ่ : 500 ซอยมัสยิด หมู่ 1 ตำบลคลองเขม้า อำเภอเหนือคลอง จังหวัดกระบี่ 81130
                        </div>
                        <div style="margin-top: 4px;">
                            Head office : 500 Soi Masjid, Moo 1, Khlong Khamot, Nuea Khlong District, Krabi 81130, Thailand
                        </div>
                        <div style="margin-top: 6px;">
                            tel: 088-448-4846 &#160; TAX ID: 1819900144296
                        </div>
                    </div>
                </div>
            </div>
            <!-- Copy badge (payment receipt): top-right, same position as the
                 tax invoice badge. Gated on is_payment_receipt so standard
                 documents (sale order, delivery slip, ...) stay badge-free. -->
            <t t-if="is_payment_receipt and copy_kind">
                <t t-set="badge_color" t-value="company.primary_color if copy_kind == 'original' else ('#d9534f' if copy_kind == 'company' else '#2980b9')"/>
                <div t-att-style="'position: absolute; top: 33px; right: 45px; border: 2px solid %s; border-radius: 4px; padding: 2px 12px; font-weight: bold; font-size: 11px; background: #fff; white-space: nowrap; color: %s;' % (badge_color, badge_color)">
                    <t t-if="lang == 'th_TH'">
                        <t t-out="copy['th_marker']"/> / <t t-out="copy['th_recipient']"/>
                    </t>
                    <t t-else="">
                        <t t-out="copy['en_marker']"/> / <t t-out="copy['en_recipient']"/>
                    </t>
                </div>
            </t>
            <!-- Copy badge (credit note): same position, gated on is_credit_note. -->
            <t t-if="is_credit_note and copy_kind">
                <t t-set="badge_color" t-value="company.primary_color if copy_kind == 'original' else ('#d9534f' if copy_kind == 'company' else '#2980b9')"/>
                <div t-att-style="'position: absolute; top: 33px; right: 45px; border: 2px solid %s; border-radius: 4px; padding: 2px 12px; font-weight: bold; font-size: 11px; background: #fff; white-space: nowrap; color: %s;' % (badge_color, badge_color)">
                    <t t-if="lang == 'th_TH'">
                        <t t-out="copy['th_marker']"/> / <t t-out="copy['th_recipient']"/>
                    </t>
                    <t t-else="">
                        <t t-out="copy['en_marker']"/> / <t t-out="copy['en_recipient']"/>
                    </t>
                </div>
            </t>
            <!-- Copy badge (debit note): same position, gated on is_debit_note.
                 A debit note is DEEMED a tax invoice (มาตรา 86/4 via 86/9),
                 so it carries the same triplicate badge as the invoice/CN. -->
            <t t-if="is_debit_note and copy_kind">
                <t t-set="badge_color" t-value="company.primary_color if copy_kind == 'original' else ('#d9534f' if copy_kind == 'company' else '#2980b9')"/>
                <div t-att-style="'position: absolute; top: 33px; right: 45px; border: 2px solid %s; border-radius: 4px; padding: 2px 12px; font-weight: bold; font-size: 11px; background: #fff; white-space: nowrap; color: %s;' % (badge_color, badge_color)">
                    <t t-if="lang == 'th_TH'">
                        <t t-out="copy['th_marker']"/> / <t t-out="copy['th_recipient']"/>
                    </t>
                    <t t-else="">
                        <t t-out="copy['en_marker']"/> / <t t-out="copy['en_recipient']"/>
                    </t>
                </div>
            </t>
        </div>
        </t>

        <!-- BODY -->
        <t t-set="layout_background_url" t-value="'data:image/png;base64,%s' % company.layout_background_image.decode('utf-8') if company.layout_background_image and company.layout_background == 'Custom' else                 '/base/static/img/demo_logo_report.png' if company.layout_background == 'Demo logo' else ''"/>
        <div t-attf-class="article o_report_layout_wave o_table_striped o_company_#{company.id}_layout {{'o_report_layout_background' if company.layout_background != 'Blank' else ''}}" t-attf-style="{{ 'background-image: url(%s);' % layout_background_url if layout_background_url else ''}} padding: 0 19pt; {{'position: relative;' if (o and o._name == 'account.move' and o.state == 'cancel') else ''}}" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">
            <t t-set="custom_layout_address" t-value="true"/>
            <!-- ยกเลิก/VOID stamp on cancelled account moves (ป.86/2542
                 ข้อ 25(1): recall the original and stamp/score it out).
                 Flat bordered box — wkhtmltopdf's old WebKit ignores
                 transforms, so no rotation. Positioned over the body so the
                 essential elements stay readable beneath the stamp. -->
            <t t-if="o and o._name == 'account.move' and o.state == 'cancel'">
                <div t-att-style="'position: absolute; top: 45%; left: 50%; transform: translate(-50%, -50%); border: 5px solid #c0392b; border-radius: 8px; padding: 18px 34px; font-weight: 900; font-size: 34px; letter-spacing: 4px; color: #c0392b; background: rgba(255,255,255,0.65); z-index: 10; text-align: center;'">
                    <t t-if="lang == 'th_TH'">ยกเลิก</t>
                    <t t-else="">VOID</t>
                </div>
            </t>
            <!-- Replacement note (ป.86/2542 ข้อ 25(3)): the re-issued
                 invoice must state it replaces the voided original. Renders
                 full-width ABOVE the line table so it wraps freely — the
                 `ref` field ellipsizes inside the header frame and cannot
                 carry this note. -->
            <t t-if="o and o._name == 'account.move' and o.replacement_of_id">
                <div t-att-style="'background: %s; border: 3px solid %s; border-radius: 6px; padding: 8px 12px; margin: 8px 0 10px; font-size: 13px; line-height: 1.45; page-break-inside: avoid;' % (o.company_id._get_light_tint(o.company_id.primary_color), o.company_id.primary_color or '#000000')">
                    <strong>
                        <t t-if="lang == 'th_TH'">ออกแทนใบกำกับภาษีฉบับเดิมเลขที่</t>
                        <t t-else="">Issued to replace tax invoice no.</t>
                    </strong>
                    <span t-field="o.replacement_of_id.name">INV/2026/00014</span>
                </div>
            </t>
            <style>
                /* Standard report tables (o_main_table) have no bold header — the
                   default layouts' thead th rule is scoped to .o_table_bold, which
                   o_main_table doesn't use. Make the header row visually distinct
                   (bold + top border) so it reads as a header, matching the tax
                   invoice's fw-bold thead. :not(.fw-bold) excludes the tax invoice,
                   whose th already carry fw-bold — adding a border there would
                   shift its table down and break the reference geometry. */
                .article table.o_main_table thead th:not(.fw-bold) {
                    font-weight: 700 !important;
                    border-top: 3px solid #212529 !important;
                }
            </style>
            <!-- Standard documents: addresses + title flow in the BODY article
                 (standard Odoo contract, same as external_layout_striped).
                 The tax invoice branch keeps its own header addresses/info and
                 must NOT render web.address_layout here (would duplicate). -->
            <t t-if="not is_tax_invoice">
                <div class="pt-2">
                    <t t-call="web.address_layout"/>
                    <h2 t-if="layout_document_title" class="o_folder_title mt-2 text-nowrap" t-out="layout_document_title"/>
                </div>
            </t>
            <div class="oe_structure"/>
            <t t-out="0"/>
        </div>

        <!-- Footer -->
        <div t-attf-class="footer o_company_#{company.id}_layout {{report_type != 'pdf' and 'position-relative mt-auto mx-n5'}}">
            <svg xmlns="http://www.w3.org/2000/svg" t-attf-class="{{report_type == 'pdf' and 'position-fixed start-0'}} w-100" preserveAspectRatio="none" t-att-height="report_type == 'pdf' and '180'" viewBox="0 0 1000 180" fill="none">
                <path d="M427.731 19.757C686.904 51.3469 898.971 38.039 1000 27.6922V180H0V8.20934C66.363 -0.991089 198.347 -8.20218 427.731 19.757Z" t-att-fill="company.secondary_color" fill-opacity=".1"/>
            </svg>
            <div t-attf-class="o_footer_content {{report_type != 'pdf' and 'position-absolute end-0 start-0 bottom-0 mx-5'}} pt-5 text-center">
                <div t-field="company.report_footer"/>
                <span t-if="report_type == 'pdf' and display_name_in_footer" class="text-muted" t-out="str(o.name) + ', '">(document name)</span>
                <t t-if="report_type == 'pdf'">
                    <t t-if="lang == 'th_TH'">
                        <span class="text-muted">หน้าที่ <span class="page"/> / <span class="topage"/></span>
                    </t>
                    <t t-else="">
                        <span class="text-muted">Page <span class="page"/> / <span class="topage"/></span>
                    </t>
                </t>
            </div>
        </div>
    </template>
</odoo>
