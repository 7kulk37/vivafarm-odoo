<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        VivaFarm Invoice — fully self-contained report.
        No inherit_id on Odoo baseline templates.
        Wrapper → Layout → Content, all in this module.
    -->

    <!-- ── Content: Viva Invoice Document ── -->
    <template id="viva_invoice_document"
              name="VivaFarm Invoice Document">
        <t t-call="vivafarm_report.external_layout_viva">
            <t t-set="o" t-value="o.with_context(lang=lang)" />
            <t t-set="forced_vat" t-value="o.fiscal_position_id.foreign_vat"/>
            <div class="row">
                <t t-if="o.partner_shipping_id and (o.partner_shipping_id != o.partner_id)">
                    <div class="col-6">
                        <t t-set="information_block" groups="account.group_delivery_invoice_address">
                            <div name="shipping_address_block">
                                <strong class="d-block mt-3">
                                <t t-if="lang == 'th_TH'">ที่อยู่จัดส่ง</t>
                                <t t-else="">Shipping Address</t>
                            </strong>
                                <div t-field="o.partner_shipping_id.name">Branch name</div>
                                <div t-field="o.partner_shipping_id" t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}'/>
                            </div>
                        </t>
                    </div>
                    <div class="col-6" name="address_not_same_as_shipping">
                        <t t-set="address">
                            <address class="mb-0" t-field="o.partner_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
                            <div t-if="o.partner_id.vat" id="partner_vat_address_not_same_as_shipping">
                                <t t-if="o.company_id.account_fiscal_country_id.vat_label" t-out="o.company_id.account_fiscal_country_id.vat_label" id="inv_tax_id_label"/>
                                <t t-else="">Tax ID</t>: <span t-field="o.partner_id.vat"/>
                            </div>
                            <div class="mt-1">
                                <t t-if="lang == 'th_TH'">สาขา: สำนักงานใหญ่ (00000)</t>
                                <t t-else="">branch: Headquarter (00000)</t>
                            </div>
                        </t>
                    </div>
                </t>
                <t t-elif="o.partner_shipping_id and (o.partner_shipping_id == o.partner_id)">
                    <div class="offset-col-6 col-6" name="address_same_as_shipping">
                        <t t-set="address">
                            <address class="mb-0" t-field="o.partner_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
                            <div t-if="o.partner_id.vat" id="partner_vat_address_same_as_shipping">
                                <t t-if="o.company_id.account_fiscal_country_id.vat_label" t-out="o.company_id.account_fiscal_country_id.vat_label" id="inv_tax_id_label"/>
                                <t t-else="">Tax ID</t>: <span t-field="o.partner_id.vat"/>
                            </div>
                            <div class="mt-1">
                                <t t-if="lang == 'th_TH'">สาขา: สำนักงานใหญ่ (00000)</t>
                                <t t-else="">branch: Headquarter (00000)</t>
                            </div>
                        </t>
                    </div>
                </t>
                <t t-else="">
                    <div class="offset-col-6 col-6" name="no_shipping">
                        <t t-set="address">
                            <address class="mb-0" t-field="o.partner_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
                            <div t-if="o.partner_id.vat" id="partner_vat_no_shipping">
                                <t t-if="o.company_id.account_fiscal_country_id.vat_label" t-out="o.company_id.account_fiscal_country_id.vat_label" id="inv_tax_id_label"/>
                                <t t-else="">Tax ID</t>: <span t-field="o.partner_id.vat"/>
                            </div>
                            <div class="mt-1">
                                <t t-if="lang == 'th_TH'">สาขา: สำนักงานใหญ่ (00000)</t>
                                <t t-else="">branch: Headquarter (00000)</t>
                            </div>
                        </t>
                    </div>
                </t>
            </div>
            <div class="clearfix invoice_main">
                <div class="page mb-4">
                    <t t-set="layout_document_title">
                        <t t-if="not proforma">
                            <span t-if="o.move_type == 'out_invoice' and o.state == 'posted'">
                                <t t-if="lang == 'th_TH'" name="invoice_title">ใบกำกับภาษี / ใบส่งสินค้า / ใบแจ้งหนี้</t>
                                <t t-else="" name="invoice_title">TAX INVOICE / DELIVERY ORDER / INVOICE</t>
                            </span>
                            <span t-elif="o.move_type == 'out_invoice' and o.state == 'draft'">
                                <t t-if="lang == 'th_TH'" name="draft_invoice_title">ใบกำกับภาษี / ใบส่งสินค้า / ใบแจ้งหนี้ (ฉบับร่าง)</t>
                                <t t-else="" name="draft_invoice_title">Draft TAX INVOICE / DELIVERY ORDER / INVOICE</t>
                            </span>
                            <span t-elif="o.move_type == 'out_invoice' and o.state == 'cancel'">
                                <t t-if="lang == 'th_TH'" name="cancelled_invoice_title">ยกเลิก</t>
                                <t t-else="" name="cancelled_invoice_title">Cancelled Invoice</t>
                            </span>
                            <span t-elif="o.move_type == 'out_refund' and o.state == 'posted'">
                                <t t-if="lang == 'th_TH'" name="credit_note_title">ใบลดหนี้</t>
                                <t t-else="" name="credit_note_title">Credit Note</t>
                            </span>
                            <span t-elif="o.move_type == 'out_refund' and o.state == 'draft'">
                                <t t-if="lang == 'th_TH'" name="draft_credit_note_title">ใบลดหนี้ (ฉบับร่าง)</t>
                                <t t-else="" name="draft_credit_note_title">Draft Credit Note</t>
                            </span>
                            <span t-elif="o.move_type == 'out_refund' and o.state == 'cancel'">
                                <t t-if="lang == 'th_TH'" name="cancelled_credit_note_title">ยกเลิกใบลดหนี้</t>
                                <t t-else="" name="cancelled_credit_note_title">Cancelled Credit Note</t>
                            </span>
                            <span t-elif="o.move_type == 'in_refund' and not o.journal_id.is_self_billing">
                                <t t-if="lang == 'th_TH'" name="vendor_credit_note_title">ใบลดหนี้จากผู้ขาย</t>
                                <t t-else="" name="vendor_credit_note_title">Vendor Credit Note</t>
                            </span>
                            <span t-elif="o.move_type == 'in_refund' and o.journal_id.is_self_billing">
                                <t t-if="lang == 'th_TH'" name="self_billing_credit_note_title">ใบลดหนี้ (Self Billing)</t>
                                <t t-else="" name="self_billing_credit_note_title">Self Billing Credit Note</t>
                            </span>
                            <span t-elif="o.move_type == 'in_invoice' and not o.journal_id.is_self_billing">
                                <t t-if="lang == 'th_TH'" name="vendor_bill_title">ใบแจ้งหนี้จากผู้ขาย</t>
                                <t t-else="" name="vendor_bill_title">Vendor Bill</t>
                            </span>
                            <span t-elif="o.move_type == 'in_invoice' and o.journal_id.is_self_billing">
                                <t t-if="lang == 'th_TH'" name="self_billing_invoice_title">Self Billing</t>
                                <t t-else="" name="self_billing_invoice_title">Self Billing</t>
                            </span>
                        </t>
                        <t t-else="">
                            <span t-if="o.move_type == 'out_invoice' and o.state == 'posted'">
                                <t t-if="lang == 'th_TH'" name="proforma_invoice_title">ใบแจ้งหนี้ (Proforma)</t>
                                <t t-else="" name="proforma_invoice_title">Proforma Invoice</t>
                            </span>
                            <span t-elif="o.move_type == 'out_invoice' and o.state == 'draft'">
                                <t t-if="lang == 'th_TH'" name="draft_proforma_invoice_title">ใบแจ้งหนี้ (Proforma ฉบับร่าง)</t>
                                <t t-else="" name="draft_proforma_invoice_title">Draft Proforma Invoice</t>
                            </span>
                            <span t-elif="o.move_type == 'out_invoice' and o.state == 'cancel'">
                                <t t-if="lang == 'th_TH'" name="cancelled_proforma_invoice_title">ยกเลิก Proforma</t>
                                <t t-else="" name="cancelled_proforma_invoice_title">Cancelled Proforma Invoice</t>
                            </span>
                            <span t-elif="o.move_type == 'out_refund' and o.state == 'posted'">
                                <t t-if="lang == 'th_TH'" name="proforma_credit_note_title">Proforma ใบลดหนี้</t>
                                <t t-else="" name="proforma_credit_note_title">Proforma Credit Note</t>
                            </span>
                            <span t-elif="o.move_type == 'out_refund' and o.state == 'draft'">
                                <t t-if="lang == 'th_TH'" name="draft_proforma_credit_note_title">Proforma ใบลดหนี้ (ฉบับร่าง)</t>
                                <t t-else="" name="draft_proforma_credit_note_title">Draft Proforma Credit Note</t>
                            </span>
                            <span t-elif="o.move_type == 'out_refund' and o.state == 'cancel'">
                                <t t-if="lang == 'th_TH'" name="cancelled_proforma_credit_note_title">ยกเลิก Proforma ใบลดหนี้</t>
                                <t t-else="" name="cancelled_proforma_credit_note_title">Cancelled Proforma Credit Note</t>
                            </span>
                            <span t-elif="o.move_type == 'in_refund'">
                                <t t-if="lang == 'th_TH'" name="proforma_vendor_credit_note_title">Proforma ใบลดหนี้จากผู้ขาย</t>
                                <t t-else="" name="proforma_vendor_credit_note_title">Proforma Vendor Credit Note</t>
                            </span>
                            <span t-elif="o.move_type == 'in_invoice'">
                                <t t-if="lang == 'th_TH'" name="proforma_vendor_bill_title">Proforma ใบแจ้งหนี้จากผู้ขาย</t>
                                <t t-else="" name="proforma_vendor_bill_title">Proforma Vendor Bill</t>
                            </span>
                        </t>
                        <span t-if="o.name and o.name != '/'" t-field="o.name">INV/2026/0001</span>
                    </t>
                    <div class="oe_structure"></div>
                    <div
                        id="informations" class="row mb-4"
                        t-if="o.invoice_date or (o.invoice_date_due and o.move_type == 'out_invoice' and o.state == 'posted') or o.delivery_date or o.invoice_origin or o.partner_id.ref or o.ref or o.invoice_incoterm_id">
                        <div class="col" t-if="o.invoice_date" name="invoice_date">
                            <t t-if="o.move_type == 'out_invoice'"><strong>Invoice Date</strong></t>
                            <t t-elif="o.move_type == 'out_refund'"><strong>Credit Note Date</strong></t>
                            <t t-elif="o.move_type == 'out_receipt'"><strong>Receipt Date</strong></t>
                            <t t-else=""><strong>Date</strong></t>
                            <div t-field="o.invoice_date">2026-09-12</div>
                        </div>
                        <div class="col" t-if="o.invoice_date_due and o.move_type == 'out_invoice' and o.state == 'posted'" name="due_date">
                            <strong>Due Date</strong>
                            <div t-field="o.invoice_date_due">2026-10-31</div>
                        </div>
                        <div class="col" t-if="o.taxable_supply_date and o.show_taxable_supply_date" name="taxable_supply_date">
                            <strong>Taxable Supply</strong>
                            <div t-field="o.taxable_supply_date">2026-10-31</div>
                        </div>
                        <div class="col" t-if="o.delivery_date" name="delivery_date">
                            <strong>Delivery Date</strong>
                            <div t-field="o.delivery_date">2026-09-25</div>
                        </div>
                        <div class="col" t-if="o.invoice_origin" name="origin">
                            <strong>Source</strong>
                            <div t-field="o.invoice_origin">SO123</div>
                        </div>
                        <div class="col" t-if="o.partner_id.ref" name="customer_code">
                            <strong>Customer Code</strong>
                            <div t-field="o.partner_id.ref"/>
                        </div>
                        <div class="col" t-if="o.ref" name="reference">
                            <strong>Reference</strong>
                            <div t-field="o.ref">INV/2026/0001</div>
                        </div>
                        <div class="col" t-if="o.invoice_incoterm_id" name="incoterm_id">
                            <strong>Incoterm</strong>
                            <div t-if="o.incoterm_location">
                                <span t-field="o.invoice_incoterm_id.code"/> <br/>
                                <span t-field="o.incoterm_location"/>
                            </div>
                            <div t-else="" t-field="o.invoice_incoterm_id.code" class="m-0"/>
                        </div>
                    </div>

                    <t t-set="lines_to_report" t-value="o._get_move_lines_to_report()"/>
                    <t t-set="display_discount" t-value="any(l.discount for l in lines_to_report)"/>
                    <t t-set="display_taxes" t-value="any(l.tax_ids for l in o.invoice_line_ids)"/>
                    <div class="oe_structure"></div>
                    <t t-set="has_long_desc" t-value="any(line.name and line.name.count('\n') > 30 for line in o.invoice_line_ids if line.name)"/>
                    <table class="o_has_total_table table o_main_table table-borderless mb-0" name="invoice_line_table">
                        <thead t-attf-style="#{has_long_desc and 'display: table-row-group;' or ''}">
                            <tr class="fw-bold">
                                <th name="th_description" class="text-start"><span>Description</span></th>
                                <th name="th_quantity" class="text-end"><span>Quantity</span></th>
                                <th name="th_priceunit" t-attf-class="text-end text-nowrap {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}"><span>Unit Price</span></th>
                                <th name="th_discount" t-if="display_discount" t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                    <span>Disc.%</span>
                                </th>
                                <th name="th_taxes" t-if="display_taxes" t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}"><span>Taxes</span></th>
                                <th name="th_subtotal" class="text-end">
                                    <span>Amount</span>
                                </th>
                            </tr>
                        </thead>
                        <tbody class="invoice_tbody">
                            <t t-set="lines" t-value="o.invoice_line_ids.sorted(key=lambda l: (-l.sequence, l.date, l.move_name, -l.id), reverse=True)"/>
                            <t t-set="current_section" t-value="None"/>
                            <t t-set="current_subsection" t-value="None"/>

                            <t t-foreach="lines_to_report" t-as="line">
                                <t t-set="is_note" t-value="line.display_type == 'line_note'"/>
                                <t t-set="is_section" t-value="line.display_type == 'line_section'"/>
                                <t t-set="is_subsection" t-value="line.display_type == 'line_subsection'"/>
                                <t t-set="is_product" t-value="line.display_type == 'product'"/>

                                <t t-if="is_section">
                                    <t t-set="current_section" t-value="line"/>
                                    <t t-set="current_subsection" t-value="None"/>
                                    <t t-set="line_padding" t-value="0"/>
                                </t>
                                <t t-elif="is_subsection">
                                    <t t-set="current_subsection" t-value="line"/>
                                    <t t-set="line_padding" t-value="3"/>
                                </t>
                                <t t-else="">
                                    <t t-set="line_padding"
                                       t-value="4 if current_subsection else (3 if current_section else 0)"
                                    />
                                </t>
                                <t t-set="padding_class" t-value="line_padding and ('px-' + str(line_padding)) or ''"/>
                                <t t-set="hide_details" t-value="line.collapse_composition"/>
                                <t t-set="hide_prices" t-value="line.collapse_prices"/>

                                <t t-if="not hide_details and not hide_prices">
                                    <tr t-att-class="
                                        'fw-bolder o_line_section' if is_section else
                                        'fw-bold o_line_subsection' if is_subsection else
                                        'fst-italic o_line_note' if is_note
                                        else ''">
                                        <t t-set="line_colspan" t-value="3 + (1 if display_discount else 0) + (1 if display_taxes and not line.tax_ids else 0)"/>
                                        <t t-if="is_product" name="account_invoice_line_accountable">
                                            <td name="account_invoice_line_name" t-att-class="padding_class">
                                                <span t-if="line.name" t-field="line.name" t-options="{'widget': 'text'}" dir="auto">Product</span>
                                            </td>
                                            <td name="td_quantity" class="o_td_quantity text-end">
                                                <span t-field="line.quantity" class="text-nowrap">1.00</span>
                                                <span t-field="line.product_uom_id" groups="uom.group_uom">units</span>
                                                <span t-if="line.product_uom_id != line.product_id.uom_id" groups="uom.group_uom" class="text-muted small">
                                                    <br/>
                                                    <t t-set="product_uom_qty" t-value="line.product_uom_id._compute_quantity(line.quantity, line.product_id.uom_id)"/>
                                                    <span t-out="product_uom_qty" t-options="{'widget': 'float', 'decimal_precision': 'Product Unit'}"/> <span t-field="line.product_id.uom_id"/>
                                                </span>
                                            </td>
                                            <td name="td_price_unit" t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                                <span t-if="not hide_prices" class="text-nowrap" t-field="line.price_unit">100.00</span>
                                            </td>
                                            <td name="td_discount" t-if="display_discount" t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                                <span class="text-nowrap" t-field="line.discount">0</span>
                                            </td>
                                            <t t-set="taxes" t-value="', '.join(tax.tax_label for tax in line.tax_ids if tax.tax_label)"/>
                                            <td name="td_taxes" t-if="display_taxes" t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }} {{ 'text-nowrap' if len(taxes) &lt; 10 else '' }}">
                                                <span t-if="not hide_prices" t-out="taxes" id="line_tax_ids">Tax 7%</span>
                                            </td>
                                            <td name="td_subtotal" class="text-end o_price_total">
                                                <span t-if="not hide_prices and o.company_price_include == 'tax_excluded'" class="text-nowrap" t-field="line.price_subtotal">100.00</span>
                                                <span t-if="not hide_prices and o.company_price_include == 'tax_included'" class="text-nowrap" t-field="line.price_total">107.00</span>
                                            </td>
                                        </t>
                                        <t t-else="">
                                            <td name="account_invoice_line_name" t-att-colspan="line_colspan" t-att-class="padding_class">
                                                <span t-if="line.name" t-field="line.name" t-options="{'widget': 'text'}" dir="auto">Note</span>
                                            </td>
                                        </t>
                                    </tr>
                                </t>
                            </t>
                        </tbody>
                    </table>
                    <div class="overflow-hidden">
                        <div id="right-elements" t-attf-class="#{'col-5 mt-5' if report_type == 'pdf' else 'col-12 col-md-5'} ms-5 d-inline-block float-end">
                            <div id="total" class="clearfix row">
                                <div class="ms-auto">
                                    <table class="o_total_table table table-borderless avoid-page-break-inside">
                                        <t t-set="tt_rows" t-value="o._get_tax_invoice_totals()"/>
                                        <t t-set="currency" t-value="o.currency_id"/>
                                        <tr>
                                            <td>
                                                <t t-if="lang == 'th_TH'">รวมเงิน</t>
                                                <t t-else="">Total Amount</t>
                                            </td>
                                            <td class="text-end">
                                                <span t-out="tt_rows['gross_total']" t-options='{"widget": "monetary", "display_currency": currency}'/>
                                            </td>
                                        </tr>
                                        <tr t-if="tt_rows['discount']">
                                            <td>
                                                <t t-if="lang == 'th_TH'">ส่วนลด</t>
                                                <t t-else="">Discount</t>
                                            </td>
                                            <td class="text-end">
                                                <span t-out="tt_rows['discount']" t-options='{"widget": "monetary", "display_currency": currency}'/>
                                            </td>
                                        </tr>
                                        <tr t-if="tt_rows['discount']">
                                            <td>
                                                <t t-if="lang == 'th_TH'">มูลค่าสินค้าหลังหักส่วนลด</t>
                                                <t t-else="">Total After Discount</t>
                                            </td>
                                            <td class="text-end">
                                                <span t-out="tt_rows['net_total']" t-options='{"widget": "monetary", "display_currency": currency}'/>
                                            </td>
                                        </tr>
                                        <t t-foreach="tt_rows['vat_rows']" t-as="vrow">
                                            <tr>
                                                <td>
                                                    <t t-if="lang == 'th_TH'">ภาษีมูลค่าเพิ่ม <t t-out="vrow['rate_label']"/></t>
                                                    <t t-else="">VAT <t t-out="vrow['rate_label']"/></t>
                                                </td>
                                                <td class="text-end">
                                                    <span t-out="vrow['amount']" t-options='{"widget": "monetary", "display_currency": currency}'/>
                                                </td>
                                            </tr>
                                        </t>
                                        <t t-foreach="tt_rows['exempt_rows']" t-as="erow">
                                            <tr style="white-space: nowrap;">
                                                <td>
                                                    <t t-if="lang == 'th_TH'">ภาษีมูลค่าเพิ่ม: ( <t t-out="erow['label']"/> )</t>
                                                    <t t-else="">VAT: ( <t t-out="erow['label']"/> )</t>
                                                </td>
                                                <td class="text-end">
                                                    <span t-options='{"widget": "monetary", "display_currency": currency}' t-out="0.0"/>
                                                </td>
                                            </tr>
                                        </t>
                                        <tr class="o_total">
                                            <td><strong>
                                                <t t-if="lang == 'th_TH'">จำนวนรวมทั้งสิ้น</t>
                                                <t t-else="">Grand Total</t>
                                            </strong></td>
                                            <td class="text-end">
                                                <strong t-out="tt_rows['grand_total']" t-options='{"widget": "monetary", "display_currency": currency}'/>
                                            </td>
                                        </tr>
                                        <t t-if="print_with_payments">
                                            <t t-if="o.payment_state != 'invoicing_legacy'">
                                                <t t-set="payments_vals" t-value="o.sudo().invoice_payments_widget and o.sudo().invoice_payments_widget['content'] or []"/>
                                                <t t-foreach="payments_vals" t-as="payment_vals">
                                                    <tr t-if="payment_vals['is_exchange'] == 0">
                                                        <td>
                                                            <i class="oe_form_field text-end oe_payment_label">
                                                                <t t-if="payment_vals['is_refund']">Reversed on </t>
                                                                <t t-else="">Paid on </t>
                                                                <t t-out="payment_vals['date']" t-options='{"widget": "date"}'>2026-09-19</t>
                                                            </i>
                                                        </td>
                                                        <td class="text-end">
                                                            <span t-out="payment_vals['amount']" t-options='{"widget": "monetary", "display_currency": o.currency_id}'>100.00</span>
                                                        </td>
                                                    </tr>
                                                </t>
                                                <t t-if="len(payments_vals) > 0">
                                                    <tr class="fw-bold">
                                                        <td>Amount Due</td>
                                                        <td class="text-end">
                                                            <span t-field="o.amount_residual">0.00</span>
                                                        </td>
                                                    </tr>
                                                </t>
                                            </t>
                                        </t>
                                    </table>
                                </div>
                            </div>
                            <div class="mb-2">
                                <p class="text-end lh-sm" t-if="o.company_id.display_invoice_amount_total_words">
                                    Total amount in words: <br/>
                                    <span class="text-muted lh-sm" style="font-size: 0.875em;">(<span t-field="o.amount_total_words">One hundred Baht</span>)</span>
                                </p>
                            </div>
                            <t t-if="o.tax_totals and o.tax_totals.get('display_in_company_currency')">
                                <t t-set="tax_totals" t-value="o.tax_totals"/>
                                <t t-call="account.document_tax_totals_company_currency_template"/>
                            </t>
                            <t t-else="">
                                <div class="oe_structure"/>
                            </t>
                        </div>
                        <div id="payment_term" class="clearfix mt-3">
                            <div class="justify-text">
                                <p t-if="not is_html_empty(o.fiscal_position_id.note)" name="note" class="mb-2">
                                    <span t-field="o.fiscal_position_id.note"/>
                                </p>
                            </div>
                            <div class="justify-text">
                                <p t-if="not is_html_empty(o.taxes_legal_notes)" name="taxes_legal_notes" class="mb-2">
                                    <span t-field="o.taxes_legal_notes"/>
                                </p>
                            </div>
                            <t t-set="payment_term_details" t-value="o.payment_term_details"/>
                            <div class="mb-3">
                                <span id="payment_terms_note_id"
                                      t-if="o.invoice_payment_term_id.note"
                                      t-field="o.invoice_payment_term_id.note"
                                      name="payment_term">Payment within 30 calendar day</span><br/>
                                <t t-if="o.invoice_payment_term_id.display_on_invoice and payment_term_details">
                                    <div t-if='o.show_payment_term_details' id="total_payment_term_details_table" class="row">
                                        <div t-attf-class="#{'col-10' if report_type != 'html' else 'col-sm-10 col-md-9'}">
                                            <t t-if="o._is_eligible_for_early_payment_discount(o.currency_id,o.invoice_date)">
                                                <table class="d-none"><tbody><tr><td/></tr></tbody></table>
                                                <div id="early_payment_discount">
                                                    <span t-options='{"widget": "monetary", "display_currency": o.currency_id}'
                                                          t-out="o.invoice_payment_term_id._get_amount_due_after_discount(o.amount_total, o.amount_tax)">100.00</span> due if paid before
                                                    <span t-out="o.invoice_payment_term_id._get_last_discount_date_formatted(o.invoice_date)">2026-10-01</span>
                                                </div>
                                            </t>
                                            <t t-if="len(payment_term_details) > 1" t-foreach="payment_term_details" t-as="term">
                                                <div>
                                                    <span t-out="term_index + 1">1</span> - Installment of
                                                    <t t-options='{"widget": "monetary", "display_currency": o.currency_id}' t-out="term.get('amount')" class="text-end">100.00</t>
                                                    <span> due on </span>
                                                    <t t-out="term.get('date')" class="text-start">2026-10-01</t>
                                                </div>
                                            </t>
                                        </div>
                                    </div>
                                </t>
                            </div>
                            <div class="mb-3" t-if="o.move_type in ('out_invoice', 'in_refund') and o.payment_reference">
                                <p name="payment_communication">
                                    Payment Communication: <span class="fw-bold" t-field="o.payment_reference">INV/2026/0001</span>
                                    <t t-if="o.partner_bank_id">
                                        <br/> Wire transfer on this:
                                        <span class="fw-bold">
                                            <t t-if="o.partner_bank_id.bank_id">
                                                <t t-out="o.partner_bank_id.acc_number">204-3-30805-2</t> (<t t-out="o.partner_bank_id.bank_id.name">Kasikorn Bank</t>)
                                            </t>
                                            <t t-else="">
                                                <t t-out="o.partner_bank_id.acc_number">204-3-30805-2</t>
                                            </t>
                                        </span>
                                    </t>
                                </p>
                            </div>
                            <t t-set="show_qr" t-value="o.display_qr_code and o.amount_residual"/>
                            <div t-if="not show_qr" name="qr_code_placeholder" class="oe_structure"></div>
                            <div id="qrcode" class="d-flex mb-3 avoid-page-break-inside" t-else="">
                                <div class="qrcode me-3" id="qrcode_image">
                                    <t t-set="qr_code_url" t-value="o._generate_qr_code(silent_errors=True)"/>
                                    <p t-if="qr_code_url" class="position-relative mb-0">
                                        <img t-att-src="qr_code_url"/>
                                        <img src="/account/static/src/img/Odoo_logo_O.svg"
                                             id="qrcode_odoo_logo"
                                             class="top-50 start-50 position-absolute bg-white border border-3 rounded-circle"
                                        />
                                    </p>
                                </div>
                                <div class="d-inline text-muted lh-sm fst-italic" id="qrcode_info" t-if="qr_code_url">
                                    <p style="font-size: 0.875em;">Scan this PromptPay QR Code<br/>with your banking application</p>
                                </div>
                            </div>
                            <t t-set="show_link_qr" t-value="o.display_link_qr_code and o.amount_residual"/>
                            <div t-if="show_link_qr" id="payment_link_qrcode" class="d-flex mb-3 avoid-page-break-inside">
                                <t t-set="portal_qr_code" t-value="o._generate_portal_payment_qr()"/>
                                <div class="qrcode me-3 position-relative" id="qrcode_image">
                                    <a t-att-href="o._get_portal_payment_link()" target="_blank" class="top-0 start-0 position-absolute w-100 h-100 z-1" />
                                    <p class="position-relative mb-0">
                                        <img t-att-src="portal_qr_code"/>
                                        <img src="/account/static/src/img/Odoo_logo_O.svg"
                                             id="qrcode_odoo_logo"
                                             class="top-50 start-50 position-absolute bg-white border border-3 rounded-circle"
                                        />
                                    </p>
                                </div>
                                <div class="d-inline lh-sm" id="qrcode_info" t-if="portal_qr_code">
                                    <p class="fw-bold mb-0">PAY IN A FLASH!</p>
                                    <p class="text-muted fst-italic">Scan the QR code<br/>or click to pay online</p>
                                </div>
                            </div>
                            <div class="text-muted mb-3" t-attf-style="#{'text-align:justify;text-justify:inter-word;' if o.company_id.terms_type != 'html' else ''}" t-if="not is_html_empty(o.narration)" name="comment">
                                <span t-field="o.narration"/>
                            </div>
                            <div class="oe_structure"></div>
                        </div>
                    </div>

                    <!-- ── Signature blocks (VivaFarm specific) ── -->
                    <div style="width: 100%; margin-top: 6px; clear: both;">
                        <table style="width: 100%; table-layout: fixed; border-collapse: separate; border-spacing: 4px 0;">
                            <tr>
                                <td style="width: 40%; text-align: center; vertical-align: top; padding: 4px;">
                                    <div style="border: 1px solid #ccc; border-radius: 8px; padding: 6px;">
                                        <strong>
                                            <t t-if="lang == 'th_TH'">ลูกค้า/ผู้รับสินค้า</t>
                                            <t t-else="">Received by Customer</t>
                                        </strong><br/>
                                        <span style="font-size: 7px; display: block; margin-top: 2px;">
                                            <t t-if="lang == 'th_TH'">ข้าพเจ้าขอรับรองว่าได้รับสินค้าและ/หรือบริการตามรายการ<br/>ในเอกสารฉบับนี้ไว้ถูกต้องครบถ้วน</t>
                                            <t t-else="">I acknowledge receipt of the goods and/or services described in this document<br/> in accordance with the stated quantity and description.</t>
                                        </span>
                                        <div style="min-height: 40px;"></div>
                                        <div style="font-size: 9px; margin-top: 3px;">
                                            <div style="border-bottom: 2px solid #ccc; margin: 0 6px; padding: 1px 0; text-align: left;"><span style="white-space: nowrap;"><t t-if="lang == 'th_TH'">ชื่อ-นามสกุล</t><t t-else="">Name</t></span></div>
                                            <div style="border-bottom: 2px solid #ccc; margin: 0 6px; padding: 1px 0; text-align: left;"><span style="white-space: nowrap;"><t t-if="lang == 'th_TH'">ตำแหน่ง</t><t t-else="">Position</t></span></div>
                                            <div style="border-bottom: 2px solid #ccc; margin: 0 6px; padding: 1px 0; text-align: left;"><span style="white-space: nowrap;"><t t-if="lang == 'th_TH'">วันที่</t><t t-else="">Date</t></span></div>
                                        </div>
                                    </div>
                                </td>
                                <td style="width: 30%; text-align: center; vertical-align: top; padding: 4px;">
                                    <div style="border: 1px solid #ccc; border-radius: 8px; padding: 6px;">
                                        <strong>
                                            <t t-if="lang == 'th_TH'">ผู้ส่งมอบสินค้า</t>
                                            <t t-else="">Delivered by</t>
                                        </strong><br/>
                                        <span style="font-size: 7px; display: block; margin-top: 2px;">
                                            <t t-if="lang == 'th_TH'">ข้าพเจ้าขอรับรองว่าได้ส่งมอบสินค้าและ/หรือบริการตามรายการ<br/>ในเอกสารฉบับนี้เรียบร้อยแล้ว</t>
                                            <t t-else="">I certify that the goods and/or services described in this document<br/> have been delivered in accordance with the stated details.</t>
                                        </span>
                                        <div style="min-height: 40px;"></div>
                                        <div style="font-size: 9px; margin-top: 3px;">
                                            <div style="border-bottom: 2px solid #ccc; margin: 0 6px; padding: 1px 0; text-align: left;"><span style="white-space: nowrap;"><t t-if="lang == 'th_TH'">ชื่อ-นามสกุล</t><t t-else="">Name</t></span></div>
                                            <div style="border-bottom: 2px solid #ccc; margin: 0 6px; padding: 1px 0; text-align: left;"><span style="white-space: nowrap;"><t t-if="lang == 'th_TH'">ตำแหน่ง</t><t t-else="">Position</t></span></div>
                                            <div style="border-bottom: 2px solid #ccc; margin: 0 6px; padding: 1px 0; text-align: left;"><span style="white-space: nowrap;"><t t-if="lang == 'th_TH'">วันที่</t><t t-else="">Date</t></span></div>
                                        </div>
                                    </div>
                                </td>
                                <td style="width: 30%; text-align: center; vertical-align: top; padding: 4px;">
                                    <div style="border: 1px solid #ccc; border-radius: 8px; padding: 6px;">
                                        <strong>
                                            <t t-if="lang == 'th_TH'">ผู้มีอำนาจลงนาม</t>
                                            <t t-else="">Authorized Signatory</t>
                                        </strong><br/>
                                        <span style="font-size: 7px; display: block; margin-top: 2px;">
                                            <t t-if="lang == 'th_TH'">ข้าพเจ้าขอรับรองว่ารายการและรายละเอียดในเอกสารฉบับนี้ถูกต้อง<br/>และออกโดยผู้มีอำนาจของบริษัท</t>
                                            <t t-else="">I certify that the information contained in this document <br/>is true and correct and has been duly authorized by the Company.</t>
                                        </span>
                                        <div style="min-height: 40px;">
                                            <img t-if="o.company_id.l10n_th_signature_image"
                                                 t-att-src="'data:image/png;base64,%s' % o.company_id.l10n_th_signature_image.decode()"
                                                 style="max-height: 40px;"
                                                 alt="Authorized Signature"/>
                                        </div>
                                        <div style="font-size: 9px; margin-top: 3px;">
                                            <div style="border-bottom: 2px solid #ccc; margin: 0 6px; padding: 1px 0; text-align: left;"><span style="white-space: nowrap;"><t t-if="lang == 'th_TH'">ชื่อ-นามสกุล</t><t t-else="">Name</t></span></div>
                                            <div style="border-bottom: 2px solid #ccc; margin: 0 6px; padding: 1px 0; text-align: left;"><span style="white-space: nowrap;"><t t-if="lang == 'th_TH'">ตำแหน่ง</t><t t-else="">Position</t></span></div>
                                            <div style="border-bottom: 2px solid #ccc; margin: 0 6px; padding: 1px 0; text-align: left;"><span style="white-space: nowrap;"><t t-if="lang == 'th_TH'">วันที่</t><t t-else="">Date</t></span></div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- ── Wrapper: Viva Invoice ── -->
    <template id="viva_invoice"
              name="Tax Invoice">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="lang" t-value="o.partner_id.lang"/>
                <t t-foreach="o._get_tax_invoice_copies()" t-as="copy">
                    <t t-set="copy_kind" t-value="copy['key']"/>
                    <t t-call="vivafarm_report.viva_invoice_document" t-lang="lang"/>
                </t>
            </t>
        </t>
    </template>

    <!-- ── Report action ── -->
    <record id="report_viva_invoice" model="ir.actions.report">
        <field name="name">Tax Invoice</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">vivafarm_report.viva_invoice</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
        <field name="is_invoice_report" eval="True"/>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>
</odoo>
