<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        VivaFarm Quotation/SO (ใบเสนอราคา/สั่งซื้อ) — custom report.
        Works like the standard "Quotation / Order" (sale.report_saleorder)
        but renders with the TAX INVOICE layout (tall repeating letterhead,
        paperformat_viva_invoice 107mm).
        Legal basis: a quotation is a คำเสนอ (offer) under ป.พ.พ. มาตรา
        354-356; the customer's portal acceptance (คำสนอง) concludes the
        สัญญาซื้อขาย. The signed quotation is the written evidence under
        มาตรา 456 (sales ≥ ฿500). This report prints the same document for
        both states: "ใบเสนอราคา" (draft/sent) and "ใบสั่งซื้อ" (sale).
    -->

    <!-- ── Content: Viva Quotation/SO Document ── -->
    <template id="viva_quotation_so_document"
              name="VivaFarm Quotation/SO Document">
        <t t-call="vivafarm_report.external_layout_viva">
            <t t-set="is_tax_invoice" t-value="True"/>
            <t t-set="o" t-value="o.with_context(lang=lang)"/>
            <t t-set="forced_vat" t-value="o.fiscal_position_id.foreign_vat"/>

            <style>
                #qso_signature_block { page-break-inside: avoid; }
                /* Compact T&amp;C so the signature section fits on one page (TH + EN).
                   Stored narration uses inline font-size:10px — override with !important. */
                #terms_note h4 { margin-top: 4px !important; margin-bottom: 2px !important; font-size: 12px !important; font-weight: bold !important; }
                #terms_note ol { font-size: 12px !important; line-height: 1.2 !important; margin-bottom: 1px !important; padding-left: 17px !important; }
                #terms_note li { font-size: 12px !important; line-height: 1.2 !important; margin-bottom: 0 !important; }
            </style>

            <!-- Address/shipping data for the repeating header -->
            <t t-set="address">
                <div t-field="o.partner_id.name">Customer name</div>
                <div t-if="o.partner_id.street or o.partner_id.street2">
                    <span t-field="o.partner_id.street"/><t t-if="o.partner_id.street and o.partner_id.street2">, </t><span t-field="o.partner_id.street2"/>
                </div>
                <div t-if="o.partner_id.city or o.partner_id.state_id or o.partner_id.zip or o.partner_id.country_id">
                    <span t-field="o.partner_id.city"/><t t-if="o.partner_id.city and (o.partner_id.state_id or o.partner_id.zip)">, </t><span t-esc="o.partner_id._get_state_display(o.partner_id.state_id)"/><t t-if="o.partner_id.state_id and o.partner_id.zip"> </t><span t-field="o.partner_id.zip"/><t t-if="(o.partner_id.city or o.partner_id.state_id or o.partner_id.zip) and o.partner_id.country_id">, </t><span t-field="o.partner_id.country_id"/>
                </div>
                <div t-if="o.partner_id.vat">
                    <t t-if="o.company_id.account_fiscal_country_id.vat_label" t-out="o.company_id.account_fiscal_country_id.vat_label"/>
                    <t t-else="">Tax ID</t>: <span t-field="o.partner_id.vat"/><t t-if="o.partner_id.l10n_th_branch_name"> · <span t-esc="o.partner_id.l10n_th_branch_name"/></t>
                </div>
            </t>
            <t t-if="o.partner_shipping_id and (o.partner_shipping_id != o.partner_id)">
                <t t-set="information_block" groups="account.group_delivery_invoice_address">
                    <div name="shipping_address_block">
                        <strong class="d-block mt-1" style="font-size: 16px; font-weight: bold;">
                            <t t-if="lang == 'th_TH'">ที่อยู่จัดส่ง</t>
                            <t t-else="">Shipping Address</t>
                        </strong>
                        <div t-field="o.partner_shipping_id.name">Branch name</div>
                        <div t-if="o.partner_shipping_id.street or o.partner_shipping_id.street2">
                            <span t-field="o.partner_shipping_id.street"/><t t-if="o.partner_shipping_id.street and o.partner_shipping_id.street2">, </t><span t-field="o.partner_shipping_id.street2"/>
                        </div>
                        <div t-if="o.partner_shipping_id.city or o.partner_shipping_id.state_id or o.partner_shipping_id.zip or o.partner_shipping_id.country_id">
                            <span t-field="o.partner_shipping_id.city"/><t t-if="o.partner_shipping_id.city and (o.partner_shipping_id.state_id or o.partner_shipping_id.zip)">, </t><span t-esc="o.partner_shipping_id._get_state_display(o.partner_shipping_id.state_id)"/><t t-if="o.partner_shipping_id.state_id and o.partner_shipping_id.zip"> </t><span t-field="o.partner_shipping_id.zip"/><t t-if="(o.partner_shipping_id.city or o.partner_shipping_id.state_id or o.partner_shipping_id.zip) and o.partner_shipping_id.country_id">, </t><span t-field="o.partner_shipping_id.country_id"/>
                        </div>
                    </div>
                </t>
            </t>

            <div class="page">
                <!-- Title: state-aware, same as the standard Quotation/Order -->
                <t t-set="layout_document_title">
                    <span t-if="o.state in ['draft', 'sent']">
                        <t t-if="lang == 'th_TH'">ใบเสนอราคา: </t>
                        <t t-else="">Quotation: </t>
                    </span>
                    <span t-else="">
                        <t t-if="lang == 'th_TH'">ใบสั่งซื้อ: </t>
                        <t t-else="">Order: </t>
                    </span>
                    <span t-field="o.name">S00000</span>
                </t>

                <!-- Info rows: beige rounded bar (matches invoice #informations) -->
                <div id="informations"
                     t-att-style="'background-color: %s; border-radius: 8px; padding: 6px 10px; margin-bottom: 8px; page-break-inside: avoid;' % (o.company_id._get_light_tint(o.company_id.secondary_color))">
                    <div class="row" style="margin: 0;">
                        <div class="col-4" style="width: 33%; padding-right: 3px;">
                            <strong style="font-size: 12px;">
                                <t t-if="o.state in ['draft', 'sent']">
                                    <t t-if="lang == 'th_TH'">วันที่เสนอราคา</t>
                                    <t t-else="">Quotation Date</t>
                                </t>
                                <t t-else="">
                                    <t t-if="lang == 'th_TH'">วันที่สั่งซื้อ</t>
                                    <t t-else="">Order Date</t>
                                </t>
                            </strong>
                            <div style="font-size: 12px;">
                                <t t-if="lang == 'th_TH'"><span t-out="o._get_thai_date_display('date_order')">03/ส.ค./2569</span></t>
                                <t t-else=""><span t-field="o.date_order" t-options="{&quot;date_only&quot;: &quot;true&quot;}"/></t>
                            </div>
                        </div>
                        <div class="col-4" style="width: 33%; padding-right: 3px;">
                            <strong style="font-size: 12px;">
                                <t t-if="lang == 'th_TH'">วันหมดอายุ</t>
                                <t t-else="">Expiration</t>
                            </strong>
                            <div style="font-size: 12px;">
                                <t t-if="lang == 'th_TH'"><span t-out="o._get_thai_date_display('validity_date')">03/ส.ค./2569</span></t>
                                <t t-else=""><span t-field="o.validity_date" t-options="{&quot;date_only&quot;: &quot;true&quot;}"/></t>
                            </div>
                        </div>
                        <div class="col-4" style="width: 33%; padding-left: 3px;">
                            <strong style="font-size: 12px;">
                                <t t-if="lang == 'th_TH'">วันที่ส่งมอบ</t>
                                <t t-else="">Delivery Date</t>
                            </strong>
                            <div style="font-size: 12px;">
                                <t t-if="lang == 'th_TH'"><span t-out="o._get_thai_date_display('commitment_date')">03/ส.ค./2569</span></t>
                                <t t-else=""><span t-field="o.commitment_date" t-options="{&quot;date_only&quot;: &quot;true&quot;}"/></t>
                            </div>
                        </div>
                    </div>
                    <div class="row" style="margin: 0;">
                        <div class="col-4" style="width: 33%; padding-right: 3px;">
                            <strong style="font-size: 12px;">
                                <t t-if="lang == 'th_TH'">เลขที่อ้างอิงของท่าน</t>
                                <t t-else="">Your Reference</t>
                            </strong>
                            <div style="font-size: 12px;">
                                <span t-field="o.client_order_ref"/>
                            </div>
                        </div>
                        <div class="col-4" style="width: 33%; padding-right: 3px;">
                            <strong style="font-size: 12px;">
                                <t t-if="lang == 'th_TH'">เงื่อนไขการชำระเงิน</t>
                                <t t-else="">Payment Terms</t>
                            </strong>
                            <div style="font-size: 12px;">
                                <span t-field="o.payment_term_id"/>
                            </div>
                        </div>
                        <div class="col-4" style="width: 33%; padding-left: 3px;">
                            <strong style="font-size: 12px;">
                                <t t-if="lang == 'th_TH'">พนักงานขาย</t>
                                <t t-else="">Salesperson</t>
                            </strong>
                            <div style="font-size: 12px;">
                                <span t-field="o.user_id"/>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Line items -->
                <t t-set="lines_to_report" t-value="o._get_order_lines_to_report()"/>
                <t t-set="display_discount" t-value="any(l.discount > 0 for l in lines_to_report)"/>
                <t t-set="display_taxes" t-value="any(l._has_taxes() for l in lines_to_report)"/>
                <table class="table table-sm o_main_table table-borderless mb-2" style="table-layout: fixed;" name="so_line_table">
                    <thead>
                        <tr>
                            <th class="fw-bold text-center" style="width: 5%;">
                                <t t-if="lang == 'th_TH'">ลำดับ</t>
                                <t t-else="">NO.</t>
                            </th>
                            <th class="fw-bold text-start" style="width: 50%;">
                                <t t-if="lang == 'th_TH'">รายการ</t>
                                <t t-else="">Description</t>
                            </th>
                            <th class="fw-bold text-end" style="width: 10%;">
                                <t t-if="lang == 'th_TH'">จำนวน</t>
                                <t t-else="">Qty</t>
                            </th>
                            <th class="fw-bold text-end" style="width: 15%;">
                                <t t-if="lang == 'th_TH'">ราคาต่อหน่วย</t>
                                <t t-else="">Unit Price</t>
                            </th>
                            <th t-if="display_discount" class="fw-bold text-end" style="width: 10%;">
                                <t t-if="lang == 'th_TH'">ส่วนลด%</t>
                                <t t-else="">Disc.%</t>
                            </th>
                            <th t-if="display_taxes" class="fw-bold text-end" style="width: 10%;">
                                <t t-if="lang == 'th_TH'">ภาษี</t>
                                <t t-else="">Taxes</t>
                            </th>
                            <th class="fw-bold text-end" style="width: 20%;">
                                <t t-if="lang == 'th_TH'">จำนวนเงิน</t>
                                <t t-else="">Amount</t>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-set="line_no" t-value="0"/>
                        <t t-foreach="lines_to_report" t-as="line">
                            <t t-if="line.display_type == 'line_section' or line.display_type == 'line_note'">
                                <tr>
                                    <td t-att-colspan="7" class="fst-italic">
                                        <span t-field="line.name"/>
                                    </td>
                                </tr>
                            </t>
                            <t t-else="">
                                <t t-set="line_no" t-value="line_no + 1"/>
                                <tr>
                                    <td class="text-center">
                                        <span t-out="line_no"/>
                                    </td>
                                    <td>
                                        <span t-field="line.name"/>
                                    </td>
                                    <td class="text-end">
                                        <span t-field="line.product_uom_qty"/>
                                        <span t-field="line.product_uom_id.name" groups="uom.group_uom"/>
                                    </td>
                                    <td class="text-end">
                                        <span t-field="line.price_unit" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                    </td>
                                    <td t-if="display_discount" class="text-end">
                                        <span t-if="line.discount > 0" t-field="line.discount"/>
                                    </td>
                                    <td t-if="display_taxes" class="text-end">
                                        <t t-set="taxes" t-value="', '.join(tax.tax_label for tax in line.tax_ids if tax.tax_label)"/>
                                        <span t-out="taxes"/>
                                    </td>
                                    <td class="text-end">
                                        <span t-field="line.price_subtotal" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                    </td>
                                </tr>
                            </t>
                        </t>
                    </tbody>
                </table>

                <!-- Totals (right) — matches invoice #right-elements style -->
                <t t-set="words_text" t-value="o.currency_id.with_context(lang=lang).amount_to_text(o.amount_total)"/>
                <div class="row" style="margin: 0 0 8px 0;">
                    <div class="col-6"></div>
                    <div class="col-6">
                        <div id="right-elements" t-att-style="'border-top: 2px solid %s;' % (o.company_id.primary_color or '#000000')">
                            <div id="total" class="clearfix">
                                <div class="ms-auto">
                                    <table class="o_total_table table table-borderless avoid-page-break-inside">
                                        <tr>
                                            <td>
                                                <t t-if="lang == 'th_TH'">ยอดรวมก่อนภาษี</t>
                                                <t t-else="">Untaxed Amount</t>
                                            </td>
                                            <td class="text-end">
                                                <span t-field="o.amount_untaxed" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>
                                                <t t-if="lang == 'th_TH'">ภาษีมูลค่าเพิ่ม</t>
                                                <t t-else="">VAT</t>
                                            </td>
                                            <td class="text-end">
                                                <span t-field="o.amount_tax" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                                            </td>
                                        </tr>
                                        <tr class="fw-bold">
                                            <td>
                                                <t t-if="lang == 'th_TH'">จำนวนรวมทั้งสิ้น</t>
                                                <t t-else="">Grand Total</t>
                                            </td>
                                            <td class="text-end">
                                                <span t-field="o.amount_total" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                            <div class="mb-2" t-att-style="'border-bottom: 2px solid %s;' % (o.company_id.primary_color or '#000000')">
                                <p class="text-end lh-sm">
                                    <t t-if="lang == 'th_TH'">จำนวนเงินทั้งหมด (ตัวอักษร):</t>
                                    <t t-else="">Total amount in words:</t> <br/>
                                    <span class="text-muted lh-sm" style="font-size: 0.875em;">(<t t-esc="words_text"/>)</span>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Terms & Conditions (full width, above signatures — matches invoice) -->
                <div class="row" style="margin-top: 2px; clear: both;">
                    <div class="col-12" style="width: 100%;">
                        <div class="text-muted" id="terms_note"
                             t-attf-style="width: 100%; text-align:justify;text-justify:inter-word;"
                             t-if="o.note" name="comment">
                            <span t-field="o.note">1. Terms &amp; conditions</span>
                        </div>
                        <div t-if="not o.note" style="font-size: 10px; color: #666;">
                            <t t-if="lang == 'th_TH'">—</t>
                            <t t-else="">—</t>
                        </div>
                    </div>
                </div>

                <!-- Signature: acceptance line + TWO boxes (matches invoice) -->
                <div id="qso_signature_block" class="row" style="margin: 0; width: 100%; page-break-inside: avoid;">
                    <div style="page-break-inside: avoid;">
                        <div class="text-muted" style="font-size: 12px; font-weight: bold; margin-top: 0; margin-bottom: 1px; text-align: center; width: 100%;">
                            <t t-if="lang == 'th_TH'">การลงลายมือชื่อในช่องต่อไปนี้ ให้เป็นไปตามข้อกำหนดและเงื่อนไขของเอกสารฉบับนี้</t>
                            <t t-else="">Signatures below constitute acceptance in accordance with the Terms &amp; Conditions of this document.</t>
                        </div>
                        <div class="row" style="margin: 0; width: 100%;">
                            <div class="col-6" style="width: 50%; padding-right: 3px;">
                                <div style="page-break-inside: avoid;">
                                    <div style="border: 1px solid #ccc; border-radius: 8px; padding: 1px; text-align: center;">
                                        <strong>
                                            <t t-if="lang == 'th_TH'">ลูกค้า/ผู้รับสินค้า</t>
                                            <t t-else="">Received by Customer</t>
                                        </strong><br/>
                                        <div style="min-height: 50px; max-height: 50px;"></div>
                                        <div style="font-size: 14px; margin-top: 0;">
                                            <div style="border-bottom: 1px solid #ccc; margin: 0 4px; padding: 0; text-align: left;"><span style="white-space: nowrap;"><t t-if="lang == 'th_TH'">ชื่อ-นามสกุล</t><t t-else="">Name</t></span></div>
                                            <div style="border-bottom: 1px solid #ccc; margin: 0 4px; padding: 0; text-align: left;"><span style="white-space: nowrap;"><t t-if="lang == 'th_TH'">ตำแหน่ง</t><t t-else="">Position</t></span></div>
                                            <div style="border-bottom: 1px solid #ccc; margin: 0 4px; padding: 0; text-align: left;"><span style="white-space: nowrap;"><t t-if="lang == 'th_TH'">วันที่</t><t t-else="">Date</t></span></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-6" style="width: 50%; padding-left: 3px;">
                                <div style="page-break-inside: avoid;">
                                    <div style="border: 1px solid #ccc; border-radius: 8px; padding: 1px; text-align: center;">
                                        <strong>
                                            <t t-if="lang == 'th_TH'">ผู้มีอำนาจลงนาม</t>
                                            <t t-else="">Authorized Signatory</t>
                                        </strong><br/>
                                        <div style="min-height: 50px; max-height: 50px;">
                                            <img t-if="o.company_id.l10n_th_signature_image"
                                                 t-att-src="'data:image/png;base64,%s' % o.company_id.l10n_th_signature_image.decode()"
                                                 style="max-height: 50px;"
                                                 alt="Authorized Signature"/>
                                        </div>
                                        <div style="font-size: 14px; margin-top: 0;">
                                            <div style="border-bottom: 1px solid #ccc; margin: 0 4px; padding: 0; text-align: left;"><span style="white-space: nowrap;"><t t-if="lang == 'th_TH'">ชื่อ-นามสกุล</t><t t-else="">Name</t></span></div>
                                            <div style="border-bottom: 1px solid #ccc; margin: 0 4px; padding: 0; text-align: left;"><span style="white-space: nowrap;"><t t-if="lang == 'th_TH'">ตำแหน่ง</t><t t-else="">Position</t></span></div>
                                            <div style="border-bottom: 1px solid #ccc; margin: 0 4px; padding: 0; text-align: left;"><span style="white-space: nowrap;"><t t-if="lang == 'th_TH'">วันที่</t><t t-else="">Date</t></span></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- ── Wrapper: Viva Quotation/SO ── -->
    <template id="viva_quotation_so"
              name="VivaFarm Quotation/SO">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="lang" t-value="o.partner_id.lang or o.company_id.partner_id.lang"/>
                <t t-call="vivafarm_report.viva_quotation_so_document" t-lang="lang"/>
            </t>
        </t>
    </template>

    <!-- ── Report action ── -->
    <record id="action_report_viva_quotation_so" model="ir.actions.report">
        <field name="name">Quotation/SO (ใบเสนอราคา/สั่งซื้อ)</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">vivafarm_report.viva_quotation_so</field>
        <field name="report_file">vivafarm_report.viva_quotation_so</field>
        <field name="print_report_name">(object.state in ('draft', 'sent') and 'Quotation - %s' % (object.name)) or 'Order - %s' % (object.name)</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="vivafarm_report.paperformat_viva_invoice"/>
    </record>
</odoo>
