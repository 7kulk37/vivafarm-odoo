<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_reissue_warning_form" model="ir.ui.view">
        <field name="name">reissue.warning.form</field>
        <field name="model">reissue.warning</field>
        <field name="arch" type="xml">
            <form string="Re-issue Confirmation">
                <div class="alert alert-warning" role="alert">
                    <strong>Re-issue <field name="move_id"/>?</strong>
                    <br/>
                    This will create a <strong>new</strong> invoice with a
                    <strong>new number</strong>. The original keeps its
                    number and stays voided (ป.86/2542 ข้อ 25).
                    <br/><br/>
                    <strong>Note:</strong> this invoice has already been
                    <strong>re-issued <field name="reissue_count"/> time(s)</strong> in this
                    chain. Repeated re-issues usually mean a mistake was
                    corrected on paper instead of fixed.
                </div>
                <footer>
                    <button name="action_confirm" string="Re-issue anyway" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
