<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_vivafarm_tax_invoice_button" model="ir.ui.view">
        <field name="name">account.move.form.vivafarm.tax.invoice.button</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Add Tax Invoice button between Print and Pay -->
            <button name="action_register_payment" id="account_invoice_payment_btn"
                    position="before">
                <button name="%(vivafarm_report.report_viva_invoice)d"
                        type="action"
                        string="Tax Invoice"
                        class="oe_highlight"
                        invisible="state != 'posted' or move_type not in ('out_invoice', 'out_refund')"/>
            </button>
            <!-- Replaces Invoice (ป.86/2542 ข้อ 25): set on the re-issued
                 invoice to print the replacement note on the tax invoice. -->
            <field name="payment_reference" position="after">
                <field name="replacement_of_id"
                       placeholder="Replaces Invoice (ข้อ 25)"
                       options="{'no_create': True}"
                       invisible="move_type not in ('out_invoice',)"/>
            </field>
            <!-- Re-issue (ป.86/2542 ข้อ 25): the compliant alternative to
                 Reset to Draft on a posted-then-cancelled customer invoice.
                 Reset to Draft reuses the same number on re-post (forbidden
                 by ข้อ 25(2)); this button copies + re-dates + links via
                 replacement_of_id so the replacement gets a NEW number and
                 prints the 'ออกแทนใบกำกับภาษีฉบับเดิมเลขที่ ...' note.
                 Visible exactly when Reset to Draft is hidden for cancelled
                 customer invoices. -->
            <button name="button_draft" position="after">
                <button name="button_reissue"
                        string="Re-issue"
                        type="object"
                        groups="account.group_account_invoice"
                        class="btn-primary"
                        invisible="move_type != 'out_invoice' or state != 'cancel' or not posted_before"/>
            </button>
            <!-- Stat button: how many times this invoice chain has been
                 re-issued (mistake counter). Opens the full chain list. -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_reissue_chain"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-repeat"
                        help="All invoices in this re-issue chain (original + replacements). Click to open the full history."
                        invisible="move_type != 'out_invoice' or not reissue_count">
                    <div class="o_stat_info">
                        <field name="reissue_count" widget="statinfo" string="Re-issued"/>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

    <!-- Policy: all price/discount controlled on pricelist — no per-line
         discounts on invoices. Hide the Disc.% column in the invoice line
         list and the mobile line form. Two xpaths because Odoo's
         inheritance applies attributes to the first xpath match only. -->
    <record id="view_move_form_vivafarm_hide_discount" model="ir.ui.view">
        <field name="name">account.move.form.vivafarm.hide.discount</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//list[@name='journal_items']/field[@name='discount']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/form//field[@name='discount']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
