<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_vivafarm_tax_invoice_button" model="ir.ui.view">
        <field name="name">account.move.form.vivafarm.tax.invoice.button</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Add Tax Invoice button between Print and Pay -->
            <button name="action_register_payment" id="account_invoice_payment_btn"
                    position="before">
                <button name="%(vivafarm_report.report_viva_invoice)d"
                        type="action"
                        string="Tax Invoice"
                        class="oe_highlight"
                        invisible="state != 'posted' or move_type not in ('out_invoice', 'out_refund')"/>
            </button>
        </field>
    </record>
</odoo>
