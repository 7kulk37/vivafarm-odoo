<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        VivaFarm Withholding Tax Certificate (หนังสือรับรองการหักภาษี ณ ที่จ่าย
        ตามมาตรา 50 ทวิ แห่งประมวลรัษฎากร) — custom report bound to account.move
        (vendor bills with WHT lines). Content-conformant per ประกาศอธิบดีฯ
        ฉบับที่ 62 ข้อ 2: sequential number, TWO copies (ฉบับที่ 1 = attach to
        the PND return, ฉบับที่ 2 = payee keeps), income type per row,
        net-paid line. Both copies on one A4 (top/bottom half).
    -->

    <!-- ── Content: Viva WHT Certificate Document (single copy block) ── -->
    <template id="viva_wht_certificate_document"
              name="VivaFarm WHT Certificate Document">
        <t t-call="vivafarm_report.external_layout_viva">
            <t t-set="is_wht_certificate" t-value="True"/>
            <t t-set="o" t-value="o.with_context(lang=lang)"/>
            <t t-set="copy_label" t-value="copy_label or ''"/>

            <div class="page">
                <div style="font-size: 12px; margin-bottom: 2px;">
                    <strong t-esc="copy_label"/>
                    <t t-if="reprint">
                        <strong style="color: #b00; margin-left: 12px;">(ใบแทน / REISSUED COPY)</strong>
                    </t>
                </div>
                <h3 t-att-style="'margin-top: 0; margin-bottom: 2px; text-align: left; color: %s;' % (o.company_id.primary_color or '#000000')">
                    <strong style="font-size: 20px;">
                        <t t-if="lang == 'th_TH'">หนังสือรับรองการหักภาษี ณ ที่จ่าย ตามมาตรา 50 ทวิ แห่งประมวลรัษฎากร</t>
                        <t t-else="">Withholding Tax Certificate (Section 50 bis, Revenue Code)</t>
                    </strong>
                </h3>
                <div style="font-size: 12px; margin-bottom: 6px;">
                    <t t-if="lang == 'th_TH'">เลขที่หนังสือรับรอง: <strong t-esc="cert_number or '-'" /></t>
                    <t t-else="">Certificate No.: <strong t-esc="cert_number or '-'" /></t>
                </div>

                <!-- Payer / Payee blocks -->
                <div class="row" style="margin: 0 0 8px 0;">
                    <div class="col-6" style="width: 50%; padding-right: 3px;">
                        <strong style="font-size: 14px;">
                            <t t-if="lang == 'th_TH'">ผู้จ่ายเงิน</t>
                            <t t-else="">Payer</t>
                        </strong>
                        <div style="font-size: 13px; line-height: 1.3;">
                            <div t-field="o.company_id.name"/>
                            <div t-if="o.company_id.street or o.company_id.street2">
                                <span t-field="o.company_id.street"/><t t-if="o.company_id.street and o.company_id.street2">, </t><span t-field="o.company_id.street2"/>
                            </div>
                            <div t-if="o.company_id.vat">
                                <t t-if="lang == 'th_TH'">เลขประจำตัวผู้เสียภาษี: </t>
                                <t t-else="">Tax ID: </t>
                                <span t-field="o.company_id.vat"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-6" style="width: 50%; padding-left: 3px;">
                        <strong style="font-size: 14px;">
                            <t t-if="lang == 'th_TH'">ผู้ถูกหักภาษี</t>
                            <t t-else="">Payee</t>
                        </strong>
                        <div style="font-size: 13px; line-height: 1.3;">
                            <div t-field="o.partner_id.name"/>
                            <div t-if="o.partner_id.street or o.partner_id.street2">
                                <span t-field="o.partner_id.street"/><t t-if="o.partner_id.street and o.partner_id.street2">, </t><span t-field="o.partner_id.street2"/>
                            </div>
                            <div t-if="o.partner_id.vat">
                                <t t-if="lang == 'th_TH'">เลขประจำตัวผู้เสียภาษี: </t>
                                <t t-else="">Tax ID: </t>
                                <span t-field="o.partner_id.vat"/>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Info row: bill no + date -->
                <div class="row" style="margin: 0 0 8px 0;">
                    <div class="col-6" style="width: 50%; padding-right: 3px;">
                        <strong style="font-size: 12px;">
                            <t t-if="lang == 'th_TH'">ออกหนังสือรับรองฉบับนี้ ณ วันที่</t>
                            <t t-else="">Issued on</t>
                        </strong>
                        <div style="font-size: 12px;">
                            <span t-esc="payment_date_th or payment_date or ''"/>
                        </div>
                    </div>
                    <div class="col-6" style="width: 50%; padding-left: 3px;">
                        <strong style="font-size: 12px;">
                            <t t-if="lang == 'th_TH'">เอกสารอ้างอิง</t>
                            <t t-else="">Reference</t>
                        </strong>
                        <div style="font-size: 12px;"><span t-field="o.name"/></div>
                    </div>
                </div>

                <!-- WHT line table (income type per row — one row per WHT tax) -->
                <table class="table table-sm table-bordered" style="margin-top: 4px;">
                    <thead>
                        <tr>
                            <th class="text-center" style="width: 6%;">
                                <t t-if="lang == 'th_TH'">ลำดับ</t>
                                <t t-else="">No.</t>
                            </th>
                            <th style="width: 24%;">
                                <t t-if="lang == 'th_TH'">ประเภทเงินได้ (จ่ายเป็นค่า)</t>
                                <t t-else="">Income Type</t>
                            </th>
                            <th style="width: 22%;">
                                <t t-if="lang == 'th_TH'">วันที่จ่าย</t>
                                <t t-else="">Date Paid</t>
                            </th>
                            <th class="text-end" style="width: 16%;">
                                <t t-if="lang == 'th_TH'">จำนวนเงินที่จ่าย</t>
                                <t t-else="">Amount Paid</t>
                            </th>
                            <th class="text-center" style="width: 10%;">
                                <t t-if="lang == 'th_TH'">อัตรา %</t>
                                <t t-else="">Rate %</t>
                            </th>
                            <th class="text-end" style="width: 16%;">
                                <t t-if="lang == 'th_TH'">ภาษีที่หัก</t>
                                <t t-else="">Tax Withheld</t>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="rows" t-as="wht">
                            <tr>
                                <td class="text-center"><t t-esc="wht_index + 1"/></td>
                                <td>
                                    <span t-esc="wht['income_type_label_th'] if lang == 'th_TH' else wht['income_type_label']"/>
                                    <span t-esc="wht['tax']"/>
                                </td>
                                <td><span t-esc="payment_date_th if lang == 'th_TH' else payment_date"/></td>
                                <td class="text-end"><span t-esc="wht['base_fmt']"/></td>
                                <td class="text-center"><t t-esc="'%g' % wht['rate']"/></td>
                                <td class="text-end"><span t-esc="wht['wht_fmt']"/></td>
                            </tr>
                        </t>
                    </tbody>
                    <tfoot>
                        <tr class="fw-bold">
                            <td colspan="3" class="text-end">
                                <t t-if="lang == 'th_TH'">รวม</t>
                                <t t-else="">Total</t>
                            </td>
                            <td class="text-end"><span t-esc="total_base"/></td>
                            <td/>
                            <td class="text-end"><span t-esc="total_wht"/></td>
                        </tr>
                        <tr class="fw-bold">
                            <td colspan="3" class="text-end">
                                <t t-if="lang == 'th_TH'">จำนวนเงินสุทธิที่จ่ายให้ผู้ถูกหักภาษี</t>
                                <t t-else="">Net amount paid to payee</t>
                            </td>
                            <td class="text-end" colspan="3"><span t-esc="total_net"/></td>
                        </tr>
                    </tfoot>
                </table>

                <!-- Signature blocks -->
                <div class="row" style="margin: 12px 0 0 0;">
                    <div class="col-6" style="width: 50%; padding-right: 3px;">
                        <div style="font-size: 12px; line-height: 1.4;">
                            <div>
                                <t t-if="lang == 'th_TH'">ลงชื่อ .................................................. ผู้จ่ายเงิน</t>
                                <t t-else="">Signature .................................................. Payer</t>
                            </div>
                            <div style="margin-top: 2px;">
                                <t t-if="lang == 'th_TH'">( .................................................. )</t>
                                <t t-else="">( .................................................. )</t>
                            </div>
                            <div style="margin-top: 2px;">
                                <t t-if="lang == 'th_TH'">ประทับตรา (ถ้ามี)</t>
                                <t t-else="">Company seal (if any)</t>
                            </div>
                        </div>
                    </div>
                    <div class="col-6" style="width: 50%; padding-left: 3px;">
                        <div style="font-size: 13px; line-height: 1.4;">
                            <div>
                                <t t-if="lang == 'th_TH'">ได้รับหนังสือรับรองและเงินสุทธิแล้ว</t>
                                <t t-else="">Received the certificate and net payment</t>
                            </div>
                            <div>
                                <t t-if="lang == 'th_TH'">ลงชื่อ .................................................. ผู้รับ</t>
                                <t t-else="">Signature .................................................. Recipient</t>
                            </div>
                            <div style="margin-top: 2px;">
                                <t t-if="lang == 'th_TH'">( .................................................. )</t>
                                <t t-else="">( .................................................. )</t>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- ── Wrapper: ONE A4, two copies stacked top/bottom (ฉบับที่ 62 ข้อ 2) ── -->
    <template id="report_viva_wht_certificate"
              name="VivaFarm Withholding Tax Certificate">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <!-- Statutory Thai form: always render Thai regardless of
                     partner lang (ประกาศฉบับที่ 62 ข้อ 3 allows Thai) -->
                <t t-set="lang" t-value="'th_TH'"/>
                <div style="page-break-after: always;">
                    <t t-set="copy_label" t-value="(lang == 'th_TH' and 'ฉบับที่ 1 (สำหรับผู้ถูกหักภาษี ณ ที่จ่าย ใช้แนบพร้อมกับแบบแสดงรายการภาษี)' or 'Copy 1 (for the withholding payee, to attach to the tax return)')"/>
                    <div style="border-bottom: 1px dashed #999; padding-bottom: 6px; margin-bottom: 6px;">
                        <t t-call="vivafarm_report.viva_wht_certificate_document"/>
                    </div>
                    <t t-set="copy_label" t-value="(lang == 'th_TH' and 'ฉบับที่ 2 (สำหรับผู้ถูกหักภาษี ณ ที่จ่าย เก็บไว้เป็นหลักฐาน)' or 'Copy 2 (for the withholding payee to keep as evidence)')"/>
                    <t t-call="vivafarm_report.viva_wht_certificate_document"/>
                </div>
            </t>
        </t>
    </template>

    <!-- ── Report action ── -->
    <record id="action_report_wht_certificate" model="ir.actions.report">
        <field name="name">WHT Certificate (หนังสือรับรองภาษีหัก ณ ที่จ่าย)</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">vivafarm_report.report_viva_wht_certificate</field>
        <field name="report_file">vivafarm_report.report_viva_wht_certificate</field>
        <!-- Standard compact header (company default 52mm). -->
        <field name="paperformat_id" ref="paperformat_viva_standard"/>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="print_report_name">'WHT_Cert_%s' % (object.name)</field>
    </record>
</odoo>