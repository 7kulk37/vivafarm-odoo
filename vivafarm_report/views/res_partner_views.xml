<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- VS-01: per-vendor WHT income-type + default tax on the partner form
         (Sales &amp; Purchase page, Purchase group). -->
    <record id="view_res_partner_form_vivafarm_wht" model="ir.ui.view">
        <field name="name">res.partner.form.vivafarm.wht</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales_purchases']//group[@name='purchase']" position="inside">
                <field name="viva_income_type"
                       string="Income Type (WHT)"
                       help="Thai withholding-tax classification. Auto-suggests the WHT tax on vendor bill lines. Goods = no WHT; rent 5%; transport 1%; service 3%; advertising 2%."/>
                <field name="viva_default_wht_tax_id" readonly="1" string="Default WHT Tax"/>
                <field name="viva_non_resident" readonly="1"
                       help="Informational: non-resident vendors are subject to 5%/15% WHT with PND 54 (ภ.ง.ด.54), not PND 3/53 (VS-16)."/>
            </xpath>
        </field>
    </record>
</odoo>
