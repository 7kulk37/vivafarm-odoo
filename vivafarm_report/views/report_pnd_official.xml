<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        S14: OFFICIAL-FORM PND pack — the rd.go.th official form (พิมพ์ มี.ค. 2560,
        AcroForm version) rasterized at 300dpi as the page background, our data
        absolutely positioned over it at the official field rects (models/
        rd_form_layout.py, pt→mm ×25.4/72).

        Hand-fill after printing (not auto-filled in V1): granular address boxes,
        ยื่นเพิ่มเติมครั้งที่, เลขที่หนังสือ, สรรพากรพื้นที่, seal.
    -->

    <!-- Shared: the data overlay boxes -->
    <template id="pnd_official_boxes">
        <t t-foreach="boxes" t-as="b">
            <div t-att-style="b['style']">
                <t t-if="b.get('tick')">
                    <span t-esc="b['text']"/>
                </t>
                <t t-else="">
                    <span t-esc="b['text']"/>
                </t>
            </div>
        </t>
    </template>

    <template id="report_pnd_official" name="PND Official Form Pack (bg + overlay)">
        <t t-call="web.html_container">
            <style>
                /* full-page gov form: kill body padding/margins AND scrollbars —
                   a 0.5px vertical overflow reserves a 16px scrollbar and shifts
                   the whole page +12pt right (crop on the right edge) */
                body.container { padding: 0 !important; margin: 0 !important; }
                html, body { overflow: hidden !important; height: auto !important; }
                /* Odoo pads every report body 11mm left/right (.o_body_html) —
                   kills it so the full-page form sits at 0,0 on the paper */
                body.o_body_html { padding: 0 !important; }
            </style>
            <t t-foreach="docs" t-as="w">
                <div class="article o_company_1_layout" data-oe-lang="th_TH"
                     style="position: relative; width: 794px; height: 1122px; overflow: hidden; font-family: NotoSansThai, Lato, sans-serif;">
                    <!-- official form as full-page background -->
                    <img src="/vivafarm_report/static/src/forms/pnd3_cover_bg.png"
                         style="position: absolute; left: 0; top: 0; width: 794px; height: 1122px;"/>
                    <t t-call="vivafarm_report.pnd_official_boxes"/>
                </div>
            </t>
        </t>
    </template>

    <template id="report_pnd_official53" name="PND53 Official Form Pack">
        <t t-call="web.html_container">
            <style>
                body.container { padding: 0 !important; margin: 0 !important; }
                html, body { overflow: hidden !important; height: auto !important; }
                /* Odoo pads every report body 11mm left/right (.o_body_html) —
                   kills it so the full-page form sits at 0,0 on the paper */
                body.o_body_html { padding: 0 !important; }
            </style>
            <t t-foreach="docs" t-as="w">
                <div class="article o_company_1_layout" data-oe-lang="th_TH"
                     style="position: relative; width: 794px; height: 1122px; overflow: hidden; font-family: NotoSansThai, Lato, sans-serif;">
                    <img src="/vivafarm_report/static/src/forms/pnd53_cover_bg.png"
                         style="position: absolute; left: 0; top: 0; width: 794px; height: 1122px;"/>
                    <t t-call="vivafarm_report.pnd_official_boxes"/>
                </div>
            </t>
        </t>
    </template>

    <!-- full-page format: the official form IS the page — zero margins, no header -->
    <record id="paperformat_viva_fullpage" model="report.paperformat">
        <field name="name">VivaFarm Full-Page A4 (official forms)</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">96</field>
        <!-- critical: wkhtmltopdf smart-shrinking rescales our 794px article to
             ~76% (measured 0.757) — kill it so the form fills the page -->
        <field name="disable_shrinking" eval="True"/>
    </record>

    <record id="action_report_pnd_official" model="ir.actions.report">
        <field name="name">Thai PND3 Official Form (แบบราชการ + ข้อมูล)</field>
        <field name="model">tax.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">vivafarm_report.report_pnd_official</field>
        <field name="report_file">vivafarm_report.report_pnd_official</field>
        <field name="paperformat_id" ref="paperformat_viva_fullpage"/>
        <field name="print_report_name">'PND3_Official_%s' % (object.date_from)</field>
    </record>

    <record id="action_report_pnd_official53" model="ir.actions.report">
        <field name="name">Thai PND53 Official Form (แบบราชการ + ข้อมูล)</field>
        <field name="model">tax.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">vivafarm_report.report_pnd_official53</field>
        <field name="report_file">vivafarm_report.report_pnd_official53</field>
        <field name="paperformat_id" ref="paperformat_viva_fullpage"/>
        <field name="print_report_name">'PND53_Official_%s' % (object.date_from)</field>
    </record>

    <record id="paperformat_viva_fullpage_landscape" model="report.paperformat">
        <field name="name">VivaFarm Full-Page A4 Landscape (official forms)</field>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">96</field>
        <field name="disable_shrinking" eval="True"/>
    </record>

    <template id="report_pnd_official_attach"
              name="Official ใบแนบ ภ.ง.ด.3 (landscape bg + overlay)">
        <t t-call="web.html_container">
            <style>
                body.container { padding: 0 !important; margin: 0 !important; }
                html, body { overflow: hidden !important; height: auto !important; }
                body.o_body_html { padding: 0 !important; }
            </style>
            <t t-foreach="pages" t-as="pg">
                <div class="article o_company_1_layout" data-oe-lang="th_TH"
                     style="position: relative; width: 1122px; height: 793px; overflow: hidden; font-family: NotoSansThai, Lato, sans-serif;">
                    <img t-att-src="pg['bg']"
                         style="position: absolute; left: 0; top: 0; width: 1122px; height: 793px;"/>
                    <t t-foreach="pg['boxes']" t-as="b">
                        <div t-att-style="b['style']"><span t-esc="b['text']"/></div>
                    </t>
                </div>
            </t>
        </t>
    </template>

    <record id="action_report_pnd_official_attach" model="ir.actions.report">
        <field name="name">Thai ใบแนบ ภ.ง.ด.3 Official (แบบราชการ)</field>
        <field name="model">tax.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">vivafarm_report.report_pnd_official_attach</field>
        <field name="report_file">vivafarm_report.report_pnd_official_attach</field>
        <field name="paperformat_id" ref="paperformat_viva_fullpage_landscape"/>
        <field name="print_report_name">'PND3_Attach_Official_%s' % (object.date_from)</field>
    </record>
</odoo>