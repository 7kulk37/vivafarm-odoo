<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_inherit_vivafarm_report" model="ir.ui.view">
        <field name="name">res.company.form.inherit.vivafarm.report</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Thai Tax Invoice" name="vivafarm_thai_invoice">
                    <group>
                        <group>
                            <field name="l10n_th_branch_number" placeholder="00000"/>
                            <field name="l10n_th_branch_name" placeholder="Leave empty for head office"/>
                        </group>
                        <group>
                            <field name="l10n_th_signature_image" widget="image"/>
                            <field name="l10n_th_signatory_name"/>
                            <field name="l10n_th_signatory_position"/>
                        </group>
                    </group>
                </page>
                <page string="VAT &amp; WHT Monitor" name="vivafarm_vat_wht_monitor">
                    <group>
                        <group>
                            <field name="viva_vat_registered"/>
                            <field name="viva_vat_registered_since"/>
                            <field name="viva_turnover_12m" readonly="1"/>
                            <field name="viva_turnover_1_8m" readonly="1"/>
                        </group>
                        <group>
                            <field name="viva_pp36_note"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
