<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_inherit_vivafarm_report" model="ir.ui.view">
        <field name="name">res.company.form.inherit.vivafarm.report</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Thai Tax Invoice" name="vivafarm_thai_invoice">
                    <group>
                        <group>
                            <field name="l10n_th_branch_number" placeholder="00000"/>
                            <field name="l10n_th_branch_name" placeholder="Leave empty for head office"/>
                        </group>
                        <group>
                            <field name="l10n_th_signature_image" widget="image"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
