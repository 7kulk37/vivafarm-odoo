<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        VivaFarm Credit Note (ใบลดหนี้) — custom report.
        Same approach as the Tax Receipt: wrapper → layout → content, all in
        this module. 3 copies (ต้นฉบับ/สำหรับลูกค้า + สำเนา/สำหรับบริษัท +
        สำเนา/สำหรับบัญชี) per Thai practice (มาตรา 86/10). Standard Viva
        header, title in the body. The reason (เหตุผล) gets a dedicated
        full-width block in the body where it can wrap freely — no
        fixed-height header constraint, no truncation.
    -->

    <!-- ── Content: Viva Credit Note Document ── -->
    <template id="viva_credit_note_document"
              name="VivaFarm Credit Note Document">
        <t t-call="vivafarm_report.external_layout_viva">
            <t t-set="is_credit_note" t-value="True"/>
            <t t-set="o" t-value="o.with_context(lang=lang)"/>

            <style>
                /* Compact so the credit note fits one page per copy. */
                #credit_note_signature_block { page-break-inside: avoid; }
            </style>

            <div class="page">
                <h3 t-att-style="'margin-top: 0; margin-bottom: 6px; text-align: left; color: %s;' % (o.company_id.primary_color or '#000000')">
                    <strong style="font-size: 24px;">
                        <t t-if="lang == 'th_TH'">ใบลดหนี้: </t>
                        <t t-else="">Credit Note: </t>
                        <span t-field="o.name"/>
                    </strong>
                </h3>

                <!-- Customer block -->
                <div class="row" style="margin: 0 0 8px 0;">
                    <div class="col-6" style="width: 50%; padding-right: 3px;">
                        <strong style="font-size: 15px;">
                            <t t-if="lang == 'th_TH'">ลูกค้า</t>
                            <t t-else="">Customer</t>
                        </strong>
                        <div style="font-size: 14px; line-height: 1.35;">
                            <div t-field="o.partner_id.name"/>
                            <div t-if="o.partner_id.street or o.partner_id.street2">
                                <span t-field="o.partner_id.street"/><t t-if="o.partner_id.street and o.partner_id.street2">, </t><span t-field="o.partner_id.street2"/>
                            </div>
                            <div t-if="o.partner_id.city or o.partner_id.state_id or o.partner_id.zip or o.partner_id.country_id">
                                <span t-field="o.partner_id.city"/><t t-if="o.partner_id.city and (o.partner_id.state_id or o.partner_id.zip)">, </t><span t-esc="o.partner_id._get_state_display(o.partner_id.state_id)"/><t t-if="o.partner_id.state_id and o.partner_id.zip"> </t><span t-field="o.partner_id.zip"/><t t-if="(o.partner_id.city or o.partner_id.state_id or o.partner_id.zip) and o.partner_id.country_id">, </t><span t-field="o.partner_id.country_id"/>
                            </div>
                            <div t-if="o.partner_id.vat">
                                <t t-if="lang == 'th_TH'">เลขประจำตัวผู้เสียภาษี: </t>
                                <t t-else="">Tax ID: </t>
                                <span t-field="o.partner_id.vat"/>
                                <t t-if="o.partner_id.l10n_th_branch_name"> · <span t-esc="o.partner_id.l10n_th_branch_name"/></t>
                            </div>
                        </div>
                    </div>
                    <div class="col-6" style="width: 50%; padding-left: 3px;">
                        <strong style="font-size: 15px;">
                            <t t-if="lang == 'th_TH'">เลขที่ใบกำกับภาษีเดิม</t>
                            <t t-else="">Original Invoice No.</t>
                        </strong>
                        <div style="font-size: 14px; line-height: 1.35;">
                            <div t-if="o.reversed_entry_id">
                                <span t-field="o.reversed_entry_id.name"/>
                                <t t-if="o.reversed_entry_id.invoice_date">
                                    <t t-if="lang == 'th_TH'"> · <span t-esc="o.reversed_entry_id._get_thai_date_display('invoice_date')"/></t>
                                    <t t-else=""> · <span t-field="o.reversed_entry_id.invoice_date"/></t>
                                </t>
                            </div>
                            <div t-else="">
                                <t t-if="lang == 'th_TH'">—</t>
                                <t t-else="">—</t>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Info row: dates + source -->
                <div class="row" style="margin: 0 0 8px 0;">
                    <div class="col-4" style="width: 33%; padding-right: 3px;">
                        <strong style="font-size: 15px;">
                            <t t-if="lang == 'th_TH'">วันที่ออกใบลดหนี้</t>
                            <t t-else="">Credit Note Date</t>
                        </strong>
                        <div style="font-size: 14px; line-height: 1.35;">
                            <t t-if="lang == 'th_TH'"><span t-esc="o._get_thai_date_display('invoice_date')"/></t>
                            <t t-else=""><span t-field="o.invoice_date"/></t>
                        </div>
                    </div>
                    <div class="col-4" style="width: 33%; padding-left: 3px; padding-right: 3px;">
                        <strong style="font-size: 15px;">
                            <t t-if="lang == 'th_TH'">วันที่จัดส่ง</t>
                            <t t-else="">Delivery Date</t>
                        </strong>
                        <div style="font-size: 14px; line-height: 1.35;">
                            <t t-if="lang == 'th_TH'"><span t-esc="o._get_thai_date_display('delivery_date')"/></t>
                            <t t-else=""><span t-field="o.delivery_date"/></t>
                        </div>
                    </div>
                    <div class="col-4" style="width: 33%; padding-left: 3px;">
                        <strong style="font-size: 15px;">
                            <t t-if="lang == 'th_TH'">แหล่งที่มา</t>
                            <t t-else="">Source</t>
                        </strong>
                        <div style="font-size: 14px; line-height: 1.35;">
                            <span t-field="o.invoice_origin"/>
                        </div>
                    </div>
                </div>

                <!-- Reason block: full-width, wraps freely in the body -->
                <div t-if="o.ref" class="row" style="margin: 0 0 8px 0;">
                    <div class="col-12" style="width: 100%;">
                        <strong style="font-size: 15px;">
                            <t t-if="lang == 'th_TH'">เหตุผล</t>
                            <t t-else="">Reason</t>
                        </strong>
                        <div style="font-size: 14px; line-height: 1.35; border: 1px solid #ccc; border-radius: 8px; padding: 6px 10px;">
                            <span t-field="o.ref"/>
                        </div>
                    </div>
                </div>

                <!-- Line items table -->
                <table class="table table-borderless" style="margin-bottom: 6px;">
                    <thead>
                        <tr>
                            <th style="width: 5%;"><span><t t-if="lang == 'th_TH'">ลำดับ</t><t t-else="">NO.</t></span></th>
                            <th style="width: 45%;"><span><t t-if="lang == 'th_TH'">คำอธิบาย</t><t t-else="">Description</t></span></th>
                            <th class="text-end" style="width: 12%;"><span><t t-if="lang == 'th_TH'">จำนวน(หน่วย)</t><t t-else="">Quantity</t></span></th>
                            <th class="text-end" style="width: 12%;"><span><t t-if="lang == 'th_TH'">ราคาต่อหน่วย</t><t t-else="">Unit Price</t></span></th>
                            <th class="text-end" style="width: 10%;"><span><t t-if="lang == 'th_TH'">ภาษี</t><t t-else="">Taxes</t></span></th>
                            <th class="text-end" style="width: 16%;"><span><t t-if="lang == 'th_TH'">จำนวนเงิน</t><t t-else="">Amount</t></span></th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-set="line_no" t-value="0"/>
                        <t t-foreach="o.invoice_line_ids" t-as="line">
                            <t t-if="line.display_type == 'product'">
                                <t t-set="line_no" t-value="line_no + 1"/>
                                <tr>
                                    <td><span t-esc="line_no"/></td>
                                    <td><span t-field="line.name"/></td>
                                    <td class="text-end"><span t-field="line.quantity"/></td>
                                    <td class="text-end"><span t-field="line.price_unit"/></td>
                                    <td class="text-end"><span t-esc="', '.join(line.tax_ids.mapped('name'))"/></td>
                                    <td class="text-end"><span t-field="line.price_subtotal"/></td>
                                </tr>
                            </t>
                        </t>
                    </tbody>
                </table>

                <!-- Totals — same structure as the Tax Invoice:
                     right-elements block, border-top, o_total_table
                     (Total Amount / VAT / Grand Total), amount-in-words
                     with border-bottom. Reuses _get_tax_invoice_totals()
                     (credit-note amounts are positive in Odoo, same rows). -->
                <div class="overflow-hidden">
                    <div id="right-elements" t-attf-class="#{'col-5' if report_type == 'pdf' else 'col-12 col-md-5'} ms-5 d-inline-block float-end" t-att-style="'border-top: 2px solid %s; margin-top: 12pt;' % (o.company_id.primary_color or '#000000')">
                        <div id="total" class="clearfix row">
                            <div class="ms-auto">
                                <table class="o_total_table table table-borderless avoid-page-break-inside">
                                    <t t-set="tt_rows" t-value="o._get_tax_invoice_totals()"/>
                                    <t t-set="currency" t-value="o.currency_id"/>
                                    <tr>
                                        <td>
                                            <t t-if="lang == 'th_TH'">รวมเงิน</t>
                                            <t t-else="">Total Amount</t>
                                        </td>
                                        <td class="text-end">
                                            <span t-out="tt_rows['gross_total']" t-options='{"widget": "monetary", "display_currency": currency}'/>
                                        </td>
                                    </tr>
                                    <t t-foreach="tt_rows['vat_rows']" t-as="vrow">
                                        <tr>
                                            <td>
                                                <t t-if="lang == 'th_TH'">ภาษีมูลค่าเพิ่ม <t t-out="vrow['rate_label']"/></t>
                                                <t t-else="">VAT <t t-out="vrow['rate_label']"/></t>
                                            </td>
                                            <td class="text-end">
                                                <span t-out="vrow['amount']" t-options='{"widget": "monetary", "display_currency": currency}'/>
                                            </td>
                                        </tr>
                                    </t>
                                    <t t-foreach="tt_rows['exempt_rows']" t-as="erow">
                                        <tr style="white-space: nowrap;">
                                            <td>
                                                <t t-if="lang == 'th_TH'">ภาษีมูลค่าเพิ่ม: ( <t t-out="erow['label']"/> )</t>
                                                <t t-else="">VAT: ( <t t-out="erow['label']"/> )</t>
                                            </td>
                                            <td class="text-end">
                                                <span t-options='{"widget": "monetary", "display_currency": currency}' t-out="0.0"/>
                                            </td>
                                        </tr>
                                    </t>
                                    <tr class="o_total">
                                        <td><strong>
                                            <t t-if="lang == 'th_TH'">จำนวนรวมทั้งสิ้น</t>
                                            <t t-else="">Grand Total</t>
                                        </strong></td>
                                        <td class="text-end">
                                            <strong t-out="tt_rows['grand_total']" t-options='{"widget": "monetary", "display_currency": currency}'/>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                        <div class="mb-2" t-att-style="'border-bottom: 2px solid %s;' % (o.company_id.primary_color or '#000000')">
                            <p class="text-end lh-sm" t-if="o.company_id.display_invoice_amount_total_words">
                                <t t-if="lang == 'th_TH'">ตัวอักษรยอดลดหนี้: <br/></t>
                                <t t-else="">Credit amount in words: <br/></t>
                                <span class="text-muted lh-sm" style="font-size: 0.875em;">(<span t-field="o.amount_total_words">Eight Hundred Baht</span>)</span>
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Signature blocks -->
                <div id="credit_note_signature_block" class="row" style="margin: 0; width: 100%;">
                    <div class="col-6" style="width: 50%; padding-right: 3px;">
                        <div style="border: 1px solid #ccc; border-radius: 8px; padding: 1px; text-align: center;">
                            <strong>
                                <t t-if="lang == 'th_TH'">ลูกค้า</t>
                                <t t-else="">Received by customer</t>
                            </strong><br/>
                            <div style="min-height: 50px; max-height: 50px;"></div>
                            <div style="font-size: 14px; margin-top: 0;">
                                <div style="border-bottom: 1px solid #ccc; margin: 0 4px; padding: 0; text-align: left;"><span style="white-space: nowrap;"><t t-if="lang == 'th_TH'">ชื่อ-นามสกุล</t><t t-else="">Name</t></span></div>
                                <div style="border-bottom: 1px solid #ccc; margin: 0 4px; padding: 0; text-align: left;"><span style="white-space: nowrap;"><t t-if="lang == 'th_TH'">ตำแหน่ง</t><t t-else="">Position</t></span></div>
                                <div style="border-bottom: 1px solid #ccc; margin: 0 4px; padding: 0; text-align: left;"><span style="white-space: nowrap;"><t t-if="lang == 'th_TH'">วันที่</t><t t-else="">Date</t></span></div>
                            </div>
                        </div>
                    </div>
                    <div class="col-6" style="width: 50%; padding-left: 3px;">
                        <div style="border: 1px solid #ccc; border-radius: 8px; padding: 1px; text-align: center;">
                            <strong>
                                <t t-if="lang == 'th_TH'">ผู้มีอำนาจลงนาม</t>
                                <t t-else="">Authorized Signatory</t>
                            </strong><br/>
                            <div style="min-height: 50px; max-height: 50px;">
                                <img t-if="o.company_id.l10n_th_signature_image"
                                     t-att-src="'data:image/png;base64,%s' % o.company_id.l10n_th_signature_image.decode()"
                                     style="max-height: 50px;"
                                     alt="Authorized Signature"/>
                            </div>
                            <div style="font-size: 14px; margin-top: 0;">
                                <div style="border-bottom: 1px solid #ccc; margin: 0 4px; padding: 0; text-align: left;"><span style="white-space: nowrap;"><t t-if="lang == 'th_TH'">ชื่อ-นามสกุล</t><t t-else="">Name</t></span></div>
                                <div style="border-bottom: 1px solid #ccc; margin: 0 4px; padding: 0; text-align: left;"><span style="white-space: nowrap;"><t t-if="lang == 'th_TH'">ตำแหน่ง</t><t t-else="">Position</t></span></div>
                                <div style="border-bottom: 1px solid #ccc; margin: 0 4px; padding: 0; text-align: left;"><span style="white-space: nowrap;"><t t-if="lang == 'th_TH'">วันที่</t><t t-else="">Date</t></span></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- ── Wrapper: Viva Credit Note ── -->
    <template id="viva_credit_note"
              name="VivaFarm Credit Note">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="lang" t-value="o.partner_id.lang or o.company_id.partner_id.lang"/>
                <t t-set="copies" t-value="o._get_credit_note_copies()"/>
                <t t-foreach="copies" t-as="copy">
                    <t t-set="copy_kind" t-value="copy['key']"/>
                    <t t-call="vivafarm_report.viva_credit_note_document" t-lang="lang"/>
                </t>
            </t>
        </t>
    </template>

    <!-- ── Report action ── -->
    <record id="action_report_viva_credit_note" model="ir.actions.report">
        <field name="name">Credit Note (ใบลดหนี้)</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">vivafarm_report.viva_credit_note</field>
        <field name="report_file">vivafarm_report.viva_credit_note</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
