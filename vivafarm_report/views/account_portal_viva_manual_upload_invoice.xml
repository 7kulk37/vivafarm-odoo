<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Manual hand-signed upload for the INVOICE portal page.
         Posts to /my/invoices/<id>/confirm_viva. -->
    <template id="account_portal_viva_manual_upload_invoice"
              name="VivaFarm Invoice Portal Manual Upload"
              inherit_id="account.portal_invoice_page">
        <xpath expr="//div[@name='viva_invoice_actions']" position="inside">
            <a
                role="button"
                class="btn btn-light"
                data-bs-toggle="modal"
                t-att-data-bs-target="'#modalmanual_upload_invoice_%s' % invoice.id"
                href="#"
                t-att-id="'manual_upload_invoice_button_%s' % invoice.id"
            >
                <i class="fa fa-upload me-1"/>Upload hand-signed copy
            </a>
        </xpath>
        <xpath expr="//div[@name='viva_invoice_actions']" position="after">
            <div role="dialog" class="modal fade"
                 t-att-id="'modalmanual_upload_invoice_%s' % invoice.id"
                 name="account_modal_manual_upload_invoice">
                <div class="modal-dialog">
                    <form method="post"
                          t-att-action="'/my/invoices/%s/confirm_viva' % invoice.id"
                          enctype="multipart/form-data"
                          class="modal-content">
                        <input type="hidden" name="access_token" t-att-value="invoice.access_token"/>
                        <header class="modal-header">
                            <h4 class="modal-title">Upload hand-signed invoice</h4>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"/>
                        </header>
                        <main class="modal-body">
                            <p>
                                Print the invoice, sign it by hand, scan or photograph it,
                                then upload the file (PDF, PNG or JPG, max 10&#160;MB).
                            </p>
                            <div class="mb-3">
                                <label class="form-label">File</label>
                                <input type="file" name="upload" accept="application/pdf,image/png,image/jpeg" class="form-control" required="required"/>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Your full name</label>
                                <input type="text" name="uploader_name" class="form-control" required="required"
                                       t-att-value="invoice.partner_id.name or ''"/>
                            </div>
                            <div class="form-check">
                                <input type="checkbox" name="confirm" class="form-check-input" required="required" value="1"/>
                                <label class="form-check-label">
                                    I confirm this is the signed invoice for this order.
                                </label>
                            </div>
                            <p class="text-muted small mt-2">
                                The uploaded file is stored unaltered and can be verified at any time.
                                This does not constitute a digital signature.
                            </p>
                        </main>
                        <footer class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-primary"><i class="fa fa-upload me-1"/>Upload</button>
                        </footer>
                    </form>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
