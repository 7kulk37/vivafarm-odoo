<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        VivaFarm Delivery Note (ใบส่งสินค้า) — custom report.
        Same approach as the Credit Note: wrapper → layout → content, all in
        this module. Standard Viva header (compact branch), title in the body.
        Functions as the delivery slip: customer + shipping addresses, line
        items with ordered/delivered quantities (NO prices — this is not a
        tax document), signature blocks. Single copy (not a tax document —
        no triplicate requirement).
    -->

    <!-- ── Content: Viva Delivery Note Document ── -->
    <template id="viva_delivery_note_document"
              name="VivaFarm Delivery Note Document">
        <t t-call="vivafarm_report.external_layout_viva">
            <t t-set="o" t-value="o.with_context(lang=lang)"/>

            <style>
                #delivery_note_signature_block { page-break-inside: avoid; }
            </style>

            <div class="page">
                <h3 t-att-style="'margin-top: 0; margin-bottom: 6px; text-align: left; color: %s;' % (o.company_id.primary_color or '#000000')">
                    <strong style="font-size: 24px;">
                        <t t-if="lang == 'th_TH'">ใบส่งสินค้า: </t>
                        <t t-else="">Delivery Note: </t>
                        <span t-field="o.name"/>
                    </strong>
                </h3>

                <!-- Customer block (left) + Shipping address (right) -->
                <div class="row" style="margin: 0 0 8px 0;">
                    <div class="col-6" style="width: 50%; padding-right: 3px;">
                        <strong style="font-size: 15px;">
                            <t t-if="lang == 'th_TH'">ลูกค้า</t>
                            <t t-else="">Customer</t>
                        </strong>
                        <div style="font-size: 14px; line-height: 1.35;">
                            <div t-field="o.partner_id.name"/>
                            <div t-if="o.partner_id.street or o.partner_id.street2">
                                <span t-field="o.partner_id.street"/><t t-if="o.partner_id.street and o.partner_id.street2">, </t><span t-field="o.partner_id.street2"/>
                            </div>
                            <div t-if="o.partner_id.city or o.partner_id.state_id or o.partner_id.zip or o.partner_id.country_id">
                                <span t-field="o.partner_id.city"/><t t-if="o.partner_id.city and (o.partner_id.state_id or o.partner_id.zip)">, </t><span t-esc="o.partner_id._get_state_display(o.partner_id.state_id)"/><t t-if="o.partner_id.state_id and o.partner_id.zip"> </t><span t-field="o.partner_id.zip"/><t t-if="(o.partner_id.city or o.partner_id.state_id or o.partner_id.zip) and o.partner_id.country_id">, </t><span t-field="o.partner_id.country_id"/>
                            </div>
                            <div t-if="o.partner_id.vat">
                                <t t-if="lang == 'th_TH'">เลขประจำตัวผู้เสียภาษี: </t>
                                <t t-else="">Tax ID: </t>
                                <span t-field="o.partner_id.vat"/>
                                <t t-if="o.partner_id.l10n_th_branch_name"> · <span t-esc="o.partner_id.l10n_th_branch_name"/></t>
                            </div>
                        </div>
                    </div>
                    <div class="col-6" style="width: 50%; padding-left: 3px;">
                        <strong style="font-size: 15px;">
                            <t t-if="lang == 'th_TH'">ที่อยู่จัดส่ง</t>
                            <t t-else="">Shipping Address</t>
                        </strong>
                        <div style="font-size: 14px; line-height: 1.35;">
                            <t t-if="o.partner_id">
                                <div t-field="o.partner_id.name"/>
                                <div t-if="o.partner_id.street or o.partner_id.street2">
                                    <span t-field="o.partner_id.street"/><t t-if="o.partner_id.street and o.partner_id.street2">, </t><span t-field="o.partner_id.street2"/>
                                </div>
                                <div t-if="o.partner_id.city or o.partner_id.state_id or o.partner_id.zip or o.partner_id.country_id">
                                    <span t-field="o.partner_id.city"/><t t-if="o.partner_id.city and (o.partner_id.state_id or o.partner_id.zip)">, </t><span t-esc="o.partner_id._get_state_display(o.partner_id.state_id)"/><t t-if="o.partner_id.state_id and o.partner_id.zip"> </t><span t-field="o.partner_id.zip"/><t t-if="(o.partner_id.city or o.partner_id.state_id or o.partner_id.zip) and o.partner_id.country_id">, </t><span t-field="o.partner_id.country_id"/>
                                </div>
                            </t>
                            <t t-else="">
                                <t t-if="lang == 'th_TH'">—</t>
                                <t t-else="">—</t>
                            </t>
                        </div>
                    </div>
                </div>

                <!-- Info row: delivery date + source -->
                <div class="row" style="margin: 0 0 8px 0;">
                    <div class="col-4" style="width: 33%; padding-right: 3px;">
                        <strong style="font-size: 15px;">
                            <t t-if="lang == 'th_TH'">วันที่จัดส่ง</t>
                            <t t-else="">Delivery Date</t>
                        </strong>
                        <div style="font-size: 14px; line-height: 1.35;">
                            <t t-if="o.state == 'done'">
                                <t t-if="lang == 'th_TH'"><span t-esc="o._get_thai_date_display('date_done')"/></t>
                                <t t-else=""><span t-field="o.date_done"/></t>
                            </t>
                            <t t-else="">
                                <t t-if="lang == 'th_TH'"><span t-esc="o._get_thai_date_display('scheduled_date')"/></t>
                                <t t-else=""><span t-field="o.scheduled_date"/></t>
                            </t>
                        </div>
                    </div>
                    <div class="col-4" style="width: 33%; padding-left: 3px; padding-right: 3px;">
                        <strong style="font-size: 15px;">
                            <t t-if="lang == 'th_TH'">แหล่งที่มา</t>
                            <t t-else="">Source</t>
                        </strong>
                        <div style="font-size: 14px; line-height: 1.35;">
                            <span t-field="o.origin"/>
                        </div>
                    </div>
                    <div class="col-4" style="width: 33%; padding-left: 3px;">
                        <strong style="font-size: 15px;">
                            <t t-if="lang == 'th_TH'">อ้างอิงลูกค้า</t>
                            <t t-else="">Customer Reference</t>
                        </strong>
                        <div style="font-size: 14px; line-height: 1.35;">
                            <span t-esc="o.move_ids.sale_line_id.order_id[:1].client_order_ref or o.origin"/>
                        </div>
                    </div>
                </div>

                <!-- Line items table: qty only, NO prices (delivery note is
                     not a tax document). Ordered vs Delivered like the
                     standard delivery slip. Quantities show the unit
                     ("5 kg") — format_number drops trailing .0 like the
                     standard slip. -->
                <t t-set="format_number" t-value="lambda x: int(x) if x == int(x) else x"/>
                <table class="table table-borderless" style="margin-bottom: 6px;">
                    <thead>
                        <tr>
                            <th style="width: 5%;"><span><t t-if="lang == 'th_TH'">ลำดับ</t><t t-else="">NO.</t></span></th>
                            <th style="width: 55%;"><span><t t-if="lang == 'th_TH'">สินค้า</t><t t-else="">Product</t></span></th>
                            <th class="text-end" style="width: 20%;"><span><t t-if="lang == 'th_TH'">สั่ง</t><t t-else="">Ordered</t></span></th>
                            <th class="text-end" style="width: 20%;"><span><t t-if="lang == 'th_TH'">ส่ง</t><t t-else="">Delivered</t></span></th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-set="line_no" t-value="0"/>
                        <t t-foreach="o.move_ids.filtered(lambda x: x.product_uom_qty)" t-as="line">
                            <t t-set="line_no" t-value="line_no + 1"/>
                            <tr>
                                <td><span t-esc="line_no"/></td>
                                <td>
                                    <span t-field="line.product_id.name"/>
                                    <t t-set="lots" t-value="line.move_line_ids.mapped('lot_id').filtered(lambda l: l.name)"/>
                                    <t t-if="lots">
                                        <div class="text-muted" style="font-size: 11px;">
                                            <t t-if="lang == 'th_TH'">ล็อต: </t>
                                            <t t-else="">Lots: </t>
                                            <span t-esc="', '.join(lots.mapped('name'))"/>
                                        </div>
                                    </t>
                                </td>
                                <td class="text-end"><span t-esc="'%s %s' % (format_number(line.product_uom_qty), line.product_uom.name)"/></td>
                                <td class="text-end"><span t-esc="'%s %s' % (format_number(line.quantity), line.product_uom.name)"/></td>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <!-- Acceptance note: goods-receipt language ONLY (checked +
                     accepted as shown). No payment/VAT/amount wording — the
                     tax invoice owns those. -->
                <div style="margin: 12px 0 8px 0; font-size: 13px; line-height: 1.5; color: #333; text-align: center;">
                    <t t-if="lang == 'th_TH'">
                        ข้าพเจ้าได้ตรวจสอบสินค้าตามรายการในเอกสารฉบับนี้แล้ว และรับสินค้าไว้ถูกต้องครบถ้วนตามที่แสดงไว้
                    </t>
                    <t t-else="">
                        I have inspected the goods listed in this document and accept them as correct and complete as shown.
                    </t>
                </div>

                <!-- Signature blocks -->
                <div id="delivery_note_signature_block" class="row" style="margin: 0; width: 100%;">
                    <div class="col-6" style="width: 50%; padding-right: 3px;">
                        <div style="border: 1px solid #ccc; border-radius: 8px; padding: 1px; text-align: center;">
                            <strong>
                                <t t-if="lang == 'th_TH'">ผู้รับสินค้า</t>
                                <t t-else="">Received by</t>
                            </strong><br/>
                            <div style="min-height: 50px; max-height: 50px;"></div>
                            <div style="font-size: 14px; margin-top: 0;">
                                <div style="border-bottom: 1px solid #ccc; margin: 0 4px; padding: 0; text-align: left;"><span style="white-space: nowrap;"><t t-if="lang == 'th_TH'">ชื่อ-นามสกุล</t><t t-else="">Name</t></span></div>
                                <div style="border-bottom: 1px solid #ccc; margin: 0 4px; padding: 0; text-align: left;"><span style="white-space: nowrap;"><t t-if="lang == 'th_TH'">ตำแหน่ง</t><t t-else="">Position</t></span></div>
                                <div style="border-bottom: 1px solid #ccc; margin: 0 4px; padding: 0; text-align: left;"><span style="white-space: nowrap;"><t t-if="lang == 'th_TH'">วันที่</t><t t-else="">Date</t></span></div>
                            </div>
                        </div>
                    </div>
                    <div class="col-6" style="width: 50%; padding-left: 3px;">
                        <div style="border: 1px solid #ccc; border-radius: 8px; padding: 1px; text-align: center;">
                            <strong>
                                <t t-if="lang == 'th_TH'">ผู้มีอำนาจลงนาม</t>
                                <t t-else="">Authorized Signatory</t>
                            </strong><br/>
                            <div style="min-height: 50px; max-height: 50px;">
                                <img t-if="o.company_id.l10n_th_signature_image"
                                     t-att-src="'data:image/png;base64,%s' % o.company_id.l10n_th_signature_image.decode()"
                                     style="max-height: 50px;"
                                     alt="Authorized Signature"/>
                            </div>
                            <div style="font-size: 14px; margin-top: 0;">
                                <div style="border-bottom: 1px solid #ccc; margin: 0 4px; padding: 0; text-align: left;"><span style="white-space: nowrap;"><t t-if="lang == 'th_TH'">ชื่อ-นามสกุล</t><t t-else="">Name</t></span></div>
                                <div style="border-bottom: 1px solid #ccc; margin: 0 4px; padding: 0; text-align: left;"><span style="white-space: nowrap;"><t t-if="lang == 'th_TH'">ตำแหน่ง</t><t t-else="">Position</t></span></div>
                                <div style="border-bottom: 1px solid #ccc; margin: 0 4px; padding: 0; text-align: left;"><span style="white-space: nowrap;"><t t-if="lang == 'th_TH'">วันที่</t><t t-else="">Date</t></span></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- ── Wrapper: Viva Delivery Note ── -->
    <template id="viva_delivery_note"
              name="VivaFarm Delivery Note">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="lang" t-value="o._get_report_lang()"/>
                <t t-call="vivafarm_report.viva_delivery_note_document" t-lang="lang"/>
            </t>
        </t>
    </template>

    <!-- ── Report action ── -->
    <record id="action_report_viva_delivery_note" model="ir.actions.report">
        <field name="name">Delivery Note (ใบส่งสินค้า)</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">vivafarm_report.viva_delivery_note</field>
        <field name="report_file">vivafarm_report.viva_delivery_note</field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
