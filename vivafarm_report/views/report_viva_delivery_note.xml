<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        VivaFarm Delivery Note (ใบส่งสินค้า) — custom report.
        Same approach as the Credit Note: wrapper → layout → content, all in
        this module. Renders with the TAX-INVOICE layout frame (tall repeating
        letterhead, paperformat_viva_invoice 107mm) like the newest
        Quotation/SO — the header frame owns the title + customer/shipping
        blocks + info bar, so the body starts with the line items.
        NOT a tax document: line items carry qty only (Ordered/Delivered,
        NO prices), no totals, no copy badge, no T&C. The acceptance note +
        signature boxes prove goods receipt (ใบส่งสินค้า = evidence of
        delivery, ป.พ.พ. มาตรา 456).
    -->

    <!-- ── Content: Viva Delivery Note Document ── -->
    <template id="viva_delivery_note_document"
              name="VivaFarm Delivery Note Document">
        <t t-call="vivafarm_report.external_layout_viva">
            <t t-set="is_tax_invoice" t-value="True"/>
            <t t-set="o" t-value="o.with_context(lang=lang)"/>

            <style>
                #delivery_note_signature_block { page-break-inside: avoid; }
                /* Compact acceptance note so the signature section fits one page. */
                #acceptance_note { margin: 12px 0 8px 0; font-size: 13px; line-height: 1.5; color: #333; text-align: center; }
            </style>

            <!-- Address/shipping data for the repeating header -->
            <t t-set="address">
                <div t-field="o.partner_id.name">Customer name</div>
                <div t-if="o.partner_id.street or o.partner_id.street2">
                    <span t-field="o.partner_id.street"/><t t-if="o.partner_id.street and o.partner_id.street2">, </t><span t-field="o.partner_id.street2"/>
                </div>
                <div t-if="o.partner_id.city or o.partner_id.state_id or o.partner_id.zip or o.partner_id.country_id">
                    <span t-field="o.partner_id.city"/><t t-if="o.partner_id.city and (o.partner_id.state_id or o.partner_id.zip)">, </t><span t-esc="o.partner_id._get_state_display(o.partner_id.state_id)"/><t t-if="o.partner_id.state_id and o.partner_id.zip"> </t><span t-field="o.partner_id.zip"/><t t-if="(o.partner_id.city or o.partner_id.state_id or o.partner_id.zip) and o.partner_id.country_id">, </t><span t-field="o.partner_id.country_id"/>
                </div>
                <div t-if="o.partner_id.vat">
                    <t t-if="lang == 'th_TH'">เลขประจำตัวผู้เสียภาษี: </t>
                    <t t-else="">Tax ID: </t>
                    <span t-field="o.partner_id.vat"/><t t-if="o.partner_id.l10n_th_branch_name"> · <span t-esc="o.partner_id.l10n_th_branch_name"/></t>
                </div>
            </t>
            <t t-set="information_block">
                <div name="shipping_address_block">
                    <strong class="d-block mt-1" style="font-size: 16px; font-weight: bold;">
                        <t t-if="lang == 'th_TH'">ที่อยู่จัดส่ง</t>
                        <t t-else="">Shipping Address</t>
                    </strong>
                    <div t-field="o.partner_id.name">Branch name</div>
                    <div t-if="o.partner_id.street or o.partner_id.street2">
                        <span t-field="o.partner_id.street"/><t t-if="o.partner_id.street and o.partner_id.street2">, </t><span t-field="o.partner_id.street2"/>
                    </div>
                    <div t-if="o.partner_id.city or o.partner_id.state_id or o.partner_id.zip or o.partner_id.country_id">
                        <span t-field="o.partner_id.city"/><t t-if="o.partner_id.city and (o.partner_id.state_id or o.partner_id.zip)">, </t><span t-esc="o.partner_id._get_state_display(o.partner_id.state_id)"/><t t-if="o.partner_id.state_id and o.partner_id.zip"> </t><span t-field="o.partner_id.zip"/><t t-if="(o.partner_id.city or o.partner_id.state_id or o.partner_id.zip) and o.partner_id.country_id">, </t><span t-field="o.partner_id.country_id"/>
                    </div>
                </div>
            </t>

            <div class="page">
                <!-- Title: rendered by the LAYOUT header frame (state-aware:
                     Delivery Note until signed, Delivery Confirmation after
                     the customer acknowledges receipt). -->
                <t t-set="layout_document_title">
                    <span t-if="o.signed_document_id">
                        <t t-if="lang == 'th_TH'">ใบส่งสินค้า: </t>
                        <t t-else="">Delivery Order: </t>
                    </span>
                    <span t-else="">
                        <t t-if="lang == 'th_TH'">ใบส่งสินค้า: </t>
                        <t t-else="">Delivery Note: </t>
                    </span>
                    <span t-field="o.name">WH/OUT/00000</span>
                </t>

                <!-- Line items table: qty only, NO prices (delivery note is
                     not a tax document). Ordered vs Delivered like the
                     standard delivery slip. Quantities show the unit
                     ("5 kg") — format_number drops trailing .0 like the
                     standard slip. Margin lives on a WRAPPER div, not the
                     table (QtWebKit ignores table margin-top; padding-top
                     does not collapse). -->
                <t t-set="format_number" t-value="lambda x: int(x) if x == int(x) else x"/>
                <div style="padding-top: 8px;">
                <table class="table table-sm o_main_table table-borderless mb-2" style="table-layout: fixed;" name="dn_line_table">
                    <thead>
                        <tr>
                            <th class="fw-bold text-center" style="width: 5%;">
                                <t t-if="lang == 'th_TH'">ลำดับ</t>
                                <t t-else="">NO.</t>
                            </th>
                            <th class="fw-bold text-start" style="width: 55%;">
                                <t t-if="lang == 'th_TH'">สินค้า</t>
                                <t t-else="">Product</t>
                            </th>
                            <th class="fw-bold text-end" style="width: 20%;">
                                <t t-if="lang == 'th_TH'">สั่ง</t>
                                <t t-else="">Ordered</t>
                            </th>
                            <th class="fw-bold text-end" style="width: 20%;">
                                <t t-if="lang == 'th_TH'">ส่ง</t>
                                <t t-else="">Delivered</t>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-set="line_no" t-value="0"/>
                        <t t-foreach="o.move_ids.filtered(lambda x: x.product_uom_qty)" t-as="line">
                            <t t-set="line_no" t-value="line_no + 1"/>
                            <tr>
                                <td class="text-center"><span t-esc="line_no"/></td>
                                <td>
                                    <span t-field="line.product_id.name"/>
                                    <t t-set="lots" t-value="line.move_line_ids.mapped('lot_id').filtered(lambda l: l.name)"/>
                                    <t t-if="lots">
                                        <div class="text-muted" style="font-size: 11px;">
                                            <t t-if="lang == 'th_TH'">ล็อต: </t>
                                            <t t-else="">Lots: </t>
                                            <span t-esc="', '.join(lots.mapped('name'))"/>
                                        </div>
                                    </t>
                                </td>
                                <td class="text-end"><span t-esc="'%s %s' % (format_number(line.product_uom_qty), line.product_uom.name)"/></td>
                                <td class="text-end"><span t-esc="'%s %s' % (format_number(line.quantity), line.product_uom.name)"/></td>
                            </tr>
                        </t>
                    </tbody>
                </table>
                </div>

                <!-- Acceptance note: goods-receipt language ONLY (checked +
                     accepted as shown). No payment/VAT/amount wording — the
                     tax invoice owns those. -->
                <div id="acceptance_note">
                    <t t-if="lang == 'th_TH'">
                        ข้าพเจ้าได้ตรวจสอบสินค้าตามรายการในเอกสารฉบับนี้แล้ว และรับสินค้าไว้ถูกต้องครบถ้วนตามที่แสดงไว้
                    </t>
                    <t t-else="">
                        I have inspected the goods listed in this document and accept them as correct and complete as shown.
                    </t>
                </div>

                <!-- Signature blocks -->
                <div id="delivery_note_signature_block" class="row" style="margin: 0; width: 100%; page-break-inside: avoid;">
                    <div style="page-break-inside: avoid; margin-top: 14px;">
                        <div class="text-muted" style="font-size: 12px; font-weight: bold; margin-top: 0; margin-bottom: 1px; text-align: center; width: 100%;">
                            <t t-if="lang == 'th_TH'">การลงลายมือชื่อในช่องต่อไปนี้ ให้เป็นไปตามข้อกำหนดและเงื่อนไขของเอกสารฉบับนี้</t>
                            <t t-else="">Signatures below constitute acceptance in accordance with the Terms &amp; Conditions.</t>
                        </div>
                        <div class="row" style="margin: 0; width: 100%;">
                            <div class="col-6" style="width: 50%; padding-right: 3px;">
                                <div style="page-break-inside: avoid;">
                                    <div style="border: 1px solid #ccc; border-radius: 8px; padding: 1px; text-align: center;">
                                        <strong>
                                            <t t-if="lang == 'th_TH'">ผู้รับสินค้า</t>
                                            <t t-else="">Received by</t>
                                        </strong><br/>
                                        <div style="min-height: 50px; max-height: 50px;">
                                            <img t-if="o.signature and o.env.context.get('delivery_include_signature')"
                                                 t-att-src="image_data_uri(o.signature)"
                                                 style="max-height: 50px;"
                                                 alt="Customer Signature"/>
                                        </div>
                                        <div style="font-size: 14px; margin-top: 0;">
                                            <div style="border-bottom: 1px solid #ccc; margin: 0 4px; padding: 0; text-align: left;"><span style="white-space: nowrap;"><t t-if="lang == 'th_TH'">ชื่อ-นามสกุล</t><t t-else="">Name</t></span><t t-if="o.signature and o.env.context.get('delivery_include_signature') and o.signed_by"> <span style="white-space: nowrap; float: right;"><t t-esc="o.signed_by"/></span></t></div>
                                            <div style="border-bottom: 1px solid #ccc; margin: 0 4px; padding: 0; text-align: left;"><span style="white-space: nowrap;"><t t-if="lang == 'th_TH'">ตำแหน่ง</t><t t-else="">Position</t></span><t t-if="o.signature and o.env.context.get('delivery_include_signature') and o.signed_position"> <span style="white-space: nowrap; float: right;"><t t-esc="o.signed_position"/></span></t></div>
                                            <div style="border-bottom: 1px solid #ccc; margin: 0 4px; padding: 0; text-align: left;"><span style="white-space: nowrap;"><t t-if="lang == 'th_TH'">วันที่</t><t t-else="">Date</t></span><t t-if="o.signature and o.env.context.get('delivery_include_signature') and o.signed_on"> <span style="white-space: nowrap; float: right;"><t t-esc="o._get_viva_datetime_display('signed_on')"/></span></t></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-6" style="width: 50%; padding-left: 3px;">
                                <div style="page-break-inside: avoid;">
                                    <div style="border: 1px solid #ccc; border-radius: 8px; padding: 1px; text-align: center;">
                                        <strong>
                                            <t t-if="lang == 'th_TH'">ผู้มีอำนาจลงนาม</t>
                                            <t t-else="">Authorized Signatory</t>
                                        </strong><br/>
                                        <div style="min-height: 50px; max-height: 50px;">
                                            <img t-if="o.viva_sent_at and o.company_id.l10n_th_signature_image"
                                                 t-att-src="'data:image/png;base64,%s' % o.company_id.l10n_th_signature_image.decode()"
                                                 style="max-height: 50px;"
                                                 alt="Authorized Signature"/>
                                        </div>
                                        <div style="font-size: 14px; margin-top: 0;">
                                            <div style="border-bottom: 1px solid #ccc; margin: 0 4px; padding: 0; text-align: left;"><span style="white-space: nowrap;"><t t-if="lang == 'th_TH'">ชื่อ-นามสกุล</t><t t-else="">Name</t></span><t t-if="o.viva_sent_at and o.company_id.l10n_th_signatory_name"> <span style="white-space: nowrap; float: right;"><t t-esc="o.company_id.l10n_th_signatory_name"/></span></t></div>
                                            <div style="border-bottom: 1px solid #ccc; margin: 0 4px; padding: 0; text-align: left;"><span style="white-space: nowrap;"><t t-if="lang == 'th_TH'">ตำแหน่ง</t><t t-else="">Position</t></span><t t-if="o.viva_sent_at and o.company_id.l10n_th_signatory_position"> <span style="white-space: nowrap; float: right;"><t t-esc="o.company_id.l10n_th_signatory_position"/></span></t></div>
                                            <div style="border-bottom: 1px solid #ccc; margin: 0 4px; padding: 0; text-align: left;"><span style="white-space: nowrap;"><t t-if="lang == 'th_TH'">วันที่</t><t t-else="">Date</t></span><t t-if="o.viva_sent_at"> <span style="white-space: nowrap; float: right;"><t t-esc="o._get_viva_datetime_display('viva_sent_at')"/></span></t></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- ── Wrapper: Viva Delivery Note ── -->
    <template id="viva_delivery_note"
              name="VivaFarm Delivery Note">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="lang" t-value="o._get_report_lang()"/>
                <t t-call="vivafarm_report.viva_delivery_note_document" t-lang="lang"/>
            </t>
        </t>
    </template>

    <!-- ── Report action ── -->
    <record id="action_report_viva_delivery_note" model="ir.actions.report">
        <field name="name">Delivery Note (ใบส่งสินค้า)</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">vivafarm_report.viva_delivery_note</field>
        <field name="report_file">vivafarm_report.viva_delivery_note</field>
        <field name="print_report_name">'Delivery Note - %s' % (object.name)</field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="vivafarm_report.paperformat_viva_invoice"/>
    </record>
</odoo>
