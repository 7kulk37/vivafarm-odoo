<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Default-report address unification (v57) — first condition only.

        Rule (user-approved):
        - ALL reports: CUSTOMER address on the LEFT (information_block slot)
        - SHIPPING address on the RIGHT (address slot) — only when a separate
          shipping/delivery partner exists
        - INVOICE address NOT shown

        Why: stock Odoo report templates each fill web.address_layout's two
        slots differently (sale: customer right + invoicing/shipping left;
        account: customer right + shipping left; stock: customer left +
        delivery right). These overrides normalize sale.order and account
        invoice to the rule. stock.report_delivery_document already complies
        (customer left, delivery right) → untouched.

        Pending (NOT in this step, per user): title placement,
        purchase/expense/other reports.
    -->

    <!-- Delivery Note (v58): match sale order / invoice patterns.
         1. VAT line: stock's customer block passes "vat" to the contact
            widget, which renders vat_label = country.vat_label or _('VAT')
            → the Thai 'ภาษีมูลค่าเพิ่ม (VAT):' line (TH country has empty
            vat_label). Sale order / invoice render a literal 'Tax ID:' line
            instead. Drop "vat" from the widget fields and add the same
            literal line → consistent 'Tax ID: 0105555…'.
         2. Untranslated labels: stock's th.po leaves <strong>Shipping
            Date</strong>, <strong>Customer</strong>, <strong>Delivery
            Address</strong>, <strong>Operator:</strong> with EMPTY msgstr
            → they render English even for Thai partners. Explicit
            lang == 'th_TH' conditionals (same pattern as report_viva_invoice).
            NB: stock does NOT set a 'lang' template variable (unlike the
            viva wrapper) — it only re-sets o's context via
            o.with_context(lang=o._get_report_lang()). So the language test
            must use o._get_report_lang(), not the 'lang' variable. -->
    <template id="report_delivery_unify" inherit_id="stock.report_delivery_document">
        <!-- VAT line: drop "vat" from contact widget, add literal Tax ID line -->
        <xpath expr="//div[@name='partner_header']/div[@t-field='partner.commercial_partner_id']" position="replace">
            <div t-field="partner.commercial_partner_id"
                 t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "phone_icons": True}'/>
            <p t-if="partner.commercial_partner_id.vat" class="mb-0">
                <t t-if="o.company_id.account_fiscal_country_id.vat_label" t-out="o.company_id.account_fiscal_country_id.vat_label"/>
                <t t-else="">Tax ID</t>: <span t-field="partner.commercial_partner_id.vat"/>
            </p>
        </xpath>
        <!-- Customer label -->
        <xpath expr="//div[@name='customer_address']/strong" position="replace">
            <strong><t t-if="o._get_report_lang() == 'th_TH'">ลูกค้า</t><t t-else="">Customer</t></strong>
        </xpath>
        <!-- Delivery Address label -->
        <xpath expr="//div[@name='outgoing_delivery_address']/strong" position="replace">
            <strong><t t-if="o._get_report_lang() == 'th_TH'">ที่อยู่จัดส่ง</t><t t-else="">Delivery Address</t></strong>
        </xpath>
        <!-- Shipping Date label -->
        <xpath expr="//div[@name='div_sched_date']/strong" position="replace">
            <strong><t t-if="o._get_report_lang() == 'th_TH'">วันที่จัดส่ง</t><t t-else="">Shipping Date</t></strong>
        </xpath>
        <!-- Operator label -->
        <xpath expr="//div[@name='div_operator']/strong" position="replace">
            <strong><t t-if="o._get_report_lang() == 'th_TH'">ผู้ปฏิบัติงาน:</t><t t-else="">Operator:</t></strong>
        </xpath>
    </template>

    <!-- Purchase Order (v59): vendor LEFT, shipping RIGHT (only when
         dest_address_id). Stock purchase template fills address (right) with
         the vendor and information_block (left) with the shipping address —
         the reverse of the unified rule. Same pattern as sale order:
         counterparty (vendor) left with literal Tax ID line, shipping right.
         NB: purchase templates also do NOT set a 'lang' variable — they use
         o.with_context(lang=o.partner_id.lang). Language test via
         o.partner_id.lang.
         NB2: purchase_stock (installed) inserts a <t t-else=""> after the
         <t t-if="o.dest_address_id"> wrapper. Replacing that wrapper orphans
         the t-else → 't-elif must be preceded by t-if'. So replace only the
         inner t-set content, keeping the t-if/t-else chain intact. -->
    <template id="report_purchaseorder_unify" inherit_id="purchase.report_purchaseorder_document" priority="99">
        <!-- address slot (right): vendor -> shipping (only when present) -->
        <xpath expr="//t[@t-set='address']" position="replace">
            <t t-set="address">
                <t t-if="o.dest_address_id">
                    <strong class="d-block mt-3"><t t-if="o.partner_id.lang == 'th_TH'">ที่อยู่จัดส่ง</t><t t-else="">Shipping address</t></strong>
                    <div t-field="o.dest_address_id"
                        t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "phone_icons": True}' name="purchase_shipping_address"/>
                </t>
            </t>
        </xpath>
        <!-- information_block content (left): shipping -> vendor (always set).
             Target ALL t-set information_block nodes: purchase_stock's
             t-else branch (no dest_address) also sets information_block to
             the warehouse address — that must become vendor too, or a PO
             without dest_address shows warehouse left instead of vendor.
             NB: locate_node returns only the FIRST xpath match, so the
             t-else branch needs its own xpath. -->
        <xpath expr="//t[@t-if='o.dest_address_id']/t[@t-set='information_block']" position="replace">
            <t t-set="information_block">
                <strong><t t-if="o.partner_id.lang == 'th_TH'">ผู้จำหน่าย</t><t t-else="">Vendor</t></strong>
                <div t-field="o.partner_id"
                    t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "phone_icons": True}'/>
                <p t-if="o.partner_id.vat" class="mb-0">
                    <t t-if="o.company_id.account_fiscal_country_id.vat_label" t-out="o.company_id.account_fiscal_country_id.vat_label"/>
                    <t t-else="">Tax ID</t>: <span t-field="o.partner_id.vat"/>
                </p>
            </t>
        </xpath>
        <!-- t-else branch (no dest_address): purchase_stock fills
             information_block with the warehouse address — replace with
             vendor too, so the pattern is vendor LEFT / shipping RIGHT
             (right empty when no dest). -->
        <xpath expr="//t[@t-else='']/t[@t-set='information_block']" position="replace">
            <t t-set="information_block">
                <strong><t t-if="o.partner_id.lang == 'th_TH'">ผู้จำหน่าย</t><t t-else="">Vendor</t></strong>
                <div t-field="o.partner_id"
                    t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "phone_icons": True}'/>
                <p t-if="o.partner_id.vat" class="mb-0">
                    <t t-if="o.company_id.account_fiscal_country_id.vat_label" t-out="o.company_id.account_fiscal_country_id.vat_label"/>
                    <t t-else="">Tax ID</t>: <span t-field="o.partner_id.vat"/>
                </p>
            </t>
        </xpath>
        <!-- Expected Arrival label (v61): upstream th.po leaves the
             tag-wrapped key "<strong>Expected Arrival:</strong>" with an
             EMPTY msgstr → renders English for Thai partners. Explicit
             conditional (same pattern as v58/v59). -->
        <xpath expr="//div[@t-if='o.date_planned']/strong" position="replace">
            <strong><t t-if="o.partner_id.lang == 'th_TH'">วันที่คาดว่าจะได้รับ:</t><t t-else="">Expected Arrival:</t></strong>
        </xpath>
        <!-- Payment Terms label (v61): same upstream gap — the tag-wrapped
             key "<strong>Payment Terms: </strong>" has an EMPTY msgstr.
             The value itself renders from o.payment_term_id (blank only when
             the PO has no payment term set). -->
        <xpath expr="//strong[contains(text(), 'Payment Terms')]" position="replace">
            <strong><t t-if="o.partner_id.lang == 'th_TH'">เงื่อนไขการชำระเงิน: </t><t t-else="">Payment Terms: </t></strong>
        </xpath>
    </template>

    <!-- Purchase Quotation (v59): same swap as purchase order, plus the
         Requested Ship Date moves with the shipping block to the right. -->
    <template id="report_purchasequotation_unify" inherit_id="purchase.report_purchasequotation_document" priority="99">
        <xpath expr="//t[@t-set='address']" position="replace">
            <t t-set="address">
                <t t-if="o.dest_address_id">
                    <strong class="d-block mt-3"><t t-if="o.partner_id.lang == 'th_TH'">ที่อยู่จัดส่ง</t><t t-else="">Shipping address</t></strong>
                    <div t-field="o.dest_address_id"
                        t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "phone_icons": True}' name="purchase_shipping_address"/>
                    <div>
                        <strong><t t-if="o.partner_id.lang == 'th_TH'">วันที่ขอจัดส่ง:</t><t t-else="">Requested Ship Date:</t></strong>
                        <span t-field="o.date_planned" t-options="{'date_only': 'true'}"/>
                    </div>
                </t>
            </t>
        </xpath>
        <xpath expr="//t[@t-if='o.dest_address_id']/t[@t-set='information_block']" position="replace">
            <t t-set="information_block">
                <strong><t t-if="o.partner_id.lang == 'th_TH'">ผู้จำหน่าย</t><t t-else="">Vendor</t></strong>
                <div t-field="o.partner_id"
                    t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "phone_icons": True}'/>
                <p t-if="o.partner_id.vat" class="mb-0">
                    <t t-if="o.company_id.account_fiscal_country_id.vat_label" t-out="o.company_id.account_fiscal_country_id.vat_label"/>
                    <t t-else="">Tax ID</t>: <span t-field="o.partner_id.vat"/>
                </p>
            </t>
        </xpath>
        <!-- t-else branch (no dest_address): purchase_stock fills
             information_block with the warehouse address — replace with
             vendor too. -->
        <xpath expr="//t[@t-else='']/t[@t-set='information_block']" position="replace">
            <t t-set="information_block">
                <strong><t t-if="o.partner_id.lang == 'th_TH'">ผู้จำหน่าย</t><t t-else="">Vendor</t></strong>
                <div t-field="o.partner_id"
                    t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "phone_icons": True}'/>
                <p t-if="o.partner_id.vat" class="mb-0">
                    <t t-if="o.company_id.account_fiscal_country_id.vat_label" t-out="o.company_id.account_fiscal_country_id.vat_label"/>
                    <t t-else="">Tax ID</t>: <span t-field="o.partner_id.vat"/>
                </p>
            </t>
        </xpath>
    </template>

    <!-- web.address_layout: render the address row when EITHER slot is filled.
         Stock renders the row only t-if="address". The unified rule sets
         customer in information_block (left) and shipping in address (right)
         ONLY when it differs — a lone customer block must still render.
         Also drop the grey placeholder box when the right slot is empty
         (t-esc fallback shows it for empty strings, which would print a
         'Address block / Usually contains the address...' box on every
         sale order / invoice that has no separate shipping address). -->
    <template id="address_layout_unify" inherit_id="web.address_layout">
        <xpath expr="//div[@t-if='address']" position="attributes">
            <attribute name="t-if">address or information_block</attribute>
        </xpath>
        <xpath expr="//div[@name='address']/t[@t-esc='address or None']" position="replace">
            <t t-if="address" t-esc="address"/>
        </xpath>
    </template>

    <!-- Sale Order: customer LEFT, shipping RIGHT, no invoicing address. -->
    <template id="report_saleorder_unify" inherit_id="sale.report_saleorder_document">
        <!-- address slot (right): customer -> shipping (only when different) -->
        <xpath expr="//t[@t-set='address']" position="replace">
            <t t-set="address">
                <t t-if="doc.partner_shipping_id and doc.partner_shipping_id != doc.partner_id">
                    <strong>Shipping Address</strong>
                    <div t-field="doc.partner_shipping_id"
                        t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "phone_icons": True}'/>
                </t>
            </t>
        </xpath>
        <!-- information_block slot (left): invoicing+shipping -> customer only.
             Target the <t t-if="..."> wrapper that CONTAINS the
             information_block t-set and replace it outright, so customer is
             always set (even when shipping/invoicing == customer).
             NB: must anchor on t[@t-if] — a bare //t[.//t[@t-set=...]] also
             matches the template root <t t-call="web.external_layout"> and
             replaces the WHOLE template (blank page). -->
        <xpath expr="//t[@t-if][.//t[@t-set='information_block']]" position="replace">
            <t t-set="information_block">
                <strong>Customer</strong>
                <div t-field="doc.partner_id" class="mb-0"
                    t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}' />
                <p t-if="doc.partner_id.vat" class="mb-0">
                    <t t-if="doc.company_id.account_fiscal_country_id.vat_label" t-out="doc.company_id.account_fiscal_country_id.vat_label"/>
                    <t t-else="">Tax ID</t>: <span t-field="doc.partner_id.vat"/>
                </p>
            </t>
        </xpath>
    </template>

    <!-- Invoice PDF: customer LEFT, shipping RIGHT.
         NOTE: must inherit l10n_th.report_invoice_document (primary=True
         template — the Thai localization's own copy of the base account
         template). It appends the partner branch name (l10n_th_branch_name)
         after the VAT; that span is replicated here. Inheriting the base
         account template instead breaks l10n_th's xpaths (they anchor on
         divs this override removes). -->
    <template id="report_invoice_unify" inherit_id="l10n_th.report_invoice_document">
        <!-- Replace the whole hand-wrapped address row (shipping left,
             customer right) with the unified slots (customer left,
             shipping right). -->
        <xpath expr="//div[hasclass('row')][.//t[@t-set='information_block']]" position="replace">
            <t t-set="information_block">
                <!-- Label follows the document direction: vendor bills
                     (in_invoice/in_refund) show the vendor, customer
                     invoices (out_invoice/out_refund) show the customer. -->
                <strong><t t-if="o.move_type in ('in_invoice', 'in_refund')">Vendor</t><t t-else="">Customer</t></strong>
                <address class="mb-0" t-field="o.partner_id"
                    t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
                <div t-if="o.partner_id.vat" id="partner_vat_unified">
                    <t t-if="o.company_id.account_fiscal_country_id.vat_label" t-out="o.company_id.account_fiscal_country_id.vat_label" id="inv_tax_id_label"/>
                    <t t-else="">Tax ID</t>: <span t-field="o.partner_id.vat"/>
                    <span t-esc="o.partner_id.l10n_th_branch_name"/>
                </div>
                <div t-if="o.partner_id.country_code == 'MA' and o.partner_id.company_registry">
                    ICE: <a t-field="o.partner_id.company_registry"/>
                </div>
            </t>
            <t t-if="o.partner_shipping_id and o.partner_shipping_id != o.partner_id">
                <t t-set="address">
                    <strong class="d-block">Shipping Address</strong>
                    <div t-field="o.partner_shipping_id"
                        t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "phone_icons": True}'/>
                </t>
            </t>
        </xpath>
    </template>
</odoo>
