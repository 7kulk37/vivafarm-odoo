<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        VivaFarm delivery-note portal buttons: "View Viva Delivery Note" +
        "Accept & Sign Delivery" in the "Last Delivery Orders" section.

        The stock section (sale_stock.sale_order_portal_content_inherit_
        sale_stock) links each picking to /my/picking/pdf/<id> which renders
        the DEFAULT stock.action_report_delivery. This inheritance adds:
          - "View Viva Delivery Note" → /my/picking/<id>/viva_pdf (the custom
            vivafarm_report.viva_delivery_note; once acknowledged, the
            ir_actions_report override serves the STORED signed bytes).
          - "Accept & Sign Delivery" (done, unsigned pickings only) → modal
            with the existing Viva signature form → /my/picking/<id>/accept_viva.

        The modal lives INSIDE the delivery-row loop because `picking` is only
        in scope there (the order-page modal template has no picking context).
        Each picking gets a unique modal/form/button id so the guard JS can
        lock the right form. Same parallel-button pattern as the SO Accept &
        Sign (bug 2): stock portal code is untouched.
    -->
    <template id="sale_order_portal_viva_delivery_message"
              name="VivaFarm Delivery Sign Success Message"
              inherit_id="sale.sale_order_portal_template">
        <xpath expr="//div[@t-if=&quot;message == 'sign_ok'&quot;]" position="before">
            <div t-if="message == 'delivery_sign_ok'" class="alert alert-success alert-dismissible d-print-none" role="status">
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                <strong>Thank You!</strong><br/>
                Your delivery has been received and confirmed. The signed delivery note is available below.
            </div>
        </xpath>
    </template>

    <template id="sale_order_portal_viva_delivery_buttons"
              name="VivaFarm Sale Order Portal Delivery Buttons"
              inherit_id="sale_stock.sale_order_portal_content_inherit_sale_stock">
        <!-- Yellow "In Transit" badge (user design 2026-08-18). The stock
             badge logic is an if/elif chain inside #delivery_details (Shipped
             for done / Preparation for prep states / Cancelled). in_transit
             matches NO stock branch, so no badge renders at all — inject
             ours INSIDE the div, after the name link. No duplicate: the
             stock branches don't match in_transit. -->
        <xpath expr="//div[@name='delivery_details']" position="inside">
            <span
                t-if="picking.state == 'in_transit'"
                class="small badge rounded-pill text-bg-warning orders_label_text_align">
                <i class="fa fa-fw fa-truck"/> In Transit
            </span>
        </xpath>
        <!-- Point the delivery NAME link at the Viva delivery note (same as
             the View delivery note button) instead of the default stock PDF
             (user instruction 2026-08-20). -->
        <xpath expr="//a[@t-att-href='delivery_report_url']" position="attributes">
            <attribute name="t-att-href">'/my/picking/%s/viva_pdf?%s' % (picking.id, keep_query())</attribute>
        </xpath>
        <!-- Buttons + per-picking signature modal inside the delivery row. -->
        <xpath expr="//div[@name='delivery_details']" position="after">
            <div class="d-flex gap-2 flex-wrap mt-1" name="viva_delivery_actions">
                <a
                    class="btn btn-sm btn-light o_print_btn"
                    t-att-href="'/my/picking/%s/viva_pdf?%s' % (picking.id, keep_query())"
                    target="_blank"
                >
                    <i class="fa fa-print me-1"/>View delivery note
                </a>
                <a
                    t-if="picking.state == 'in_transit'"
                    role="button"
                    class="btn btn-sm btn-primary"
                    t-att-data-bs-target="'#modalaccept_viva_delivery_%s' % picking.id"
                    data-bs-toggle="modal"
                    href="#"
                    t-att-id="'accept_viva_delivery_button_%s' % picking.id"
                >
                    <i class="fa fa-check me-1"/>Accept &amp; Sign Delivery
                </a>
            </div>

            <div role="dialog" class="modal fade"
                 t-att-id="'modalaccept_viva_delivery_%s' % picking.id"
                 name="sale_order_modal_sign_viva_delivery">
                <div
                    t-if="picking.state == 'in_transit'"
                    class="modal-dialog"
                >
                    <form
                        t-att-id="'accept_viva_delivery_%s' % picking.id"
                        method="POST"
                        t-att-data-order-id="picking.id"
                        t-att-data-token="sale_order.access_token"
                        class="js_accept_json modal-content js_website_submit_form"
                    >
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <header class="modal-header">
                            <h4 class="modal-title">Accept &amp; Sign Delivery</h4>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"/>
                        </header>
                        <main class="modal-body" id="sign-dialog-viva-delivery">
                            <span>
                                By signing, you acknowledge receipt of
                                <b t-field="sale_order.partner_id.commercial_partner_id"/>
                                for delivery
                                <b t-esc="picking.name"/>.
                            </span>
                            <t t-set="call_url" t-value="'/my/picking/%s/accept_viva?access_token=%s' % (picking.id, sale_order.access_token)"/>
                            <t
                                t-set="default_name"
                                t-value="sale_order.partner_id.name or sale_order.partner_id.commercial_partner_id.name"
                            />
                            <t t-set="signature_form_props" t-value="{
                                'callUrl': call_url,
                                'defaultName': default_name,
                                'mode': mode,
                                'sendLabel': 'Accept &amp; Sign',
                                'signatureRatio': signature_ratio,
                                'signatureType': signature_type,
                                'fontColor': font_color
                            }"/>
                            <owl-component name="vivafarm_report.accept_viva_signature_form"
                                           t-att-props="json.dumps(signature_form_props)"/>
                        </main>
                    </form>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
