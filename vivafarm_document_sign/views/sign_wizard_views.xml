<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Action for the wizard — MUST be defined before the button that references it -->
    <record id="action_viva_sign_wizard" model="ir.actions.act_window">
        <field name="name">Sign &amp; Lock Tax Invoice</field>
        <field name="res_model">viva.sign.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
    </record>

    <!-- Sign button on the posted invoice form (account.move) -->
    <record id="view_account_move_form_sign_button" model="ir.ui.view">
        <field name="name">account.move.form.sign.button</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="%(vivafarm_document_sign.action_viva_sign_wizard)d"
                        type="action" string="Sign &amp; Lock"
                        class="btn-primary"
                        confirm="Sign and lock this tax invoice? The PDF will be hashed and signed with the configured certificate, and the invoice will become immutable."
                        invisible="state != 'posted'"/>
            </xpath>
        </field>
    </record>

    <!-- Sign wizard form -->
    <record id="viva_sign_wizard_form" model="ir.ui.view">
        <field name="name">viva.sign.wizard.form</field>
        <field name="model">viva.sign.wizard</field>
        <field name="arch" type="xml">
            <form string="Sign &amp; Lock Tax Invoice">
                <group>
                    <group>
                        <field name="move_id"/>
                        <field name="document_number"/>
                        <field name="partner_id"/>
                        <field name="amount_total"/>
                    </group>
                    <group string="Evidence (computed before signing)">
                        <field name="pdf_sha256"/>
                        <field name="certificate_subject"/>
                        <field name="certificate_type"/>
                    </group>
                </group>
                <footer>
                    <button name="compute_evidence" type="object" string="Compute Hash"
                            class="btn-secondary"/>
                    <button name="action_sign" type="object" string="Sign &amp; Lock"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-link" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
