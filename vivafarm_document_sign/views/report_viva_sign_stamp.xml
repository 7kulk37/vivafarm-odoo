<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Signed stamp + verification QR on the Viva tax invoice.
         Shown ONLY when the invoice has a signed document.
         Uses o's own method for the QR data-URI + verification URL so no
         template Python is needed. -->
    <template id="viva_invoice_document_sign_stamp"
              name="Viva Invoice Signed Stamp"
              inherit_id="vivafarm_report.viva_invoice_document">
        <!-- Insert BEFORE the signature section. wkhtmltopdf clips content
             placed AFTER the Authorized Signatory box at the very bottom of
             the page — the stamp must live above it (verified: variant test). -->
        <xpath expr="//div[div[contains(., 'Signatures below constitute') or contains(., 'การลงลายมือชื่อในช่องต่อไปนี้')]]" position="before">
            <div t-if="o.signed_document_id" class="row mt-2" style="page-break-inside: avoid;">
                <div class="col-12" style="border: 1px solid #2e7d32; border-radius: 6px;">
                    <!-- Background on an INNER wrapper div (not the bordered
                         div): QtWebKit drops background-color when border +
                         border-radius are on the SAME element, and the bare
                         table inherits the global table { border-collapse:
                         collapse } rule which paints cells #e9ecef (grey) +
                         emits degenerate #212529 rects. The wrapper's
                         background covers the padding ring so the whole block
                         is light primary inside the darker primary border. -->
                    <div style="background: #f1f8f1; border-radius: 6px; padding: 6px 10px;">
                        <table style="width: 100%; background: #f1f8f1; border-collapse: separate; border-spacing: 0; border: none;">
                            <tr>
                                <td style="width: 42px; vertical-align: top; background: #f1f8f1;">
                                    <img t-att-src="o.signed_document_id[0]._qr_data_uri()"
                                         style="width: 42px; height: 42px;"
                                         alt="Verify QR"/>
                                </td>
                                <td style="vertical-align: top; font-size: 9px; line-height: 1.35; padding-left: 8px; background: #f1f8f1;">
                                    <div style="font-weight: bold; color: #2e7d32;">
                                        <t t-if="lang == 'th_TH'">เอกสารลงลายมือชื่อดิจิทัล (SIGNED)</t>
                                        <t t-else="">Digitally Signed Document</t>
                                    </div>
                                    <div><t t-if="lang == 'th_TH'">เลขที่เอกสาร</t><t t-else="">Document</t>:
                                        <t t-esc="o.signed_document_id[0].document_number"/>
                                        <t t-if="o.signed_document_id[0].revision > 1"> Rev.<t t-esc="o.signed_document_id[0].revision"/></t>
                                    </div>
                                    <div><t t-if="lang == 'th_TH'">รหัสตรวจสอบ</t><t t-else="">Verification Code</t>:
                                        <t t-esc="o.signed_document_id[0].verification_code"/>
                                    </div>
                                    <div><t t-if="lang == 'th_TH'">ตรวจสอบ</t><t t-else="">Verify</t>:
                                        <t t-esc="o.signed_document_id[0]._get_verification_url()"/>
                                    </div>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
        </xpath>
    </template>

    <!-- Hash block on the Viva delivery note — BELOW the signature block.
         Shown ONLY when the picking has a signed document (customer
         acknowledged receipt via portal). The block proves the exact
         bytes the customer accepted as received (ป.พ.พ. มาตรา 456).
         Also shows the LINKED SO + its verification code (user request
         2026-08-18: delivery note chained to the SO) so an auditor can
         verify both documents from one page. -->
    <template id="viva_delivery_note_document_sign_stamp"
              name="Viva Delivery Note Signed Stamp"
              inherit_id="vivafarm_report.viva_delivery_note_document">
        <xpath expr="//div[@id='delivery_note_signature_block']" position="after">
            <div t-if="o.signed_document_id" class="row mt-2" style="page-break-inside: avoid;">
                <div class="col-12" style="border: 1px solid #2e7d32; border-radius: 6px;">
                    <!-- Background on an INNER wrapper div (not the bordered
                         div): QtWebKit drops background-color when border +
                         border-radius are on the SAME element, and the bare
                         table inherits the global table { border-collapse:
                         collapse } rule which paints cells #e9ecef (grey) +
                         emits degenerate #212529 rects. -->
                    <div style="background: #f1f8f1; border-radius: 6px; padding: 6px 10px;">
                        <table style="width: 100%; background: #f1f8f1; border-collapse: separate; border-spacing: 0; border: none;">
                            <tr>
                                <td style="width: 42px; vertical-align: top; background: #f1f8f1;">
                                    <img t-att-src="o.signed_document_id[0]._qr_data_uri()"
                                         style="width: 42px; height: 42px;"
                                         alt="Verify QR"/>
                                </td>
                                <td style="vertical-align: top; font-size: 9px; line-height: 1.35; padding-left: 8px; background: #f1f8f1;">
                                    <div style="font-weight: bold; color: #2e7d32;">
                                        <t t-if="lang == 'th_TH'">เอกสารลงลายมือชื่อดิจิทัล (SIGNED)</t>
                                        <t t-else="">Digitally Signed Document</t>
                                    </div>
                                    <div><t t-if="lang == 'th_TH'">เลขที่เอกสาร</t><t t-else="">Document</t>:
                                        <t t-esc="o.signed_document_id[0].document_number"/>
                                        <t t-if="o.signed_document_id[0].revision > 1"> Rev.<t t-esc="o.signed_document_id[0].revision"/></t>
                                    </div>
                                    <div><t t-if="lang == 'th_TH'">รหัสตรวจสอบ</t><t t-else="">Verification Code</t>:
                                        <t t-esc="o.signed_document_id[0].verification_code"/>
                                    </div>
                                    <div t-if="o.sale_id">
                                        <t t-if="lang == 'th_TH'">ใบสั่งซื้อที่เกี่ยวข้อง</t><t t-else="">Linked SO</t>:
                                        <t t-esc="o.sale_id.name"/>
                                        <t t-if="o.sale_id.signed_document_id[:1]"> · Code: <t t-esc="o.sale_id.signed_document_id[:1].verification_code"/></t>
                                    </div>
                                    <div><t t-if="lang == 'th_TH'">ตรวจสอบ</t><t t-else="">Verify</t>:
                                        <t t-esc="o.signed_document_id[0]._get_verification_url()"/>
                                    </div>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
        </xpath>
    </template>

    <!-- Hash block on the Viva Quotation/SO — BELOW the signature block.
         Shown ONLY when the order is in 'sale' state (accepted) AND has a
         signed document (customer accepted via portal). The block proves
         the exact bytes the customer accepted (CCC §456 written evidence).
         Placement: after #qso_signature_block — the SO has ~76pt of real
         slack below the signature boxes before the footer (measured on
         S00028), unlike the invoice where the stamp must sit ABOVE the
         signatures (wkhtmltopdf clips content at the very bottom). -->
    <template id="viva_quotation_so_document_sign_stamp"
              name="Viva Quotation/SO Signed Stamp"
              inherit_id="vivafarm_report.viva_quotation_so_document">
        <xpath expr="//div[@id='qso_signature_block']" position="after">
            <div t-if="o.state == 'sale' and o.signed_document_id" class="row mt-2" style="page-break-inside: avoid;">
                <div class="col-12" style="border: 1px solid #2e7d32; border-radius: 6px;">
                    <!-- Background on an INNER wrapper div (not the bordered
                         div): QtWebKit drops background-color when border +
                         border-radius are on the SAME element, and the bare
                         table inherits the global table { border-collapse:
                         collapse } rule which paints cells #e9ecef (grey) +
                         emits degenerate #212529 rects. The wrapper's
                         background covers the padding ring so the whole block
                         is light primary inside the darker primary border. -->
                    <div style="background: #f1f8f1; border-radius: 6px; padding: 6px 10px;">
                        <table style="width: 100%; background: #f1f8f1; border-collapse: separate; border-spacing: 0; border: none;">
                            <tr>
                                <td style="width: 42px; vertical-align: top; background: #f1f8f1;">
                                    <img t-att-src="o.signed_document_id[0]._qr_data_uri()"
                                         style="width: 42px; height: 42px;"
                                         alt="Verify QR"/>
                                </td>
                                <td style="vertical-align: top; font-size: 9px; line-height: 1.35; padding-left: 8px; background: #f1f8f1;">
                                    <div style="font-weight: bold; color: #2e7d32;">
                                        <t t-if="lang == 'th_TH'">เอกสารลงลายมือชื่อดิจิทัล (SIGNED)</t>
                                        <t t-else="">Digitally Signed Document</t>
                                    </div>
                                    <div><t t-if="lang == 'th_TH'">เลขที่เอกสาร</t><t t-else="">Document</t>:
                                        <t t-esc="o.signed_document_id[0].document_number"/>
                                        <t t-if="o.signed_document_id[0].revision > 1"> Rev.<t t-esc="o.signed_document_id[0].revision"/></t>
                                    </div>
                                    <div><t t-if="lang == 'th_TH'">รหัสตรวจสอบ</t><t t-else="">Verification Code</t>:
                                        <t t-esc="o.signed_document_id[0].verification_code"/>
                                    </div>
                                    <div><t t-if="lang == 'th_TH'">ตรวจสอบ</t><t t-else="">Verify</t>:
                                        <t t-esc="o.signed_document_id[0]._get_verification_url()"/>
                                    </div>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
