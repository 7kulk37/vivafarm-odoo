<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="viva_delivery_ack_tree" model="ir.ui.view">
        <field name="name">viva.delivery.ack.tree</field>
        <field name="model">viva.delivery.ack</field>
        <field name="arch" type="xml">
            <list string="Delivery Acknowledgments">
                <field name="document_number"/>
                <field name="partner_id"/>
                <field name="state"/>
                <field name="customer_name"/>
                <field name="confirmed_at"/>
            </list>
        </field>
    </record>

    <record id="viva_delivery_ack_form" model="ir.ui.view">
        <field name="name">viva.delivery.ack.form</field>
        <field name="model">viva.delivery.ack</field>
        <field name="arch" type="xml">
            <form string="Delivery Acknowledgment">
                <sheet>
                    <group>
                        <group>
                            <field name="document_number"/>
                            <field name="picking_id"/>
                            <field name="partner_id"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="customer_name"/>
                            <field name="confirmed_at"/>
                            <field name="ip_address"/>
                            <field name="user_agent"/>
                        </group>
                    </group>
                    <field name="signature_b64" widget="image" class="oe_avatar"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="viva_delivery_ack_action" model="ir.actions.act_window">
        <field name="name">Delivery Acknowledgments</field>
        <field name="res_model">viva.delivery.ack</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="viva_delivery_audit_tree" model="ir.ui.view">
        <field name="name">viva.delivery.audit.tree</field>
        <field name="model">viva.delivery.audit</field>
        <field name="arch" type="xml">
            <list string="Delivery Audit Events">
                <field name="ack_id"/>
                <field name="event"/>
                <field name="detail"/>
                <field name="user_id"/>
                <field name="timestamp"/>
            </list>
        </field>
    </record>

    <record id="viva_delivery_audit_action" model="ir.actions.act_window">
        <field name="name">Delivery Audit</field>
        <field name="res_model">viva.delivery.audit</field>
        <field name="view_mode">tree</field>
    </record>
</odoo>
