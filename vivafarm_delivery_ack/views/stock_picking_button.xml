<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Button on the delivery form: send the delivery-confirmation email -->
    <record id="view_picking_form_delivery_ack" model="ir.ui.view">
        <field name="name">stock.picking.form.delivery.ack</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='button_validate'][1]" position="before">
                <button name="action_send_delivery_confirmation"
                        string="Send Delivery Confirmation"
                        type="object"
                        class="btn-secondary"
                        invisible="state in ('draft', 'done', 'cancel') or not partner_id"/>
            </xpath>
        </field>
    </record>
</odoo>
