<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Public acknowledgment page — mirrors the sale portal "Accept & Sign" UX -->
    <template id="ack_page" name="Delivery Acknowledgment">
        <t t-call="portal.portal_layout">
            <t t-set="title">Delivery Confirmation</t>
            <div class="container mt-4 mb-4">
                <div class="row justify-content-center">
                    <div class="col-md-8 col-lg-6">
                        <div class="card">
                            <div class="card-body">
                                <h4 class="card-title">
                                    <t t-if="ack.partner_id.lang == 'th_TH'">ยืนยันการรับสินค้า</t>
                                    <t t-else="">Confirm Delivery Receipt</t>
                                </h4>
                                <p class="text-muted">
                                    <t t-if="ack.partner_id.lang == 'th_TH'">ใบส่งสินค้า: </t>
                                    <t t-else="">Delivery Note: </t>
                                    <b t-esc="ack.document_number"/>
                                </p>

                                <t t-if="error">
                                    <div class="alert alert-danger" role="alert">
                                        <t t-esc="error"/>
                                    </div>
                                </t>

                                <t t-if="ack.state == 'pending'">
                                    <form method="POST" t-att-action="'/ack/%s' % ack.ack_token"
                                          class="js_accept_json">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <div class="mb-3">
                                            <label class="form-label">
                                                <t t-if="ack.partner_id.lang == 'th_TH'">ชื่อผู้รับสินค้า</t>
                                                <t t-else="">Your name</t>
                                            </label>
                                            <input type="text" class="form-control" name="name"
                                                   t-att-value="ack.partner_id.name or ''" required="required"/>
                                        </div>
                                        <t t-call="portal.signature_form">
                                            <t t-set="call_url" t-value="'/ack/%s' % ack.ack_token"/>
                                            <t t-set="default_name" t-value="ack.partner_id.name or ''"/>
                                        </t>
                                        <button type="submit" class="btn btn-primary btn-lg w-100">
                                            <i class="fa fa-check"/>
                                            <t t-if="ack.partner_id.lang == 'th_TH'">ยืนยันการรับสินค้า</t>
                                            <t t-else="">I confirm receipt &amp; sign delivery note</t>
                                        </button>
                                    </form>
                                </t>
                                <t t-else="">
                                    <div class="alert alert-success" role="alert">
                                        <t t-if="ack.partner_id.lang == 'th_TH'">ยืนยันแล้ว</t>
                                        <t t-else="">Already confirmed</t>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Confirmation success page -->
    <template id="ack_confirmed" name="Delivery Acknowledgment Confirmed">
        <t t-call="portal.portal_layout">
            <t t-set="title">Delivery Confirmed</t>
            <div class="container mt-4 mb-4">
                <div class="row justify-content-center">
                    <div class="col-md-8 col-lg-6">
                        <div class="card">
                            <div class="card-body text-center">
                                <i class="fa fa-check-circle text-success" style="font-size: 3rem;"/>
                                <h4 class="mt-3">
                                    <t t-if="ack.partner_id.lang == 'th_TH'">ขอบคุณที่ยืนยันการรับสินค้า</t>
                                    <t t-else="">Thank you for confirming receipt</t>
                                </h4>
                                <p class="text-muted">
                                    <t t-if="ack.partner_id.lang == 'th_TH'">ใบส่งสินค้า: </t>
                                    <t t-else="">Delivery Note: </t>
                                    <b t-esc="ack.document_number"/>
                                </p>
                                <p>
                                    <t t-if="ack.partner_id.lang == 'th_TH'">ผู้รับ: </t>
                                    <t t-else="">Received by: </t>
                                    <b t-esc="ack.customer_name"/>
                                    <br/>
                                    <t t-if="ack.partner_id.lang == 'th_TH'">เวลา: </t>
                                    <t t-else="">At: </t>
                                    <span t-esc="ack.confirmed_at"/>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
