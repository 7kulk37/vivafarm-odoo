<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Recall Drill list view -->
        <record id="view_farm_recall_drill_tree" model="ir.ui.view">
            <field name="name">farm.recall.drill.tree</field>
            <field name="model">farm.recall.drill</field>
            <field name="arch" type="xml">
                <list string="Recall Drills">
                    <field name="packed_lot_id"/>
                    <field name="drill_date"/>
                    <field name="order_count" readonly="1"/>
                    <field name="trace_time_seconds" readonly="1"/>
                    <field name="state" widget="badge"/>
                </list>
            </field>
        </record>

        <!-- Recall Drill form view -->
        <record id="view_farm_recall_drill_form" model="ir.ui.view">
            <field name="name">farm.recall.drill.form</field>
            <field name="model">farm.recall.drill</field>
            <field name="arch" type="xml">
                <form string="Recall Drill">
                    <header>
                        <button name="action_complete" type="object" string="Complete" class="btn-primary"
                                invisible="state != 'draft'"/>
                        <button name="action_cancel" type="object" string="Cancel"
                                invisible="state != 'done'"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="packed_lot_id"/>
                                <field name="drill_date"/>
                                <field name="state" widget="badge"/>
                            </group>
                            <group>
                                <field name="order_count" readonly="1"/>
                                <field name="trace_time_seconds" readonly="1"/>
                            </group>
                        </group>
                        <group string="Customers">
                            <field name="customer_list" readonly="1" nolabel="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Menu: Hydroponic → Recall Drills -->
        <record id="action_farm_recall_drill" model="ir.actions.act_window">
            <field name="name">Recall Drills</field>
            <field name="res_model">farm.recall.drill</field>
            <field name="view_mode">list,form</field>
        </record>
        <menuitem id="menu_farm_recall_drill"
                  name="Recall Drills"
                  parent="menu_farm_ops_group"
                  action="action_farm_recall_drill"
                  sequence="90"/>

    </data>
</odoo>
