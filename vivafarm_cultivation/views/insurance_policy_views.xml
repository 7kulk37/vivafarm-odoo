<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Insurance Policy list view -->
        <record id="view_farm_insurance_policy_tree" model="ir.ui.view">
            <field name="name">farm.insurance.policy.tree</field>
            <field name="model">farm.insurance.policy</field>
            <field name="arch" type="xml">
                <list string="Insurance Policies" multi_edit="1" editable="bottom">
                    <field name="policy_number"/>
                    <field name="insurer"/>
                    <field name="coverage_type"/>
                    <field name="coverage_start"/>
                    <field name="coverage_end"/>
                    <field name="premium" widget="monetary"/>
                    <field name="is_active" widget="boolean_fa"/>
                    <field name="days_to_expiry"/>
                </list>
            </field>
        </record>

        <!-- Insurance Policy form view -->
        <record id="view_farm_insurance_policy_form" model="ir.ui.view">
            <field name="name">farm.insurance.policy.form</field>
            <field name="model">farm.insurance.policy</field>
            <field name="arch" type="xml">
                <form string="Insurance Policy">
                    <sheet>
                        <group>
                            <group>
                                <field name="policy_number"/>
                                <field name="insurer"/>
                                <field name="coverage_type"/>
                                <field name="premises"/>
                            </group>
                            <group>
                                <field name="coverage_start"/>
                                <field name="coverage_end"/>
                                <field name="premium" widget="monetary"/>
                                <field name="is_active" readonly="1"/>
                                <field name="days_to_expiry" readonly="1"/>
                            </group>
                        </group>
                        <field name="notes" nolabel="1" placeholder="Notes about this policy..."/>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Menu: Hydroponic → Insurance Policies -->
        <record id="action_farm_insurance_policy" model="ir.actions.act_window">
            <field name="name">Insurance Policies</field>
            <field name="res_model">farm.insurance.policy</field>
            <field name="view_mode">list,form</field>
        </record>
        <menuitem id="menu_farm_insurance_policy"
                  name="Insurance Policies"
                  parent="menu_vivafarm_cultivation"
                  action="action_farm_insurance_policy"
                  sequence="44"/>

    </data>
</odoo>
