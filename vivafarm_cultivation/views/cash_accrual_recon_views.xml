<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Cash vs Accrual Reconciliation list view -->
        <record id="view_farm_cash_accrual_recon_tree" model="ir.ui.view">
            <field name="name">farm.cash.accrual.recon.tree</field>
            <field name="model">farm.cash.accrual.recon</field>
            <field name="arch" type="xml">
                <list string="Cash vs Accrual Reconciliation" create="false" delete="false">
                    <field name="period"/>
                    <field name="cash_received" widget="monetary"/>
                    <field name="accrual_revenue" widget="monetary"/>
                    <field name="difference" widget="monetary"/>
                </list>
            </field>
        </record>

        <!-- Cash vs Accrual Reconciliation form view -->
        <record id="view_farm_cash_accrual_recon_form" model="ir.ui.view">
            <field name="name">farm.cash.accrual.recon.form</field>
            <field name="model">farm.cash.accrual.recon</field>
            <field name="arch" type="xml">
                <form string="Cash vs Accrual Reconciliation">
                    <sheet>
                        <group>
                            <group>
                                <field name="period"/>
                                <field name="cash_received" widget="monetary"/>
                            </group>
                            <group>
                                <field name="accrual_revenue" widget="monetary"/>
                                <field name="difference" widget="monetary"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Menu: Hydroponic → Cash vs Accrual -->
        <record id="action_farm_cash_accrual_recon" model="ir.actions.act_window">
            <field name="name">Cash vs Accrual</field>
            <field name="res_model">farm.cash.accrual.recon</field>
            <field name="view_mode">list,form</field>
        </record>
        <menuitem id="menu_farm_cash_accrual_recon"
                  name="Cash vs Accrual"
                  parent="menu_vivafarm_cultivation"
                  action="action_farm_cash_accrual_recon"
                  sequence="38"/>

    </data>
</odoo>
