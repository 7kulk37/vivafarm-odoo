<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Spoilage Disposal list view -->
        <record id="view_farm_spoilage_disposal_tree" model="ir.ui.view">
            <field name="name">farm.spoilage.disposal.tree</field>
            <field name="model">farm.spoilage.disposal</field>
            <field name="arch" type="xml">
                <list string="Spoilage Disposals" multi_edit="1" editable="bottom">
                    <field name="ref"/>
                    <field name="date"/>
                    <field name="cultivation_id"/>
                    <field name="lot_id"/>
                    <field name="quantity"/>
                    <field name="classification"/>
                    <field name="removal_type"/>
                    <field name="is_revenue" widget="boolean_fa" optional="show"/>
                    <field name="is_loss" widget="boolean_fa" optional="show"/>
                    <field name="reason"/>
                    <field name="destination"/>
                    <field name="worker_name"/>
                    <field name="state" widget="badge"/>
                </list>
            </field>
        </record>

        <!-- Spoilage Disposal form view -->
        <record id="view_farm_spoilage_disposal_form" model="ir.ui.view">
            <field name="name">farm.spoilage.disposal.form</field>
            <field name="model">farm.spoilage.disposal</field>
            <field name="arch" type="xml">
                <form string="Spoilage Disposal">
                    <header>
                        <button name="action_confirm" type="object" string="Confirm" class="btn-primary"
                                invisible="state != 'draft'"/>
                        <button name="action_cancel" type="object" string="Cancel"
                                invisible="state != 'confirmed'"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="ref" readonly="1"/>
                                <field name="date"/>
                                <field name="cultivation_id"/>
                                <field name="lot_id"/>
                                <field name="quantity"/>
                                <field name="classification"/>
                                <field name="removal_type"/>
                                <field name="is_revenue" readonly="1"/>
                                <field name="is_loss" readonly="1"/>
                            </group>
                            <group>
                                <field name="reason"/>
                                <field name="destination"/>
                                <field name="worker_name"/>
                                <field name="photo_attachment_id" widget="many2one_attachment"/>
                                <field name="state" widget="badge"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Menu: Hydroponic → Spoilage Disposals -->
        <record id="action_farm_spoilage_disposal" model="ir.actions.act_window">
            <field name="name">Spoilage Disposals</field>
            <field name="res_model">farm.spoilage.disposal</field>
            <field name="view_mode">list,form</field>
        </record>
        <menuitem id="menu_farm_spoilage_disposal"
                  name="Spoilage Disposals"
                  parent="menu_vivafarm_cultivation"
                  action="action_farm_spoilage_disposal"
                  sequence="32"/>

    </data>
</odoo>
