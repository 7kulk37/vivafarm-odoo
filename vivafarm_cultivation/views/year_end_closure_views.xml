<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Year-End Closure list view -->
        <record id="view_farm_year_end_closure_tree" model="ir.ui.view">
            <field name="name">farm.year.end.closure.tree</field>
            <field name="model">farm.year.end.closure</field>
            <field name="arch" type="xml">
                <list string="Year-End Closures" create="false">
                    <field name="fiscal_year"/>
                    <field name="lock_date"/>
                    <field name="open_periods"/>
                    <field name="unposted_invoices"/>
                    <field name="inventory_balance" widget="monetary"/>
                    <field name="state" widget="badge"/>
                </list>
            </field>
        </record>

        <!-- Year-End Closure form view -->
        <record id="view_farm_year_end_closure_form" model="ir.ui.view">
            <field name="name">farm.year.end.closure.form</field>
            <field name="model">farm.year.end.closure</field>
            <field name="arch" type="xml">
                <form string="Year-End Closure">
                    <header>
                        <button name="action_apply_lock" type="object" string="Apply Lock" class="btn-primary"
                                invisible="state != 'draft'"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="fiscal_year"/>
                                <field name="lock_date"/>
                                <field name="state" widget="badge"/>
                            </group>
                            <group>
                                <field name="open_periods" readonly="1"/>
                                <field name="unposted_invoices" readonly="1"/>
                                <field name="inventory_balance" widget="monetary" readonly="1"/>
                            </group>
                        </group>
                        <field name="notes" nolabel="1" placeholder="Notes about this closure..."/>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Menu: Hydroponic → Year-End Closure -->
        <record id="action_farm_year_end_closure" model="ir.actions.act_window">
            <field name="name">Year-End Closure</field>
            <field name="res_model">farm.year.end.closure</field>
            <field name="view_mode">list,form</field>
        </record>
        <menuitem id="menu_farm_year_end_closure"
                  name="Year-End Closure"
                  parent="menu_vivafarm_cultivation"
                  action="action_farm_year_end_closure"
                  sequence="40"/>

    </data>
</odoo>
